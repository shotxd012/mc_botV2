<%- include('partials/header') %>
<%- include('partials/sidebar') %>

<script>
    const BOT_ID = "<%= botId %>";
    const BOT_SECTION = 'settings';
</script>

<main class="flex-1 min-w-0 p-4 sm:p-6 md:p-8 max-w-[1280px] w-full mx-auto min-h-screen pb-20 md:pb-8 flex flex-col gap-6">
    <%- include('partials/bot-topbar', { botConfig, botId, status, section: 'settings' }) %>

    <div class="max-w-4xl w-full mx-auto grid gap-5">
        <section class="bg-canvas-default border border-ghborder-default rounded-md p-5 shadow-sm">
            <div class="flex items-center gap-2 mb-5 border-b border-ghborder-muted pb-3">
                <span class="material-icons text-accent-fg text-base">edit</span>
                <h3 class="text-sm font-semibold text-fg-default">Identity</h3>
            </div>
            <form onsubmit="renameBot(event)" class="flex flex-col sm:flex-row gap-3">
                <input id="bot-name-input" type="text" value="<%= botConfig.name %>" required maxlength="80" class="flex-1 px-3 py-2.5 bg-canvas-default border border-ghborder-default rounded-md text-xs text-fg-default outline-none focus:border-accent-fg" placeholder="Bot display name">
                <button type="submit" class="inline-flex items-center justify-center gap-2 px-4 py-2.5 bg-accent-emphasis hover:bg-accent-fg text-white rounded-md text-xs font-semibold border border-accent-emphasis">
                    <span class="material-icons text-sm">save</span> Save Name
                </button>
            </form>
        </section>

        <section class="bg-canvas-default border border-ghborder-default rounded-md p-5 shadow-sm">
            <div class="flex items-center gap-2 mb-5 border-b border-ghborder-muted pb-3">
                <span class="material-icons text-accent-fg text-base">file_download</span>
                <h3 class="text-sm font-semibold text-fg-default">Data & Operations</h3>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <a href="/api/bot/<%= botId %>/history/export?format=txt" class="flex items-center gap-3 p-3 rounded-md border border-ghborder-default hover:border-accent-fg hover:bg-canvas-subtle transition-colors">
                    <span class="material-icons text-accent-fg">download</span>
                    <span><strong class="block text-xs text-fg-default">Download TXT</strong><small class="text-[10px] text-fg-muted">Export the console history</small></span>
                </a>
                    <a href="/api/bot/<%= botId %>/history/export?format=csv" class="flex items-center gap-3 p-3 rounded-md border border-ghborder-default hover:border-accent-fg hover:bg-canvas-subtle transition-colors">
                    <span class="material-icons text-accent-fg">table_chart</span>
                    <span><strong class="block text-xs text-fg-default">Download CSV</strong><small class="text-[10px] text-fg-muted">Export logs for analysis</small></span>
                </a>
                    <button onclick="restartFromSettings()" class="flex items-center gap-3 p-3 text-left rounded-md border border-ghborder-default hover:border-attention-fg hover:bg-canvas-subtle transition-colors">
                    <span class="material-icons text-attention-fg">restart_alt</span>
                    <span><strong class="block text-xs text-fg-default">Restart Bot</strong><small class="text-[10px] text-fg-muted">Reconnect using current config</small></span>
                </button>
                    <button onclick="clearFromSettings()" class="flex items-center gap-3 p-3 text-left rounded-md border border-ghborder-default hover:border-attention-fg hover:bg-canvas-subtle transition-colors">
                    <span class="material-icons text-attention-fg">delete_sweep</span>
                    <span><strong class="block text-xs text-fg-default">Clear Console History</strong><small class="text-[10px] text-fg-muted">Remove stored log messages</small></span>
                </button>
            </div>
        </section>

        <section class="border border-danger-muted bg-danger-subtle rounded-md p-5">
            <div class="flex items-center gap-2 mb-3">
                <span class="material-icons text-danger-fg">warning</span>
                <h3 class="text-sm font-semibold text-danger-fg">Danger Zone</h3>
            </div>
            <p class="text-xs text-fg-muted mb-4">Deleting this bot permanently removes its configuration and stored console history.</p>
            <button onclick="deleteBot()" class="inline-flex items-center gap-2 px-4 py-2.5 text-danger-fg hover:text-white hover:bg-danger-emphasis border border-danger-muted rounded-md text-xs font-semibold">
                <span class="material-icons text-sm">delete_forever</span> Delete Bot
            </button>
        </section>
    </div>
</main>

<style>
    .workspace-link { display:flex; min-width:108px; flex:1 1 0%; align-items:center; justify-content:center; gap:.375rem; white-space:nowrap; border-bottom:2px solid transparent; padding:.55rem .75rem; color:var(--fgColor-muted); font-size:.75rem; font-weight:600; }
    .workspace-link:hover { color:var(--fgColor-default); border-color:var(--borderColor-muted); }
    .workspace-link-active { color:var(--fgColor-default); border-color:var(--accent-fgColor); }
</style>

<script>
async function renameBot(event) {
    event.preventDefault();
    const name = document.getElementById('bot-name-input').value.trim();
    if (!name) return;
    const response = await fetch(`/api/bot/${BOT_ID}/settings`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name })
    });
    const result = await response.json();
    if (response.ok && result.success) {
        showToast('Bot name saved.', 'success');
        setTimeout(() => window.location.reload(), 500);
    } else {
        showToast(result.error || 'Failed to save bot name.', 'error');
    }
}

async function restartFromSettings() {
    const response = await fetch(`/api/bot/${BOT_ID}/restart`, { method: 'POST' });
    const result = await response.json();
    showToast(result.success ? 'Bot restart dispatched.' : (result.error || 'Failed to restart bot.'), result.success ? 'success' : 'error');
}

async function clearFromSettings() {
    if (!confirm('Clear all stored console history for this bot?')) return;
    const response = await fetch(`/api/bot/${BOT_ID}/history/clear`, { method: 'POST' });
    const result = await response.json();
    showToast(result.success ? 'Console history cleared.' : (result.error || 'Failed to clear history.'), result.success ? 'success' : 'error');
}
</script>

<%- include('partials/footer') %>
