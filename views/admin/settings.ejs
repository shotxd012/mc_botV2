<%- include('../partials/header') %>
<%- include('../partials/sidebar') %>

<main class="flex-1 p-4 sm:p-6 md:p-8 min-h-screen pb-20 md:pb-8 flex flex-col gap-6">
    <%- include('layout-nav') %>

    <!-- Settings Form -->
    <form onsubmit="handleSaveSettings(event)" class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <!-- Main Settings Columns -->
        <div class="lg:col-span-2 space-y-6">
            <!-- Automation & Reconnect Policy -->
            <div class="bg-white dark:bg-obsidian-900 border border-slate-200 dark:border-obsidian-700 p-6 shadow-sm">
                <div class="flex items-center gap-2 border-b border-slate-200 dark:border-obsidian-700/60 pb-3 mb-5">
                    <span class="material-icons text-primary">autorenew</span>
                    <h2 class="text-sm font-mono uppercase font-bold tracking-wider text-slate-900 dark:text-white">
                        Fleet Automation & Reconnection Policy
                    </h2>
                </div>

                <div class="space-y-4 font-mono text-xs">
                    <div class="flex items-start justify-between gap-4 p-3 bg-slate-50 dark:bg-obsidian-950 border border-slate-200 dark:border-obsidian-850">
                        <div>
                            <div class="font-bold text-slate-900 dark:text-white">Automatic Reconnect</div>
                            <div class="text-slate-500 text-[11px] mt-0.5">Automatically re-establish connection if a bot disconnects or gets kicked by the server.</div>
                        </div>
                        <input type="checkbox" name="autoReconnect" id="autoReconnect" <%= settings.autoReconnect ? 'checked' : '' %> class="accent-primary w-4 h-4 cursor-pointer mt-1">
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div>
                            <label class="block text-slate-500 font-semibold mb-1 uppercase text-[10px]">Reconnect Cooldown (Seconds)</label>
                            <input type="number" name="reconnectDelay" value="<%= settings.reconnectDelay || 10 %>" min="2" max="300" class="w-full bg-slate-50 dark:bg-obsidian-950 border border-slate-300 dark:border-obsidian-700 px-3 py-2 text-slate-900 dark:text-white outline-none focus:border-primary">
                            <span class="text-[10px] text-slate-400 mt-1 block">Cooldown wait time before retrying connection.</span>
                        </div>

                        <div>
                            <label class="block text-slate-500 font-semibold mb-1 uppercase text-[10px]">Default Minecraft Version</label>
                            <select name="defaultVersion" class="w-full bg-slate-50 dark:bg-obsidian-950 border border-slate-300 dark:border-obsidian-700 px-3 py-2 text-slate-900 dark:text-white outline-none focus:border-primary">
                                <option value="1.20.4" <%= (settings.defaultVersion === '1.20.4' || !settings.defaultVersion) ? 'selected' : '' %>>1.20.4 (Recommended)</option>
                                <option value="1.20.1" <%= settings.defaultVersion === '1.20.1' ? 'selected' : '' %>>1.20.1</option>
                                <option value="1.19.4" <%= settings.defaultVersion === '1.19.4' ? 'selected' : '' %>>1.19.4</option>
                                <option value="1.18.2" <%= settings.defaultVersion === '1.18.2' ? 'selected' : '' %>>1.18.2</option>
                                <option value="auto" <%= settings.defaultVersion === 'auto' ? 'selected' : '' %>>Auto-Detect</option>
                            </select>
                            <span class="text-[10px] text-slate-400 mt-1 block">Pre-filled version for newly deployed instances.</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Security & Passkey Rules -->
            <div class="bg-white dark:bg-obsidian-900 border border-slate-200 dark:border-obsidian-700 p-6 shadow-sm">
                <div class="flex items-center gap-2 border-b border-slate-200 dark:border-obsidian-700/60 pb-3 mb-5">
                    <span class="material-icons text-primary">security</span>
                    <h2 class="text-sm font-mono uppercase font-bold tracking-wider text-slate-900 dark:text-white">
                        Access Control & Passkey Enforcement
                    </h2>
                </div>

                <div class="space-y-4 font-mono text-xs">
                    <div class="flex items-start justify-between gap-4 p-3 bg-slate-50 dark:bg-obsidian-950 border border-slate-200 dark:border-obsidian-850">
                        <div>
                            <div class="font-bold text-slate-900 dark:text-white">Global Passkey Enforcement</div>
                            <div class="text-slate-500 text-[11px] mt-0.5">Require individual bot passkeys before opening the live console or executing privileged in-game commands.</div>
                        </div>
                        <input type="checkbox" name="passkeyEnforced" id="passkeyEnforced" <%= settings.passkeyEnforced ? 'checked' : '' %> class="accent-primary w-4 h-4 cursor-pointer mt-1">
                    </div>

                    <div class="flex items-start justify-between gap-4 p-3 bg-slate-50 dark:bg-obsidian-950 border border-slate-200 dark:border-obsidian-850">
                        <div>
                            <div class="font-bold text-slate-900 dark:text-white">Dark Mode by Default</div>
                            <div class="text-slate-500 text-[11px] mt-0.5">Enforce the Obsidian dark cyber theme for unauthenticated guests and newly registered users.</div>
                        </div>
                        <input type="checkbox" name="darkModeDefault" id="darkModeDefault" <%= settings.darkMode ? 'checked' : '' %> class="accent-primary w-4 h-4 cursor-pointer mt-1">
                    </div>
                </div>
            </div>

            <!-- Submit Button -->
            <div class="flex justify-end">
                <button type="submit" class="px-6 py-2.5 bg-primary hover:bg-primary-hover text-white font-mono text-xs uppercase font-bold transition-all border border-primary-hover active:translate-y-0.5 shadow-sm flex items-center gap-2">
                    <span class="material-icons text-sm">save</span>
                    <span>Save Global Settings</span>
                </button>
            </div>
        </div>

        <!-- Sidebar / System Diagnostics Card -->
        <div class="space-y-6">
            <div class="bg-white dark:bg-obsidian-900 border border-slate-200 dark:border-obsidian-700 p-6 shadow-sm font-mono text-xs space-y-4">
                <div class="flex items-center gap-2 border-b border-slate-200 dark:border-obsidian-700/60 pb-3">
                    <span class="material-icons text-primary text-sm">tune</span>
                    <h3 class="text-xs uppercase font-bold text-slate-900 dark:text-white">Platform Information</h3>
                </div>

                <div class="space-y-2.5">
                    <div class="flex justify-between items-center text-slate-500">
                        <span class="text-[10px] uppercase">Data Store:</span>
                        <span class="text-emerald-500 font-bold">MongoDB Atlas</span>
                    </div>
                    <div class="flex justify-between items-center text-slate-500">
                        <span class="text-[10px] uppercase">Session Store:</span>
                        <span class="text-slate-800 dark:text-slate-200 font-bold">connect-mongo</span>
                    </div>
                    <div class="flex justify-between items-center text-slate-500">
                        <span class="text-[10px] uppercase">Registered Bots:</span>
                        <span class="text-slate-800 dark:text-slate-200 font-bold"><%= botCount %> instances</span>
                    </div>
                    <div class="flex justify-between items-center text-slate-500">
                        <span class="text-[10px] uppercase">Server Clusters:</span>
                        <span class="text-slate-800 dark:text-slate-200 font-bold"><%= serverCount %> profiles</span>
                    </div>
                    <div class="flex justify-between items-center text-slate-500">
                        <span class="text-[10px] uppercase">Session Duration:</span>
                        <span class="text-slate-800 dark:text-slate-200">7 Days Max</span>
                    </div>
                </div>

                <div class="pt-3 border-t border-slate-200 dark:border-obsidian-800 text-[11px] text-slate-400">
                    Changes take effect immediately across all background bot loops and client sessions.
                </div>
            </div>
        </div>
    </form>
</main>

<script>
async function handleSaveSettings(e) {
    e.preventDefault();
    const formData = new FormData(e.target);
    const data = {
        autoReconnect: formData.get('autoReconnect') === 'on',
        reconnectDelay: formData.get('reconnectDelay'),
        defaultVersion: formData.get('defaultVersion'),
        passkeyEnforced: formData.get('passkeyEnforced') === 'on',
        darkModeDefault: formData.get('darkModeDefault') === 'on'
    };

    try {
        const res = await fetch('/api/admin/settings', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
        });

        const result = await res.json();
        if (res.ok && result.success) {
            if (typeof showToast === 'function') showToast('Global system settings saved.', 'success');
            setTimeout(() => window.location.reload(), 600);
        } else {
            if (typeof showToast === 'function') showToast(result.error || 'Failed to save settings', 'error');
        }
    } catch (err) {
        if (typeof showToast === 'function') showToast('Error saving settings', 'error');
    }
}
</script>

<%- include('../partials/footer') %>
