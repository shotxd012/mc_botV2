<%- include('../partials/header') %>
<%- include('../partials/sidebar') %>

<main class="flex-1 p-4 sm:p-6 md:p-8 max-w-[1280px] w-full mx-auto min-h-full flex flex-col gap-6">
    <header class="border-b border-ghborder-default pb-5">
        <div class="flex items-center gap-2">
            <h1 class="text-xl sm:text-2xl font-semibold text-fg-default tracking-tight">Admin Overview</h1>
            <span class="px-2 py-0.5 text-xs font-mono font-medium bg-danger-subtle text-danger-fg border border-danger-subtle rounded-pill">System Root</span>
        </div>
        <p class="text-fg-muted mt-1 text-xs sm:text-sm">Platform telemetry, system metrics, and active session oversight.</p>
    </header>

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div class="bg-canvas-default border border-ghborder-default p-4 rounded-md shadow-sm">
            <div class="text-xs font-semibold text-fg-muted uppercase">Total Bot Fleet</div>
            <div class="text-2xl font-bold font-mono text-fg-default mt-1"><%= systemStats.bots.total || 0 %></div>
        </div>
        <div class="bg-canvas-default border border-ghborder-default p-4 rounded-md shadow-sm">
            <div class="text-xs font-semibold text-fg-muted uppercase">Online Instances</div>
            <div class="text-2xl font-bold font-mono text-success-fg mt-1"><%= systemStats.bots.online || 0 %></div>
        </div>
        <div class="bg-canvas-default border border-ghborder-default p-4 rounded-md shadow-sm">
            <div class="text-xs font-semibold text-fg-muted uppercase">Registered Users</div>
            <div class="text-2xl font-bold font-mono text-accent-fg mt-1"><%= users.length || 0 %></div>
        </div>
    </div>
</main>

<%- include('../partials/footer') %>
