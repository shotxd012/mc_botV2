<%- include('../partials/header') %>
<%- include('../partials/sidebar') %>

<main class="flex-1 p-4 sm:p-6 md:p-8 min-h-screen pb-20 md:pb-8 flex flex-col gap-6">
    <%- include('layout-nav') %>

    <!-- Telemetry Overview Banner -->
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between bg-white dark:bg-obsidian-900 border border-slate-200 dark:border-obsidian-700 p-4 shadow-sm gap-4">
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-emerald-500/10 border border-emerald-500/30 text-emerald-500 flex items-center justify-center">
                <span class="material-icons text-xl animate-pulse">check_circle</span>
            </div>
            <div>
                <div class="text-xs font-mono uppercase font-bold text-slate-900 dark:text-white flex items-center gap-2">
                    <span>Host Status: Healthy & Operational</span>
                    <span class="inline-block w-2 h-2 bg-emerald-500 animate-ping"></span>
                </div>
                <div class="text-[11px] font-mono text-slate-500 mt-0.5">
                    <%= systemStats.meta.hostname %> · Node <%= systemStats.meta.node %> · PID <%= systemStats.meta.pid %>
                </div>
            </div>
        </div>
        <div class="flex items-center gap-3 text-xs font-mono">
            <a href="/admin/bots" class="px-3 py-1.5 bg-slate-100 dark:bg-obsidian-800 hover:bg-primary hover:text-white border border-slate-300 dark:border-obsidian-700 transition-colors flex items-center gap-1.5">
                <span class="material-icons text-sm">smart_toy</span>
                <span>Manage Fleet (<%= systemStats.bots.online %>/<%= systemStats.bots.total %>)</span>
            </a>
            <a href="/admin/servers" class="px-3 py-1.5 bg-slate-100 dark:bg-obsidian-800 hover:bg-primary hover:text-white border border-slate-300 dark:border-obsidian-700 transition-colors flex items-center gap-1.5">
                <span class="material-icons text-sm">dns</span>
                <span>Server Clusters</span>
            </a>
        </div>
    </div>

    <!-- System Telemetry Grid (Sharp Square HUD) -->
    <section class="grid grid-cols-2 md:grid-cols-3 xl:grid-cols-4 gap-3.5">
        <div class="bg-white dark:bg-obsidian-900 border border-slate-200 dark:border-obsidian-700 p-4 flex flex-col justify-between shadow-sm">
            <div class="text-[10px] font-mono uppercase tracking-widest text-slate-400 mb-1 flex items-center justify-between">
                <span>System Uptime</span>
                <span class="material-icons text-slate-400 text-xs">schedule</span>
            </div>
            <div class="text-base sm:text-lg font-mono font-bold text-slate-900 dark:text-white"><%= systemStats.uptime.system %></div>
            <div class="text-[11px] font-mono text-slate-500 mt-1">App: <%= systemStats.uptime.app %></div>
        </div>

        <div class="bg-white dark:bg-obsidian-900 border border-slate-200 dark:border-obsidian-700 p-4 flex flex-col justify-between shadow-sm">
            <div class="text-[10px] font-mono uppercase tracking-widest text-slate-400 mb-1 flex items-center justify-between">
                <span>CPU Architecture</span>
                <span class="material-icons text-slate-400 text-xs">memory</span>
            </div>
            <div class="text-base sm:text-lg font-mono font-bold text-slate-900 dark:text-white"><%= systemStats.cpu.count %> Cores</div>
            <div class="text-[11px] font-mono text-slate-500 mt-1">Load: <%= systemStats.cpu.loadAvg %></div>
        </div>

        <div class="bg-white dark:bg-obsidian-900 border border-slate-200 dark:border-obsidian-700 p-4 flex flex-col justify-between shadow-sm">
            <div class="text-[10px] font-mono uppercase tracking-widest text-slate-400 mb-1 flex items-center justify-between">
                <span>RAM Memory</span>
                <span class="material-icons text-slate-400 text-xs">storage</span>
            </div>
            <div class="text-base sm:text-lg font-mono font-bold text-slate-900 dark:text-white"><%= systemStats.memory.used %> / <%= systemStats.memory.total %></div>
            <div class="text-[11px] font-mono text-slate-500 mt-1">Process RSS: <%= systemStats.memory.process.rss %></div>
        </div>

        <div class="bg-white dark:bg-obsidian-900 border border-slate-200 dark:border-obsidian-700 p-4 flex flex-col justify-between shadow-sm">
            <div class="text-[10px] font-mono uppercase tracking-widest text-slate-400 mb-1 flex items-center justify-between">
                <span>Bots Online</span>
                <span class="material-icons text-emerald-400 text-xs">smart_toy</span>
            </div>
            <div class="text-base sm:text-lg font-mono font-bold text-emerald-500"><%= systemStats.bots.online %> Online</div>
            <div class="text-[11px] font-mono text-slate-500 mt-1">
                Offline: <%= systemStats.bots.offline %> · Total: <%= systemStats.bots.total %>
            </div>
        </div>

        <div class="bg-white dark:bg-obsidian-900 border border-slate-200 dark:border-obsidian-700 p-4 flex flex-col justify-between shadow-sm">
            <div class="text-[10px] font-mono uppercase tracking-widest text-slate-400 mb-1 flex items-center justify-between">
                <span>Server Profiles</span>
                <span class="material-icons text-slate-400 text-xs">dns</span>
            </div>
            <div class="text-base sm:text-lg font-mono font-bold text-slate-900 dark:text-white"><%= systemStats.servers.online %> Running</div>
            <div class="text-[11px] font-mono text-slate-500 mt-1">
                Total: <%= systemStats.servers.total %> · Assigned: <%= systemStats.servers.assigned %>
            </div>
        </div>

        <div class="bg-white dark:bg-obsidian-900 border border-slate-200 dark:border-obsidian-700 p-4 flex flex-col justify-between shadow-sm">
            <div class="text-[10px] font-mono uppercase tracking-widest text-slate-400 mb-1 flex items-center justify-between">
                <span>Runtime</span>
                <span class="material-icons text-slate-400 text-xs">terminal</span>
            </div>
            <div class="text-base sm:text-lg font-mono font-bold text-slate-900 dark:text-white"><%= systemStats.meta.node %></div>
            <div class="text-[11px] font-mono text-slate-500 mt-1 truncate"><%= systemStats.meta.platform %></div>
        </div>

        <div class="bg-white dark:bg-obsidian-900 border border-slate-200 dark:border-obsidian-700 p-4 flex flex-col justify-between shadow-sm">
            <div class="text-[10px] font-mono uppercase tracking-widest text-slate-400 mb-1 flex items-center justify-between">
                <span>Storage Disk</span>
                <span class="material-icons text-slate-400 text-xs">hard_drive</span>
            </div>
            <% if (systemStats.disk) { %>
                <div class="text-base sm:text-lg font-mono font-bold text-slate-900 dark:text-white"><%= systemStats.disk.used %> / <%= systemStats.disk.total %></div>
                <div class="text-[11px] font-mono text-slate-500 mt-1">Free: <%= systemStats.disk.free %> (<%= systemStats.disk.percent %> used)</div>
            <% } else { %>
                <div class="text-sm font-mono text-slate-400">Unavailable</div>
                <div class="text-[11px] font-mono text-slate-500 mt-1">Local FS</div>
            <% } %>
        </div>

        <div class="bg-white dark:bg-obsidian-900 border border-slate-200 dark:border-obsidian-700 p-4 flex flex-col justify-between shadow-sm">
            <div class="text-[10px] font-mono uppercase tracking-widest text-slate-400 mb-1 flex items-center justify-between">
                <span>Network I/O</span>
                <span class="material-icons text-slate-400 text-xs">wifi</span>
            </div>
            <% if (systemStats.network) { %>
                <div class="text-base sm:text-lg font-mono font-bold text-slate-900 dark:text-white">RX <%= systemStats.network.rx %></div>
                <div class="text-[11px] font-mono text-slate-500 mt-1">TX <%= systemStats.network.tx %></div>
            <% } else { %>
                <div class="text-sm font-mono text-slate-400">Unavailable</div>
                <div class="text-[11px] font-mono text-slate-500 mt-1">Network Socket</div>
            <% } %>
        </div>

        <div class="bg-white dark:bg-obsidian-900 border border-slate-200 dark:border-obsidian-700 p-4 flex flex-col justify-between shadow-sm">
            <div class="text-[10px] font-mono uppercase tracking-widest text-slate-400 mb-1 flex items-center justify-between">
                <span>Process CPU</span>
                <span class="material-icons text-slate-400 text-xs">data_usage</span>
            </div>
            <div class="text-base sm:text-lg font-mono font-bold text-slate-900 dark:text-white"><%= systemStats.cpu.processPercent %>%</div>
            <div class="text-[11px] font-mono text-slate-500 mt-1 truncate">Heap: <%= systemStats.memory.process.heapUsed %> / <%= systemStats.memory.process.heapTotal %></div>
        </div>

        <div class="bg-white dark:bg-obsidian-900 border border-slate-200 dark:border-obsidian-700 p-4 flex flex-col justify-between shadow-sm">
            <div class="text-[10px] font-mono uppercase tracking-widest text-slate-400 mb-1 flex items-center justify-between">
                <span>Host Machine</span>
                <span class="material-icons text-slate-400 text-xs">computer</span>
            </div>
            <div class="text-base sm:text-lg font-mono font-bold text-slate-900 dark:text-white truncate"><%= systemStats.meta.hostname %></div>
            <div class="text-[11px] font-mono text-slate-500 mt-1">Arch: <%= systemStats.meta.arch %> · PID <%= systemStats.meta.pid %></div>
        </div>

        <div class="bg-white dark:bg-obsidian-900 border border-slate-200 dark:border-obsidian-700 p-4 flex flex-col justify-between shadow-sm">
            <div class="text-[10px] font-mono uppercase tracking-widest text-slate-400 mb-1 flex items-center justify-between">
                <span>Database State</span>
                <span class="material-icons text-emerald-400 text-xs">database</span>
            </div>
            <div class="text-base sm:text-lg font-mono font-bold text-emerald-500"><%= systemStats.db.readyLabel %></div>
            <div class="text-[11px] font-mono text-slate-500 mt-1">Ping: <%= systemStats.db.pingMs === null ? 'N/A' : systemStats.db.pingMs + ' ms' %></div>
        </div>

        <div class="bg-white dark:bg-obsidian-900 border border-slate-200 dark:border-obsidian-700 p-4 flex flex-col justify-between shadow-sm">
            <div class="text-[10px] font-mono uppercase tracking-widest text-slate-400 mb-1 flex items-center justify-between">
                <span>Thermal Temp</span>
                <span class="material-icons text-slate-400 text-xs">thermostat</span>
            </div>
            <div class="text-base sm:text-lg font-mono font-bold text-slate-900 dark:text-white"><%= systemStats.temperature %></div>
            <div class="text-[11px] font-mono text-slate-500 mt-1">Hardware Sensors</div>
        </div>
    </section>

    <!-- History & Quick Bot Telemetry -->
    <section class="grid grid-cols-1 xl:grid-cols-3 gap-6">
        <!-- Load History -->
        <div class="bg-white dark:bg-obsidian-900 border border-slate-200 dark:border-obsidian-700 p-5 xl:col-span-2 shadow-sm">
            <div class="flex items-center justify-between mb-4 border-b border-slate-200 dark:border-obsidian-700/60 pb-3">
                <h2 class="text-xs font-mono uppercase font-bold tracking-wider text-slate-900 dark:text-white flex items-center gap-2">
                    <span class="material-icons text-sm text-primary">show_chart</span>
                    <span>System Load Average History (1 / 5 / 15 min)</span>
                </h2>
                <span class="text-[10px] font-mono text-slate-500">Last <%= systemStats.loadHistory.length %> samples</span>
            </div>
            <div class="space-y-2 max-h-64 overflow-y-auto text-xs font-mono">
                <% if (systemStats.loadHistory && systemStats.loadHistory.length > 0) { %>
                    <% systemStats.loadHistory.forEach(function(entry) { %>
                        <div class="flex items-center justify-between bg-slate-50 dark:bg-obsidian-950 px-3.5 py-2 border border-slate-200 dark:border-obsidian-800">
                            <span class="text-slate-500"><%= new Date(entry.ts).toLocaleTimeString() %></span>
                            <span class="font-bold text-slate-700 dark:text-slate-300"><%= entry.load1 %> / <%= entry.load5 %> / <%= entry.load15 %></span>
                        </div>
                    <% }); %>
                <% } else { %>
                    <div class="p-6 text-center text-slate-400 font-mono text-xs">No load history records available yet.</div>
                <% } %>
            </div>
        </div>

        <!-- Bot Status Overview -->
        <div class="bg-white dark:bg-obsidian-900 border border-slate-200 dark:border-obsidian-700 p-5 shadow-sm">
            <div class="flex items-center justify-between mb-4 border-b border-slate-200 dark:border-obsidian-700/60 pb-3">
                <h2 class="text-xs font-mono uppercase font-bold tracking-wider text-slate-900 dark:text-white flex items-center gap-2">
                    <span class="material-icons text-sm text-primary">view_list</span>
                    <span>Bot Status Overview</span>
                </h2>
                <a href="/admin/bots" class="text-[10px] font-mono text-primary hover:underline uppercase">View All &rarr;</a>
            </div>
            <div class="space-y-2.5 max-h-64 overflow-y-auto text-xs">
                <% if (systemStats.botsDetail && systemStats.botsDetail.length > 0) { %>
                    <% systemStats.botsDetail.forEach(function(bot) { %>
                        <div class="flex items-center justify-between bg-slate-50 dark:bg-obsidian-950 px-3 py-2 border border-slate-200 dark:border-obsidian-800">
                            <div>
                                <div class="font-mono font-bold text-slate-900 dark:text-slate-200 flex items-center gap-1.5">
                                    <span><%= bot.name %></span>
                                    <span class="text-slate-500 text-[10px]">#<%= bot.id %></span>
                                </div>
                                <div class="text-[10px] font-mono text-slate-500">Uptime: <%= bot.uptime %></div>
                            </div>
                            <div class="text-right font-mono">
                                <span class="px-1.5 py-0.5 text-[10px] font-bold uppercase border <%= bot.online ? 'bg-emerald-500/10 text-emerald-400 border-emerald-500/30' : 'bg-slate-200 dark:bg-obsidian-800 text-slate-500 border-slate-300 dark:border-obsidian-700' %>">
                                    <%= bot.online ? 'Online' : 'Offline' %>
                                </span>
                                <div class="text-[10px] text-slate-500 mt-1"><%= bot.afk ? 'AFK' : 'Idle' %></div>
                            </div>
                        </div>
                    <% }); %>
                <% } else { %>
                    <div class="p-6 text-center text-slate-400 font-mono text-xs">No bots configured yet.</div>
                <% } %>
            </div>
        </div>
    </section>

    <!-- Recent Audit Stream Preview -->
    <section class="bg-white dark:bg-obsidian-900 border border-slate-200 dark:border-obsidian-700 p-5 shadow-sm">
        <div class="flex items-center justify-between mb-4 border-b border-slate-200 dark:border-obsidian-700/60 pb-3">
            <h2 class="text-xs font-mono uppercase font-bold tracking-wider text-slate-900 dark:text-white flex items-center gap-2">
                <span class="material-icons text-sm text-primary">receipt_long</span>
                <span>Recent Admin Activity</span>
            </h2>
            <a href="/admin/logs" class="text-[10px] font-mono text-primary hover:underline uppercase">All Logs &rarr;</a>
        </div>
        <div class="space-y-2 max-h-48 overflow-y-auto text-xs font-mono">
            <% if (logs && logs.length > 0) { %>
                <% logs.slice(0, 5).forEach(function(log) { %>
                    <div class="p-2.5 bg-slate-50 dark:bg-obsidian-950 border border-slate-200 dark:border-obsidian-800 flex items-center justify-between">
                        <div class="flex items-center gap-2">
                            <span class="text-slate-400">[<%= new Date(log.createdAt).toLocaleTimeString() %>]</span>
                            <span class="font-bold text-primary"><%= log.actor %></span>
                            <span class="uppercase text-slate-400 bg-slate-200 dark:bg-obsidian-800 px-1.5 py-0.2 text-[10px]"><%= log.action %></span>
                            <% if (log.target) { %>
                                <span class="text-slate-500 text-[11px]">target: <%= log.target %></span>
                            <% } %>
                        </div>
                    </div>
                <% }); %>
            <% } else { %>
                <div class="p-4 text-center text-slate-400 text-xs">No recent admin logs.</div>
            <% } %>
        </div>
    </section>
</main>

<%- include('../partials/footer') %>
