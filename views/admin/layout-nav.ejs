<!-- Admin Operations Hub Header & Sub-Navigation -->
<header class="border-b border-ghborder-default pb-5">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <div class="flex items-center gap-2.5">
                <h1 class="text-xl sm:text-2xl font-bold tracking-tight text-fg-default flex items-center gap-2">
                    <span class="material-icons text-accent-fg">admin_panel_settings</span>
                    <span>Admin Operations Hub</span>
                </h1>
                <span class="px-2 py-0.5 text-[10px] font-mono font-bold uppercase bg-danger-subtle text-danger-fg border border-danger-muted rounded-pill">
                    Root Access
                </span>
            </div>
            <p class="text-fg-muted mt-1 text-xs sm:text-sm">
                Unified control center for Minecraft bot fleet, server clusters, security, and telemetry.
            </p>
        </div>
    </div>

    <div class="flex items-center gap-1 mt-6 overflow-x-auto pb-1 no-scrollbar border-b border-ghborder-default pt-3">
        <a href="/admin/overview" class="flex items-center gap-2 px-3 py-2 text-xs font-semibold transition-colors border-b-2 <%= adminTab === 'overview' ? 'border-accent-fg text-fg-default' : 'border-transparent text-fg-muted hover:text-fg-default hover:border-ghborder-muted' %>">
            <span class="material-icons text-sm">speed</span>
            <span>Telemetry</span>
        </a>
        <a href="/admin/bots" class="flex items-center gap-2 px-3 py-2 text-xs font-semibold transition-colors border-b-2 <%= adminTab === 'bots' ? 'border-accent-fg text-fg-default' : 'border-transparent text-fg-muted hover:text-fg-default hover:border-ghborder-muted' %>">
            <span class="material-icons text-sm">smart_toy</span>
            <span>Bot Fleet</span>
            <% if (typeof bots !== 'undefined') { %>
                <span class="text-[10px] px-1.5 py-0.2 bg-canvas-subtle text-fg-muted rounded-pill"><%= bots.length %></span>
            <% } %>
        </a>
        <a href="/admin/servers" class="flex items-center gap-2 px-3 py-2 text-xs font-semibold transition-colors border-b-2 <%= adminTab === 'servers' ? 'border-accent-fg text-fg-default' : 'border-transparent text-fg-muted hover:text-fg-default hover:border-ghborder-muted' %>">
            <span class="material-icons text-sm">dns</span>
            <span>Server Profiles</span>
            <% if (typeof servers !== 'undefined') { %>
                <span class="text-[10px] px-1.5 py-0.2 bg-canvas-subtle text-fg-muted rounded-pill"><%= servers.length %></span>
            <% } %>
        </a>
        <a href="/admin/users" class="flex items-center gap-2 px-3 py-2 text-xs font-semibold transition-colors border-b-2 <%= adminTab === 'users' ? 'border-accent-fg text-fg-default' : 'border-transparent text-fg-muted hover:text-fg-default hover:border-ghborder-muted' %>">
            <span class="material-icons text-sm">group</span>
            <span>Users & Access</span>
            <% if (typeof users !== 'undefined') { %>
                <span class="text-[10px] px-1.5 py-0.2 bg-canvas-subtle text-fg-muted rounded-pill"><%= users.length %></span>
            <% } %>
        </a>
        <a href="/admin/logs" class="flex items-center gap-2 px-3 py-2 text-xs font-semibold transition-colors border-b-2 <%= adminTab === 'logs' ? 'border-accent-fg text-fg-default' : 'border-transparent text-fg-muted hover:text-fg-default hover:border-ghborder-muted' %>">
            <span class="material-icons text-sm">receipt_long</span>
            <span>Audit Logs</span>
        </a>
        <a href="/admin/settings" class="flex items-center gap-2 px-3 py-2 text-xs font-semibold transition-colors border-b-2 <%= adminTab === 'settings' ? 'border-accent-fg text-fg-default' : 'border-transparent text-fg-muted hover:text-fg-default hover:border-ghborder-muted' %>">
            <span class="material-icons text-sm">settings</span>
            <span>Settings</span>
        </a>
    </div>
</header>
