<%- include('../partials/header') %>
<%- include('../partials/sidebar') %>

<main class="flex-1 p-4 sm:p-6 md:p-8 min-h-screen pb-20 md:pb-8 flex flex-col gap-6">
    <%- include('layout-nav') %>

    <!-- Header & Action Bar -->
    <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-3 bg-white dark:bg-obsidian-900 border border-slate-200 dark:border-obsidian-700 p-4 shadow-sm">
        <div class="flex items-center gap-3 flex-1 max-w-md">
            <div class="relative w-full">
                <span class="material-icons absolute left-3 top-2.5 text-slate-400 text-sm">search</span>
                <input type="text" id="userSearchInput" placeholder="Search users by username or role..." oninput="filterUsers()" class="w-full pl-9 pr-3 py-2 text-xs font-mono bg-slate-50 dark:bg-obsidian-950 border border-slate-300 dark:border-obsidian-700 text-slate-900 dark:text-white outline-none focus:border-primary">
            </div>
        </div>

        <button onclick="openCreateUserModal()" class="px-4 py-2 bg-primary hover:bg-primary-hover text-white font-mono text-xs uppercase font-bold transition-all border border-primary-hover flex items-center gap-1.5 active:translate-y-0.5 shadow-sm">
            <span class="material-icons text-sm">person_add</span>
            <span>Create New User</span>
        </button>
    </div>

    <!-- Users Table View -->
    <div class="bg-white dark:bg-obsidian-900 border border-slate-200 dark:border-obsidian-700 shadow-sm overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left text-xs font-mono">
                <thead class="bg-slate-100 dark:bg-obsidian-950 text-slate-500 uppercase tracking-wider text-[10px] border-b border-slate-200 dark:border-obsidian-800">
                    <tr>
                        <th class="p-3.5">User Account</th>
                        <th class="p-3.5">Role Level</th>
                        <th class="p-3.5">Assigned Bots</th>
                        <th class="p-3.5">Account Created</th>
                        <th class="p-3.5 text-right">Administrative Actions</th>
                    </tr>
                </thead>
                <tbody id="usersTableBody" class="divide-y divide-slate-200 dark:divide-obsidian-800">
                    <% users.forEach(function(u) { 
                        const botCount = userBotCounts[u.username] || 0;
                        const isSelf = user && user.username === u.username;
                        const isRoot = u.username === 'root';
                    %>
                    <tr class="user-row hover:bg-slate-50 dark:hover:bg-obsidian-850/50 transition-colors"
                        data-username="<%= u.username.toLowerCase() %>"
                        data-role="<%= (u.role || 'user').toLowerCase() %>">
                        
                        <td class="p-3.5">
                            <div class="flex items-center gap-2.5">
                                <div class="w-7 h-7 bg-slate-200 dark:bg-obsidian-800 border border-slate-300 dark:border-obsidian-700 flex items-center justify-center font-bold text-slate-700 dark:text-slate-300">
                                    <%= u.username.charAt(0).toUpperCase() %>
                                </div>
                                <div>
                                    <div class="font-bold text-slate-900 dark:text-white flex items-center gap-1.5">
                                        <span><%= u.username %></span>
                                        <% if (isSelf) { %>
                                            <span class="text-[9px] px-1 bg-primary/10 text-primary border border-primary/20 uppercase font-bold">You</span>
                                        <% } %>
                                        <% if (isRoot) { %>
                                            <span class="text-[9px] px-1 bg-redstone-500/10 text-redstone-400 border border-redstone-500/20 uppercase font-bold">Master</span>
                                        <% } %>
                                    </div>
                                </div>
                            </div>
                        </td>

                        <td class="p-3.5">
                            <span class="px-2 py-0.5 text-[10px] font-bold uppercase border <%= u.role === 'admin' ? 'bg-redstone-500/10 text-redstone-400 border-redstone-500/30' : 'bg-primary/10 text-primary border-primary/20' %>">
                                <%= u.role || 'user' %>
                            </span>
                        </td>

                        <td class="p-3.5">
                            <span class="font-bold text-slate-800 dark:text-slate-200"><%= botCount %></span>
                            <span class="text-slate-500 text-[11px]">/ <%= totalBots %> fleet bots</span>
                        </td>

                        <td class="p-3.5 text-slate-500 text-[11px]">
                            <%= u.createdAt ? new Date(u.createdAt).toLocaleDateString() : 'N/A' %>
                        </td>

                        <td class="p-3.5 text-right">
                            <div class="flex items-center justify-end gap-1.5">
                                <% if (!isRoot) { %>
                                    <% if (u.role === 'user') { %>
                                        <button onclick="promoteUser('<%= u.username %>')" class="px-2.5 py-1 bg-emerald-600 hover:bg-emerald-500 text-white text-[11px] font-bold uppercase transition-colors" title="Promote to Admin">
                                            Promote
                                        </button>
                                    <% } else if (!isSelf) { %>
                                        <button onclick="demoteUser('<%= u.username %>')" class="px-2.5 py-1 bg-amber-600 hover:bg-amber-500 text-white text-[11px] font-bold uppercase transition-colors" title="Demote to User">
                                            Demote
                                        </button>
                                    <% } %>
                                <% } %>

                                <button onclick="openResetPasswordModal('<%= u.username %>')" class="px-2 py-1 bg-slate-100 dark:bg-obsidian-800 hover:bg-slate-200 dark:hover:bg-obsidian-700 text-slate-700 dark:text-slate-300 text-[11px] font-bold uppercase transition-colors border border-slate-300 dark:border-obsidian-700" title="Reset Password">
                                    <span class="material-icons text-xs">vpn_key</span>
                                </button>

                                <% if (!isSelf && !isRoot) { %>
                                    <button onclick="deleteUserAccount('<%= u.username %>')" class="px-2 py-1 text-redstone-500 hover:text-white hover:bg-redstone-600 text-[11px] font-bold uppercase transition-colors border border-redstone-500/30" title="Delete User">
                                        <span class="material-icons text-xs">delete</span>
                                    </button>
                                <% } %>
                            </div>
                        </td>
                    </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Empty State -->
    <div id="noUsersMessage" class="hidden p-12 text-center bg-white dark:bg-obsidian-900 border border-slate-200 dark:border-obsidian-700 font-mono text-xs text-slate-400">
        No users match your active search query.
    </div>
</main>

<!-- Create User Modal -->
<div id="createUserModal" class="fixed inset-0 bg-black/60 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
    <div class="bg-white dark:bg-obsidian-900 border border-slate-200 dark:border-obsidian-700 w-full max-w-md shadow-2xl p-6 relative animate-in fade-in zoom-in-95 duration-150">
        <div class="flex items-center justify-between border-b border-slate-200 dark:border-obsidian-700/60 pb-3 mb-4">
            <h2 class="text-base font-mono uppercase font-bold text-slate-900 dark:text-white flex items-center gap-2">
                <span class="material-icons text-primary">person_add</span>
                <span>Create User Account</span>
            </h2>
            <button onclick="closeCreateUserModal()" class="text-slate-400 hover:text-slate-200">
                <span class="material-icons text-lg">close</span>
            </button>
        </div>

        <form onsubmit="handleCreateUser(event)" class="space-y-4">
            <div>
                <label class="block text-xs font-mono uppercase text-slate-400 mb-1 font-semibold">Username</label>
                <input type="text" name="username" placeholder="Username" required class="w-full bg-slate-50 dark:bg-obsidian-950 border border-slate-300 dark:border-obsidian-700 px-3 py-2 text-xs text-slate-900 dark:text-white outline-none focus:border-primary">
            </div>
            <div>
                <label class="block text-xs font-mono uppercase text-slate-400 mb-1 font-semibold">Password (min 6 characters)</label>
                <input type="password" name="password" placeholder="Password" minlength="6" required class="w-full bg-slate-50 dark:bg-obsidian-950 border border-slate-300 dark:border-obsidian-700 px-3 py-2 text-xs text-slate-900 dark:text-white outline-none focus:border-primary">
            </div>
            <div>
                <label class="block text-xs font-mono uppercase text-slate-400 mb-1 font-semibold">Role Level</label>
                <select name="role" class="w-full bg-slate-50 dark:bg-obsidian-950 border border-slate-300 dark:border-obsidian-700 px-3 py-2 text-xs font-mono text-slate-900 dark:text-white outline-none focus:border-primary">
                    <option value="user">User (Assigned Bots Only)</option>
                    <option value="admin">Administrator (Full Hub Control)</option>
                </select>
            </div>

            <div class="flex justify-end gap-2 pt-3 border-t border-slate-200 dark:border-obsidian-800">
                <button type="button" onclick="closeCreateUserModal()" class="px-4 py-2 bg-slate-100 dark:bg-obsidian-800 text-slate-700 dark:text-slate-300 font-mono text-xs uppercase font-bold border border-slate-300 dark:border-obsidian-700">
                    Cancel
                </button>
                <button type="submit" class="px-5 py-2 bg-primary hover:bg-primary-hover text-white font-mono text-xs uppercase font-bold transition-all border border-primary-hover active:translate-y-0.5">
                    Create Account
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Reset Password Modal -->
<div id="resetPasswordModal" class="fixed inset-0 bg-black/60 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
    <div class="bg-white dark:bg-obsidian-900 border border-slate-200 dark:border-obsidian-700 w-full max-w-sm shadow-2xl p-6 relative animate-in fade-in zoom-in-95 duration-150">
        <div class="flex items-center justify-between border-b border-slate-200 dark:border-obsidian-700/60 pb-3 mb-4">
            <h2 class="text-base font-mono uppercase font-bold text-slate-900 dark:text-white flex items-center gap-2">
                <span class="material-icons text-primary">vpn_key</span>
                <span>Reset Password</span>
            </h2>
            <button onclick="closeResetPasswordModal()" class="text-slate-400 hover:text-slate-200">
                <span class="material-icons text-lg">close</span>
            </button>
        </div>

        <form onsubmit="handleResetPassword(event)" class="space-y-4">
            <input type="hidden" name="username" id="resetPasswordUsername">
            <div>
                <label class="block text-xs font-mono uppercase text-slate-400 mb-1">Target Account:</label>
                <div id="resetPasswordTargetDisplay" class="font-mono font-bold text-sm text-primary bg-slate-50 dark:bg-obsidian-950 p-2 border border-slate-300 dark:border-obsidian-700"></div>
            </div>
            <div>
                <label class="block text-xs font-mono uppercase text-slate-400 mb-1 font-semibold">New Password (min 6 chars)</label>
                <input type="password" name="newPassword" id="newPasswordField" minlength="6" required placeholder="Enter new password" class="w-full bg-slate-50 dark:bg-obsidian-950 border border-slate-300 dark:border-obsidian-700 px-3 py-2 text-xs text-slate-900 dark:text-white outline-none focus:border-primary">
            </div>

            <div class="flex justify-end gap-2 pt-3 border-t border-slate-200 dark:border-obsidian-800">
                <button type="button" onclick="closeResetPasswordModal()" class="px-4 py-2 bg-slate-100 dark:bg-obsidian-800 text-slate-700 dark:text-slate-300 font-mono text-xs uppercase font-bold border border-slate-300 dark:border-obsidian-700">
                    Cancel
                </button>
                <button type="submit" class="px-5 py-2 bg-primary hover:bg-primary-hover text-white font-mono text-xs uppercase font-bold transition-all border border-primary-hover active:translate-y-0.5">
                    Update Password
                </button>
            </div>
        </form>
    </div>
</div>

<script>
function filterUsers() {
    const query = (document.getElementById('userSearchInput').value || '').toLowerCase().trim();
    const rows = document.querySelectorAll('.user-row');
    let visibleCount = 0;

    rows.forEach(row => {
        const username = row.getAttribute('data-username') || '';
        const role = row.getAttribute('data-role') || '';
        const matches = !query || username.includes(query) || role.includes(query);

        row.classList.toggle('hidden', !matches);
        if (matches) visibleCount++;
    });

    const emptyMsg = document.getElementById('noUsersMessage');
    if (emptyMsg) emptyMsg.classList.toggle('hidden', visibleCount > 0);
}

function openCreateUserModal() {
    document.getElementById('createUserModal').classList.remove('hidden');
}

function closeCreateUserModal() {
    document.getElementById('createUserModal').classList.add('hidden');
}

function openResetPasswordModal(username) {
    document.getElementById('resetPasswordUsername').value = username;
    document.getElementById('resetPasswordTargetDisplay').innerText = username;
    document.getElementById('newPasswordField').value = '';
    document.getElementById('resetPasswordModal').classList.remove('hidden');
}

function closeResetPasswordModal() {
    document.getElementById('resetPasswordModal').classList.add('hidden');
}

async function handleCreateUser(e) {
    e.preventDefault();
    const formData = new FormData(e.target);
    const data = Object.fromEntries(formData.entries());

    try {
        const res = await fetch('/api/admin/create-user', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
        });

        const result = await res.json();
        if (res.ok && result.success) {
            if (typeof showToast === 'function') showToast(`User '${data.username}' created.`, 'success');
            closeCreateUserModal();
            setTimeout(() => window.location.reload(), 600);
        } else {
            if (typeof showToast === 'function') showToast(result.error || 'Failed to create user', 'error');
        }
    } catch (err) {
        if (typeof showToast === 'function') showToast('Error creating user account', 'error');
    }
}

async function handleResetPassword(e) {
    e.preventDefault();
    const formData = new FormData(e.target);
    const data = Object.fromEntries(formData.entries());

    try {
        const res = await fetch('/api/admin/reset-password', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
        });

        const result = await res.json();
        if (res.ok && result.success) {
            if (typeof showToast === 'function') showToast(`Password for '${data.username}' reset successfully.`, 'success');
            closeResetPasswordModal();
        } else {
            if (typeof showToast === 'function') showToast(result.error || 'Failed to reset password', 'error');
        }
    } catch (err) {
        if (typeof showToast === 'function') showToast('Error resetting password', 'error');
    }
}

async function promoteUser(username) {
    if (!confirm(`Promote user '${username}' to Administrator?`)) return;
    try {
        const res = await fetch('/api/admin/promote', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ username })
        });
        if (res.ok) {
            if (typeof showToast === 'function') showToast(`User '${username}' promoted to Admin.`, 'success');
            setTimeout(() => window.location.reload(), 600);
        } else {
            if (typeof showToast === 'function') showToast('Failed to promote user.', 'error');
        }
    } catch (err) {
        if (typeof showToast === 'function') showToast('Error promoting user.', 'error');
    }
}

async function demoteUser(username) {
    if (!confirm(`Demote user '${username}' to regular user?`)) return;
    try {
        const res = await fetch('/api/admin/demote', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ username })
        });
        if (res.ok) {
            if (typeof showToast === 'function') showToast(`User '${username}' demoted to user.`, 'info');
            setTimeout(() => window.location.reload(), 600);
        } else {
            if (typeof showToast === 'function') showToast('Failed to demote user.', 'error');
        }
    } catch (err) {
        if (typeof showToast === 'function') showToast('Error demoting user.', 'error');
    }
}

async function deleteUserAccount(username) {
    if (!confirm(`Permanently delete user account '${username}'? Any bots assigned to this user will be unlinked.`)) return;
    try {
        const res = await fetch('/api/admin/delete-user', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ username })
        });
        const result = await res.json();
        if (res.ok && result.success) {
            if (typeof showToast === 'function') showToast(`User '${username}' deleted.`, 'info');
            setTimeout(() => window.location.reload(), 600);
        } else {
            if (typeof showToast === 'function') showToast(result.error || 'Failed to delete user.', 'error');
        }
    } catch (err) {
        if (typeof showToast === 'function') showToast('Error deleting user account.', 'error');
    }
}
</script>

<%- include('../partials/footer') %>
