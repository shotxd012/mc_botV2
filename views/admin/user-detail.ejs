<%- include('../partials/header') %>
<%- include('../partials/sidebar') %>

<main class="flex-1 p-4 sm:p-6 md:p-8 max-w-[1280px] w-full mx-auto min-h-screen pb-20 md:pb-8 flex flex-col gap-6">
    <%- include('layout-nav') %>

    <header class="flex flex-wrap items-center justify-between gap-4 border-b border-ghborder-default pb-4">
        <div class="flex items-center gap-3 min-w-0">
            <a href="/admin/users" class="p-2 bg-canvas-subtle hover:bg-canvas-default text-fg-muted hover:text-fg-default border border-ghborder-default rounded-md" title="Back to users"><span class="material-icons text-base">arrow_back</span></a>
            <div class="min-w-0">
                <div class="flex items-center gap-2"><h1 class="text-xl sm:text-2xl font-bold text-fg-default truncate"><%= target.username %></h1><span class="px-2 py-0.5 rounded-pill text-[10px] font-mono uppercase border <%= target.role === 'admin' ? 'bg-danger-subtle text-danger-fg border-danger-muted' : 'bg-accent-subtle text-accent-fg border-accent-muted' %>"><%= target.role %></span></div>
                <p class="text-xs text-fg-muted mt-1 font-mono">Account created <%= target.createdAt ? new Date(target.createdAt).toLocaleDateString() : 'N/A' %></p>
            </div>
        </div>
        <span class="text-[10px] font-mono uppercase tracking-widest text-accent-fg border border-accent-muted bg-accent-subtle px-2 py-1 rounded-pill">User Access</span>
    </header>

    <div class="grid grid-cols-1 xl:grid-cols-3 gap-5">
        <form onsubmit="saveUser(event)" class="xl:col-span-2 bg-canvas-default border border-ghborder-default rounded-md p-5 shadow-sm space-y-5">
            <div class="flex items-center gap-2 border-b border-ghborder-muted pb-3"><span class="material-icons text-accent-fg">manage_accounts</span><h2 class="text-sm font-semibold text-fg-default">Account & Permissions</h2></div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div><label class="block text-xs font-semibold text-fg-default mb-1">Username</label><input value="<%= target.username %>" disabled class="w-full px-3 py-2 bg-canvas-subtle border border-ghborder-default rounded-md text-xs text-fg-muted"></div>
                <div><label class="block text-xs font-semibold text-fg-default mb-1">Role</label><select name="role" id="user-role" class="w-full px-3 py-2 bg-canvas-default border border-ghborder-default rounded-md text-xs text-fg-default focus:border-accent-fg"><option value="user" <%= target.role === 'user' ? 'selected' : '' %>>User</option><option value="admin" <%= target.role === 'admin' ? 'selected' : '' %>>Administrator</option></select></div>
            </div>
            <div class="flex items-start justify-between gap-4 p-3 bg-canvas-subtle border border-ghborder-default rounded-md"><div><div class="font-semibold text-fg-default text-xs">Allow bot creation</div><div class="text-[11px] text-fg-muted mt-0.5">Let this user create and own bots from their dashboard.</div></div><input type="checkbox" name="canCreateBots" id="can-create-bots" <%= target.canCreateBots ? 'checked' : '' %> class="accent-accent-fg w-4 h-4 mt-1"></div>
            <div><label class="block text-xs font-semibold text-fg-default mb-1">Bot slots</label><input type="number" name="botLimit" id="bot-limit" min="0" value="<%= target.botLimit || 0 %>" class="w-full px-3 py-2 bg-canvas-default border border-ghborder-default rounded-md text-xs text-fg-default focus:border-accent-fg"><p class="text-[11px] text-fg-muted mt-1">Use 0 for unlimited slots. Administrators are always unlimited.</p></div>
            <div class="border-t border-ghborder-muted pt-5"><label class="block text-xs font-semibold text-fg-default mb-1">New password</label><input type="password" name="password" minlength="6" placeholder="Leave blank to keep current password" class="w-full px-3 py-2 bg-canvas-default border border-ghborder-default rounded-md text-xs text-fg-default focus:border-accent-fg"><p class="text-[11px] text-fg-muted mt-1">Minimum 6 characters when changing the password.</p></div>
            <div class="flex justify-end"><button class="inline-flex items-center gap-2 px-4 py-2 bg-accent-emphasis hover:bg-accent-fg text-white rounded-md text-xs font-semibold border border-accent-emphasis"><span class="material-icons text-sm">save</span>Save user access</button></div>
        </form>

        <aside class="bg-canvas-default border border-ghborder-default rounded-md p-5 shadow-sm h-fit space-y-4">
            <div class="flex items-center gap-2 border-b border-ghborder-muted pb-3"><span class="material-icons text-accent-fg">dns</span><h2 class="text-sm font-semibold text-fg-default">Bot capacity</h2></div>
            <div class="text-center py-3"><div class="text-3xl font-bold font-mono text-fg-default"><%= assignedBots.length %> <span class="text-fg-muted text-base">/ <%= target.role === 'admin' ? '∞' : (target.botLimit || 0) %></span></div><div class="text-[10px] uppercase tracking-wider text-fg-muted mt-1">assigned slots</div></div>
            <div class="h-2 bg-canvas-subtle rounded-pill overflow-hidden"><div class="h-full bg-accent-emphasis" style="width:<%= target.role === 'admin' || !target.botLimit ? (assignedBots.length ? '35%' : '0%') : Math.min(100, (assignedBots.length / target.botLimit) * 100) %>%"></div></div>
            <p class="text-[11px] text-fg-muted">Bots created by this user are automatically assigned to their account.</p>
        </aside>
    </div>

    <section class="bg-canvas-default border border-ghborder-default rounded-md p-5 shadow-sm">
        <div class="flex flex-wrap items-center justify-between gap-3 border-b border-ghborder-muted pb-3 mb-4"><div class="flex items-center gap-2"><span class="material-icons text-accent-fg">smart_toy</span><h2 class="text-sm font-semibold text-fg-default">Assigned bots</h2></div><span class="text-[10px] font-mono text-fg-muted"><%= assignedBots.length %> assigned</span></div>
        <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-3">
            <% assignedBots.forEach(function(bot) { %>
                <div class="flex items-center justify-between gap-3 p-3 bg-canvas-subtle border border-ghborder-default rounded-md"><a href="/bot/<%= bot.id %>" class="min-w-0 hover:text-accent-fg"><div class="font-semibold text-xs text-fg-default truncate"><%= bot.name %></div><div class="text-[10px] text-fg-muted font-mono">#<%= bot.id %> · <%= bot.server?.ip || 'No server' %></div></a><button onclick="unassignBot(<%= bot.id %>)" class="p-1.5 text-fg-muted hover:text-danger-fg border border-ghborder-default rounded-md" title="Remove bot"><span class="material-icons text-sm">link_off</span></button></div>
            <% }); %>
        </div>
        <% if (!assignedBots.length) { %><p class="text-xs text-fg-muted italic py-4">No bots assigned to this account.</p><% } %>
    </section>

    <section class="bg-canvas-default border border-ghborder-default rounded-md p-5 shadow-sm">
        <div class="flex items-center gap-2 border-b border-ghborder-muted pb-3 mb-4"><span class="material-icons text-accent-fg">assignment_ind</span><h2 class="text-sm font-semibold text-fg-default">Assign an existing bot</h2></div>
        <div class="flex flex-col sm:flex-row gap-3"><select id="assign-bot-select" class="flex-1 px-3 py-2 bg-canvas-default border border-ghborder-default rounded-md text-xs text-fg-default"><option value="">Choose an unassigned bot</option><% bots.filter(bot => !bot.assignedTo).forEach(function(bot) { %><option value="<%= bot.id %>"><%= bot.name %> (#<%= bot.id %>)</option><% }); %></select><button onclick="assignBot()" class="inline-flex items-center justify-center gap-2 px-4 py-2 bg-accent-emphasis hover:bg-accent-fg text-white rounded-md text-xs font-semibold"><span class="material-icons text-sm">link</span>Assign bot</button></div>
    </section>
</main>

<script>
const USERNAME = <%- JSON.stringify(target.username) %>;
async function saveUser(event) { event.preventDefault(); const form = new FormData(event.target); const data = { username: USERNAME, role: form.get('role'), canCreateBots: form.get('canCreateBots') === 'on', botLimit: form.get('botLimit'), password: form.get('password') }; try { const response = await fetch('/api/admin/user/update', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data) }); const result = await response.json(); if (!response.ok || !result.success) throw new Error(result.error || 'Unable to update user.'); showToast('User access updated.', 'success'); setTimeout(() => window.location.reload(), 500); } catch (error) { showToast(error.message, 'error'); } }
async function assignBot() { const botId = document.getElementById('assign-bot-select').value; if (!botId) return; await updateBotAssignment('/api/admin/assign-bot', { botId, username: USERNAME }); }
async function unassignBot(botId) { if (!confirm('Remove this bot from the user?')) return; await updateBotAssignment('/api/admin/unassign-bot', { botId }); }
async function updateBotAssignment(url, body) { try { const response = await fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) }); const result = await response.json(); if (!response.ok || !result.success) throw new Error(result.error || 'Assignment failed.'); showToast('Bot assignment updated.', 'success'); setTimeout(() => window.location.reload(), 500); } catch (error) { showToast(error.message, 'error'); } }
</script>

<%- include('../partials/footer') %>
