<%- include('partials/header') %>
<%- include('partials/sidebar') %>

<script>
    const BOT_ID = "<%= botId %>";
    const BOT_SECTION = "<%= section || 'config' %>";
</script>

<main class="flex-1 min-w-0 p-4 sm:p-6 md:p-8 min-h-screen pb-20 md:pb-8 flex flex-col gap-6">
    <!-- Header -->
    <header class="flex flex-col gap-4 border-b border-slate-200 dark:border-obsidian-700/60 pb-4">
        <div class="flex min-w-0 flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
        <div class="flex items-center gap-3">
            <a href="/" class="p-2 bg-slate-100 dark:bg-obsidian-850 hover:bg-slate-200 dark:hover:bg-obsidian-800 text-slate-600 dark:text-slate-300 transition-colors border border-slate-200 dark:border-obsidian-700 flex items-center justify-center">
                <span class="material-icons text-base">arrow_back</span>
            </a>
            <div>
                <div class="flex items-center gap-2.5">
                    <h2 class="bot-title text-xl md:text-2xl font-bold uppercase tracking-tight text-slate-900 dark:text-white"><%= botConfig.name %></h2>
                    <span class="px-1.5 py-0.5 font-mono text-[10px] bg-slate-100 dark:bg-obsidian-800 border border-slate-200 dark:border-obsidian-700 text-slate-500 dark:text-slate-400">#<%= botId %></span>
                    <% if (botConfig.autoStart) { %>
                    <span class="px-1.5 py-0.5 font-mono text-[10px] bg-emerald-500/10 border border-emerald-500/30 text-emerald-400">AUTO-START</span>
                    <% } %>
                </div>
                <div class="flex items-center gap-2 text-xs text-slate-500 dark:text-slate-400 mt-1 font-mono">
                    <span id="status-dot" class="w-2 h-2 inline-block <%= status.online ? 'bg-emerald-500' : 'bg-redstone-500' %>"></span>
                    <span id="status-text" class="font-bold"><%= status.online ? 'Online' : 'Offline' %></span>
                    <span>•</span>
                    <span class="truncate"><%= typeof status.server !== 'undefined' ? status.server.ip + ':' + status.server.port : 'No server configured' %></span>
                </div>
            </div>
        </div>

        <a href="/bot/<%= botId %>/settings" class="self-end sm:self-auto inline-flex items-center gap-2 px-3 py-2 text-slate-400 hover:text-white hover:bg-obsidian-800 font-mono text-xs uppercase font-bold transition-all border border-obsidian-700 hover:border-obsidian-600">
            <span class="material-icons text-sm">settings</span>
            <span>Bot Settings</span>
        </a>
        </div>

        <nav class="flex w-full min-w-0 max-w-full items-center gap-1 overflow-x-auto border border-obsidian-700/80 bg-obsidian-900/70 p-1 shadow-sm" aria-label="Bot workspace">
            <span class="hidden lg:flex items-center gap-2 px-3 text-[10px] font-mono uppercase tracking-widest text-slate-500 whitespace-nowrap">
                <span class="material-icons text-sm text-primary">tune</span>
                Workspace
            </span>
            <a href="/bot/<%= botId %>" aria-current="<%= section === 'console' ? 'page' : 'false' %>" class="flex min-w-[108px] flex-1 items-center justify-center gap-1.5 px-3 py-2 text-[10px] font-mono uppercase tracking-wider font-bold whitespace-nowrap border <%= section === 'console' ? 'border-primary text-primary bg-primary/10' : 'border-transparent text-slate-400 hover:text-slate-200 hover:bg-obsidian-800' %> transition-colors">
                <span class="material-icons text-sm">terminal</span> Console
            </a>
            <a href="/bot/<%= botId %>/config" aria-current="<%= section === 'config' ? 'page' : 'false' %>" class="flex min-w-[108px] flex-1 items-center justify-center gap-1.5 px-3 py-2 text-[10px] font-mono uppercase tracking-wider font-bold whitespace-nowrap border <%= section === 'config' ? 'border-primary text-primary bg-primary/10' : 'border-transparent text-slate-400 hover:text-slate-200 hover:bg-obsidian-800' %> transition-colors">
                <span class="material-icons text-sm">settings</span> Config
            </a>
            <a href="/bot/<%= botId %>/analytics" aria-current="<%= section === 'analytics' ? 'page' : 'false' %>" class="flex min-w-[108px] flex-1 items-center justify-center gap-1.5 px-3 py-2 text-[10px] font-mono uppercase tracking-wider font-bold whitespace-nowrap border <%= section === 'analytics' ? 'border-primary text-primary bg-primary/10' : 'border-transparent text-slate-400 hover:text-slate-200 hover:bg-obsidian-800' %> transition-colors">
                <span class="material-icons text-sm">show_chart</span> Analytics
            </a>
            <a href="/bot/<%= botId %>/events" aria-current="<%= section === 'events' ? 'page' : 'false' %>" class="flex min-w-[108px] flex-1 items-center justify-center gap-1.5 px-3 py-2 text-[10px] font-mono uppercase tracking-wider font-bold whitespace-nowrap border <%= section === 'events' ? 'border-primary text-primary bg-primary/10' : 'border-transparent text-slate-400 hover:text-slate-200 hover:bg-obsidian-800' %> transition-colors">
                <span class="material-icons text-sm">timeline</span> Events
            </a>
            <a href="/bot/<%= botId %>/game" aria-current="<%= section === 'game' ? 'page' : 'false' %>" class="flex min-w-[108px] flex-1 items-center justify-center gap-1.5 px-3 py-2 text-[10px] font-mono uppercase tracking-wider font-bold whitespace-nowrap border <%= section === 'game' ? 'border-primary text-primary bg-primary/10' : 'border-transparent text-slate-400 hover:text-slate-200 hover:bg-obsidian-800' %> transition-colors">
                <span class="material-icons text-sm">sports_esports</span> In-Game
            </a>
            <a href="/bot/<%= botId %>/settings" aria-current="<%= section === 'settings' ? 'page' : 'false' %>" class="flex min-w-[108px] flex-1 items-center justify-center gap-1.5 px-3 py-2 text-[10px] font-mono uppercase tracking-wider font-bold whitespace-nowrap border <%= section === 'settings' ? 'border-primary text-primary bg-primary/10' : 'border-transparent text-slate-400 hover:text-slate-200 hover:bg-obsidian-800' %> transition-colors">
                <span class="material-icons text-sm">tune</span> Settings
            </a>
        </nav>
    </header>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 flex-1 min-h-0">
        <!-- Left Column: Controls & Console -->
        <div class="<%= section === 'console' ? 'lg:col-span-3' : 'hidden' %> flex flex-col gap-5 min-h-0">
            <!-- Controls Box -->
            <div class="bg-white dark:bg-obsidian-900 border border-slate-200 dark:border-obsidian-700/80 p-5 shadow-sm">
                <div class="flex flex-wrap gap-3">
                    <!-- Start/Stop Button -->
                    <button id="start-stop-btn" onclick="toggleStartStop()" class="flex-1 flex items-center justify-center gap-2 px-4 py-2.5 <%= status.isRunning ? 'bg-redstone-600 hover:bg-redstone-500 border-redstone-500/50' : 'bg-emerald-600 hover:bg-emerald-500 border-emerald-500/50' %> text-white font-mono font-bold text-xs uppercase tracking-wider transition-all border shadow-sm active:translate-y-0.5 min-w-[120px]">
                        <span id="start-stop-icon" class="material-icons text-sm"><%= status.isRunning ? 'stop' : 'play_arrow' %></span>
                        <span id="start-stop-text"><%= status.isRunning ? 'Stop Bot' : 'Start Bot' %></span>
                    </button>

                    <!-- Restart Button -->
                    <button onclick="controlBot('restart')" class="flex-1 flex items-center justify-center gap-2 px-4 py-2.5 bg-amber-600 hover:bg-amber-500 text-white font-mono font-bold text-xs uppercase tracking-wider transition-all border border-amber-500/50 shadow-sm active:translate-y-0.5 min-w-[120px]">
                        <span class="material-icons text-sm">refresh</span>
                        <span>Restart</span>
                    </button>

                    <div class="w-px h-8 bg-slate-200 dark:border-obsidian-700 hidden md:block self-center"></div>

                    <!-- AFK Toggle Button -->
                    <button id="afk-btn" onclick="toggleAfk()" class="flex-1 flex items-center justify-center gap-1.5 px-4 py-2.5 <%= status.isAfkActive ? 'bg-emerald-500/20 text-emerald-400 border-emerald-500/50 hover:bg-emerald-500/30' : 'bg-slate-100 dark:bg-obsidian-800 text-slate-700 dark:text-slate-300 border-slate-300 dark:border-obsidian-700 hover:bg-slate-200 dark:hover:bg-obsidian-750' %> text-xs font-mono font-bold uppercase tracking-wider transition-all border min-w-[120px] active:translate-y-0.5">
                        <span class="inline-block w-2 h-2 mr-1.5 <%= status.isAfkActive ? 'bg-emerald-400' : 'bg-slate-500' %>"></span>
                        <span><%= status.isAfkActive ? 'Stop AFK' : 'Start AFK' %></span>
                    </button>
                </div>

                <!-- AFK Profile Selector -->
                <div class="mt-4 flex items-center gap-3">
                    <label class="text-[10px] font-mono uppercase tracking-wider text-slate-400 font-semibold whitespace-nowrap">AFK Profile:</label>
                    <select id="afk-profile-select" onchange="setAfkProfile(this.value)" class="flex-1 bg-slate-50 dark:bg-obsidian-950 border border-slate-300 dark:border-obsidian-700 px-3 py-1.5 text-xs font-mono text-slate-900 dark:text-white outline-none focus:border-primary transition-colors">
                        <option value="random_look" <%= (status.afkProfile === 'random_look' || !status.afkProfile) ? 'selected' : '' %>>Random Look (Default)</option>
                        <option value="spin" <%= status.afkProfile === 'spin' ? 'selected' : '' %>>Spin 360°</option>
                        <option value="jump_spam" <%= status.afkProfile === 'jump_spam' ? 'selected' : '' %>>Jump Spam</option>
                        <option value="circle_walk" <%= status.afkProfile === 'circle_walk' ? 'selected' : '' %>>Circle Walk</option>
                    </select>
                </div>

                <!-- Status Row -->
                <div class="grid grid-cols-3 gap-3 mt-5 pt-5 border-t border-slate-200 dark:border-obsidian-700/60">
                    <div class="text-center p-2 bg-slate-50 dark:bg-obsidian-950/60 border border-slate-200 dark:border-obsidian-800">
                        <div class="text-[10px] font-mono uppercase text-slate-400 mb-1">Session Uptime</div>
                        <div id="uptime-text" class="font-mono text-sm font-bold text-slate-900 dark:text-white"><%= status.uptime || '0s' %></div>
                    </div>
                    <div class="text-center p-2 bg-slate-50 dark:bg-obsidian-950/60 border border-slate-200 dark:border-obsidian-800">
                        <div class="text-[10px] font-mono uppercase text-slate-400 mb-1">Auth Status</div>
                        <div class="flex items-center justify-center mt-0.5">
                            <span id="auth-status" class="font-mono text-xs uppercase px-2 py-0.5 border font-bold <%= status.authStatus === 'Verified' ? 'text-emerald-400 border-emerald-500/30 bg-emerald-500/10' : (status.authStatus === 'Pending' ? 'text-amber-400 border-amber-500/30 bg-amber-500/10 animate-pulse' : 'text-slate-400 border-slate-700 bg-slate-800') %>">
                                <%= status.authStatus || 'Offline' %>
                            </span>
                        </div>
                    </div>
                    <div class="text-center p-2 bg-slate-50 dark:bg-obsidian-950/60 border border-slate-200 dark:border-obsidian-800">
                        <div class="text-[10px] font-mono uppercase text-slate-400 mb-1">Total Uptime</div>
                        <div id="total-uptime" class="font-mono text-sm font-bold text-slate-900 dark:text-white"><%= Math.floor((status.totalUptime || 0) / 3600) %>h <%= Math.floor(((status.totalUptime || 0) % 3600) / 60) %>m</div>
                    </div>
                </div>

                <!-- Bot HUD — Health/Food with Progress Bars -->
                <div class="mt-5 pt-5 border-t border-slate-200 dark:border-obsidian-700/60">
                    <div class="flex items-center justify-between mb-3">
                        <h3 class="text-[10px] font-mono uppercase tracking-widest text-slate-400 font-bold">In-Game Telemetry</h3>
                        <span class="text-[10px] font-mono text-slate-500">Live Entity Metrics</span>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-3 mb-3">
                        <!-- Health Bar -->
                        <div class="bg-slate-50 dark:bg-obsidian-950/60 p-3 border border-slate-200 dark:border-obsidian-800">
                            <div class="flex items-center justify-between mb-1.5">
                                <span class="text-[10px] font-mono uppercase text-slate-400 flex items-center gap-1">
                                    <span class="text-redstone-400">❤</span> Health
                                </span>
                                <span id="detail-health" class="text-xs font-mono font-bold text-redstone-400">-</span>
                            </div>
                            <div class="w-full bg-slate-200 dark:bg-obsidian-800 h-2 overflow-hidden">
                                <div id="health-bar" class="h-full bg-redstone-500 transition-all duration-700" style="width: 0%"></div>
                            </div>
                        </div>
                        <!-- Food Bar -->
                        <div class="bg-slate-50 dark:bg-obsidian-950/60 p-3 border border-slate-200 dark:border-obsidian-800">
                            <div class="flex items-center justify-between mb-1.5">
                                <span class="text-[10px] font-mono uppercase text-slate-400 flex items-center gap-1">
                                    <span class="text-amber-400">🍗</span> Food
                                </span>
                                <span id="detail-food" class="text-xs font-mono font-bold text-emerald-400">-</span>
                            </div>
                            <div class="w-full bg-slate-200 dark:bg-obsidian-800 h-2 overflow-hidden">
                                <div id="food-bar" class="h-full bg-emerald-500 transition-all duration-700" style="width: 0%"></div>
                            </div>
                        </div>
                    </div>
                    <div class="grid grid-cols-2 md:grid-cols-3 gap-3">
                        <div class="bg-slate-50 dark:bg-obsidian-950/60 p-3 border border-slate-200 dark:border-obsidian-800 text-center">
                            <div class="text-[10px] font-mono uppercase text-slate-400 mb-1">Entity</div>
                            <div id="detail-username" class="text-xs font-mono font-bold truncate text-slate-800 dark:text-slate-200"><%= (status.username && status.username !== 'N/A') ? status.username : '-' %></div>
                        </div>
                        <div class="bg-slate-50 dark:bg-obsidian-950/60 p-3 border border-slate-200 dark:border-obsidian-800 text-center">
                            <div class="text-[10px] font-mono uppercase text-slate-400 mb-1">Position</div>
                            <div id="detail-position" class="text-xs font-mono font-bold truncate text-slate-800 dark:text-slate-200">-</div>
                        </div>
                        <div class="bg-slate-50 dark:bg-obsidian-950/60 p-3 border border-slate-200 dark:border-obsidian-800 text-center">
                            <div class="text-[10px] font-mono uppercase text-slate-400 mb-1">Dimension</div>
                            <div id="detail-dimension" class="text-xs font-mono font-bold uppercase text-slate-800 dark:text-slate-200">-</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Terminal / Console -->
            <div class="flex-none h-[320px] bg-obsidian-950 border border-slate-300 dark:border-obsidian-700 flex flex-col overflow-hidden shadow-lg">
                <div class="px-4 py-2.5 bg-obsidian-900 border-b border-obsidian-700/80 flex justify-between items-center select-none gap-3">
                    <div class="flex items-center gap-2">
                        <span class="w-2.5 h-2.5 bg-emerald-500 inline-block"></span>
                        <span class="text-xs font-mono font-bold uppercase tracking-wider text-slate-300">Terminal Output Stream</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <!-- Log Search -->
                        <input type="text" id="log-search-input" placeholder="Search logs..." oninput="filterLogs(this.value)" class="bg-obsidian-950 border border-obsidian-700 text-white font-mono text-xs px-2 py-1 focus:border-primary outline-none w-32 transition-all focus:w-48 placeholder-slate-600">
                        <button onclick="clearConsole()" class="text-[10px] font-mono uppercase px-2 py-0.5 text-slate-400 hover:text-white border border-obsidian-700 hover:border-slate-500 transition-colors">
                            Clear Buffer
                        </button>
                    </div>
                </div>

                <div id="console-logs" class="h-[220px] flex-none p-3.5 overflow-y-auto text-xs font-mono space-y-0.5 bg-obsidian-950 text-slate-300 console-logs leading-relaxed">
                    <div class="console-placeholder text-slate-500 italic py-1">Connecting to console stream...</div>
                </div>

                <div class="p-3 bg-obsidian-900 border-t border-obsidian-700/80">
                    <form onsubmit="sendCommand(event)" class="flex gap-2">
                        <div class="relative flex-1">
                            <span class="absolute left-3 top-2.5 font-mono text-xs text-primary select-none">></span>
                            <input type="text" id="command-input" class="w-full pl-7 pr-3 py-2 bg-obsidian-950 border border-obsidian-700 text-white font-mono text-xs focus:border-primary outline-none transition-colors" placeholder="Type command or chat message... (↑↓ for history)" autocomplete="off">
                        </div>
                        <button type="submit" class="px-5 py-2 bg-primary hover:bg-primary-hover text-white font-mono text-xs font-bold uppercase tracking-wider transition-colors border border-primary-hover active:translate-y-0.5">
                            Send
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <!-- Right Column: Settings & Analytics -->
        <div class="<%= section === 'console' ? 'hidden' : 'lg:col-span-3 max-w-5xl w-full mx-auto' %> flex flex-col gap-5">

            <!-- Config Tab -->
            <div id="panel-config" class="<%= section === 'config' ? '' : 'hidden ' %>flex flex-col gap-4">
                <!-- Configuration Box -->
                <div class="bg-white dark:bg-obsidian-900 p-5 border border-slate-200 dark:border-obsidian-700/80 shadow-sm">
                    <div class="flex items-center gap-2 mb-4 border-b border-slate-200 dark:border-obsidian-700/60 pb-3">
                        <span class="material-icons text-primary text-base">settings</span>
                        <h3 class="text-xs font-mono uppercase tracking-wider font-bold text-slate-900 dark:text-white">Bot Configuration</h3>
                    </div>

                    <form onsubmit="updateBotConfig(event)" class="space-y-3.5">
                        <div>
                            <label class="block text-[10px] font-mono uppercase tracking-wider text-slate-500 dark:text-slate-400 mb-1 font-semibold">Instance Name</label>
                            <input type="text" name="name" value="<%= botConfig.name %>" required class="w-full px-3 py-2 bg-slate-50 dark:bg-obsidian-950 border border-slate-300 dark:border-obsidian-700 text-xs text-slate-900 dark:text-white outline-none focus:border-primary">
                        </div>
                        <div>
                            <label class="block text-[10px] font-mono uppercase tracking-wider text-slate-500 dark:text-slate-400 mb-1 font-semibold">Server Host IP</label>
                            <input type="text" name="ip" value="<%= typeof botConfig.server !== 'undefined' ? botConfig.server.ip : '' %>" required class="w-full px-3 py-2 bg-slate-50 dark:bg-obsidian-950 border border-slate-300 dark:border-obsidian-700 text-xs font-mono text-slate-900 dark:text-white outline-none focus:border-primary">
                        </div>
                        <div class="grid grid-cols-2 gap-3">
                            <div>
                                <label class="block text-[10px] font-mono uppercase tracking-wider text-slate-500 dark:text-slate-400 mb-1 font-semibold">Port</label>
                                <input type="number" name="port" value="<%= typeof botConfig.server !== 'undefined' ? botConfig.server.port : '25565' %>" required class="w-full px-3 py-2 bg-slate-50 dark:bg-obsidian-950 border border-slate-300 dark:border-obsidian-700 text-xs font-mono text-slate-900 dark:text-white outline-none focus:border-primary">
                            </div>
                            <div>
                                <label class="block text-[10px] font-mono uppercase tracking-wider text-slate-500 dark:text-slate-400 mb-1 font-semibold">Version</label>
                                <input type="text" name="version" value="<%= typeof botConfig.server !== 'undefined' ? botConfig.server.version : '1.20.4' %>" required class="w-full px-3 py-2 bg-slate-50 dark:bg-obsidian-950 border border-slate-300 dark:border-obsidian-700 text-xs font-mono text-slate-900 dark:text-white outline-none focus:border-primary">
                            </div>
                        </div>
                        <div>
                            <label class="block text-[10px] font-mono uppercase tracking-wider text-slate-500 dark:text-slate-400 mb-1 font-semibold">Microsoft Account Email</label>
                            <input type="email" name="email" value="<%= typeof botConfig.account !== 'undefined' ? botConfig.account.email : '' %>" required class="w-full px-3 py-2 bg-slate-50 dark:bg-obsidian-950 border border-slate-300 dark:border-obsidian-700 text-xs text-slate-900 dark:text-white outline-none focus:border-primary">
                        </div>
                        <button type="submit" class="w-full bg-primary hover:bg-primary-hover text-white font-mono text-xs font-bold uppercase tracking-wider py-2.5 transition-all border border-primary-hover active:translate-y-0.5">
                            Save Configuration
                        </button>
                    </form>
                </div>

                <!-- Automation Settings -->
                <div class="bg-white dark:bg-obsidian-900 p-5 border border-slate-200 dark:border-obsidian-700/80 shadow-sm">
                    <div class="flex items-center gap-2 mb-4 border-b border-slate-200 dark:border-obsidian-700/60 pb-3">
                        <span class="material-icons text-primary text-base">auto_fix_high</span>
                        <h3 class="text-xs font-mono uppercase tracking-wider font-bold text-slate-900 dark:text-white">Automation</h3>
                    </div>
                    <div class="space-y-3">
                        <!-- Auto-Eat Toggle -->
                        <div class="flex items-center justify-between">
                            <div>
                                <div class="text-xs font-semibold text-slate-800 dark:text-slate-200">Auto Eat</div>
                                <div class="text-[10px] text-slate-400">Automatically eat food when hungry</div>
                            </div>
                            <button id="auto-eat-btn" onclick="toggleAutoEat()" class="relative w-10 h-5 transition-colors <%= botConfig.autoEat !== false ? 'bg-primary' : 'bg-slate-300 dark:bg-obsidian-700' %> border border-slate-300 dark:border-obsidian-600">
                                <span id="auto-eat-knob" class="absolute top-0.5 h-4 w-4 bg-white transition-transform <%= botConfig.autoEat !== false ? 'translate-x-5' : 'translate-x-0.5' %>"></span>
                            </button>
                        </div>
                        <!-- Auto-Start Toggle (admin only) -->
                        <% if (user && user.role === 'admin') { %>
                        <div class="flex items-center justify-between">
                            <div>
                                <div class="text-xs font-semibold text-slate-800 dark:text-slate-200">Auto-Start on Boot</div>
                                <div class="text-[10px] text-slate-400">Start this bot when server starts</div>
                            </div>
                            <button id="auto-start-btn" onclick="toggleAutoStart()" class="relative w-10 h-5 transition-colors <%= botConfig.autoStart ? 'bg-primary' : 'bg-slate-300 dark:bg-obsidian-700' %> border border-slate-300 dark:border-obsidian-600">
                                <span id="auto-start-knob" class="absolute top-0.5 h-4 w-4 bg-white transition-transform <%= botConfig.autoStart ? 'translate-x-5' : 'translate-x-0.5' %>"></span>
                            </button>
                        </div>
                        <% } %>
                    </div>
                </div>

                <!-- Webhook & Login Commands -->
                <div class="bg-white dark:bg-obsidian-900 p-5 border border-slate-200 dark:border-obsidian-700/80 shadow-sm">
                    <div class="flex items-center gap-2 mb-4 border-b border-slate-200 dark:border-obsidian-700/60 pb-3">
                        <span class="material-icons text-primary text-base">notifications</span>
                        <h3 class="text-xs font-mono uppercase tracking-wider font-bold text-slate-900 dark:text-white">Alerts & Commands</h3>
                    </div>
                    <div class="space-y-3.5">
                        <div>
                            <label class="block text-[10px] font-mono uppercase tracking-wider text-slate-500 mb-1 font-semibold">Discord/Slack Webhook URL</label>
                            <div class="flex gap-2">
                                <input type="url" id="webhook-input" value="<%= botConfig.webhookUrl || '' %>" placeholder="https://discord.com/api/webhooks/..." class="flex-1 px-3 py-2 bg-slate-50 dark:bg-obsidian-950 border border-slate-300 dark:border-obsidian-700 text-xs text-slate-900 dark:text-white outline-none focus:border-primary">
