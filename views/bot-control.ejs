<%- include('partials/header') %>
<%- include('partials/sidebar') %>

<script>
    const BOT_ID = "<%= botId %>";
    const BOT_SECTION = "<%= section || 'config' %>";
</script>

<main class="flex-1 min-w-0 p-4 sm:p-6 md:p-8 max-w-[1280px] w-full mx-auto flex flex-col gap-6">
    <!-- GitHub Repository Header Format -->
    <header class="flex flex-col gap-4 border-b border-ghborder-default pb-4">
        <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
            <div class="flex items-center gap-2 min-w-0">
                <span class="material-icons text-xl text-fg-muted">dns</span>
                <div class="flex items-center gap-1.5 flex-wrap">
                    <a href="/" class="text-accent-fg hover:underline text-lg font-semibold">bots</a>
                    <span class="text-fg-muted text-lg">/</span>
                    <h2 class="bot-title text-lg font-bold text-fg-default font-mono truncate"><%= botConfig.name %></h2>
                    <span class="px-2 py-0.5 text-[11px] font-mono text-fg-muted bg-canvas-subtle border border-ghborder-default rounded-pill">#<%= botId %></span>
                    <% if (botConfig.autoStart) { %>
                    <span class="px-2 py-0.5 text-[10px] font-mono bg-accent-subtle text-accent-fg border border-accent-muted rounded-pill">auto-start</span>
                    <% } %>
                </div>
            </div>

            <!-- Header Quick Action Buttons -->
            <div class="flex items-center gap-2 self-end sm:self-auto">
                <button id="start-stop-btn" onclick="toggleStartStop()" class="px-3 py-1.5 <%= status.isRunning ? 'bg-danger-emphasis hover:bg-danger-fg border-danger-emphasis' : 'bg-success-emphasis hover:bg-success-fg border-success-emphasis' %> text-white rounded-md text-xs font-semibold flex items-center gap-1.5 transition-colors shadow-sm">
                    <span id="start-stop-icon" class="material-icons text-sm"><%= status.isRunning ? 'stop' : 'play_arrow' %></span>
                    <span id="start-stop-text"><%= status.isRunning ? 'Stop Bot' : 'Start Bot' %></span>
                </button>
                <button onclick="controlBot('restart')" class="px-3 py-1.5 bg-canvas-subtle hover:bg-canvas-default text-fg-default border border-ghborder-default hover:border-ghborder-strong rounded-md text-xs font-medium flex items-center gap-1 transition-colors">
                    <span class="material-icons text-sm text-fg-muted">refresh</span>
                    <span>Restart</span>
                </button>
                <a href="/bot/<%= botId %>/settings" class="p-1.5 bg-canvas-subtle hover:bg-canvas-default text-fg-muted hover:text-fg-default border border-ghborder-default rounded-md transition-colors" title="Settings">
                    <span class="material-icons text-base">settings</span>
                </a>
            </div>
        </div>

        <!-- Repository Status Indicator Sub-header -->
        <div class="flex items-center gap-2 text-xs text-fg-muted font-mono">
            <span id="status-dot" class="w-2 h-2 rounded-full <%= status.online ? 'bg-success-fg' : 'bg-danger-fg' %>"></span>
            <span id="status-text" class="font-semibold text-fg-default"><%= status.online ? 'Online' : 'Offline' %></span>
            <span>•</span>
            <span class="truncate"><%= typeof status.server !== 'undefined' ? status.server.ip + ':' + status.server.port : 'No server configured' %></span>
        </div>

        <!-- GitHub Horizontal Navigation Tabs -->
        <nav class="flex w-full min-w-0 items-center gap-1 overflow-x-auto border-b border-ghborder-default pt-2" aria-label="Bot workspace tabs">
            <a href="/bot/<%= botId %>" aria-current="<%= section === 'console' ? 'page' : 'false' %>" class="px-3 py-2 text-xs font-semibold flex items-center gap-1.5 border-b-2 <%= section === 'console' ? 'border-accent-fg text-fg-default' : 'border-transparent text-fg-muted hover:text-fg-default hover:border-ghborder-muted' %> transition-colors">
                <span class="material-icons text-base">terminal</span> Console
            </a>
            <a href="/bot/<%= botId %>/config" aria-current="<%= section === 'config' ? 'page' : 'false' %>" class="px-3 py-2 text-xs font-semibold flex items-center gap-1.5 border-b-2 <%= section === 'config' ? 'border-accent-fg text-fg-default' : 'border-transparent text-fg-muted hover:text-fg-default hover:border-ghborder-muted' %> transition-colors">
                <span class="material-icons text-base">tune</span> Config
            </a>
            <a href="/bot/<%= botId %>/analytics" aria-current="<%= section === 'analytics' ? 'page' : 'false' %>" class="px-3 py-2 text-xs font-semibold flex items-center gap-1.5 border-b-2 <%= section === 'analytics' ? 'border-accent-fg text-fg-default' : 'border-transparent text-fg-muted hover:text-fg-default hover:border-ghborder-muted' %> transition-colors">
                <span class="material-icons text-base">insights</span> Analytics
            </a>
            <a href="/bot/<%= botId %>/events" aria-current="<%= section === 'events' ? 'page' : 'false' %>" class="px-3 py-2 text-xs font-semibold flex items-center gap-1.5 border-b-2 <%= section === 'events' ? 'border-accent-fg text-fg-default' : 'border-transparent text-fg-muted hover:text-fg-default hover:border-ghborder-muted' %> transition-colors">
                <span class="material-icons text-base">history</span> Events
            </a>
            <a href="/bot/<%= botId %>/game" aria-current="<%= section === 'game' ? 'page' : 'false' %>" class="px-3 py-2 text-xs font-semibold flex items-center gap-1.5 border-b-2 <%= section === 'game' ? 'border-accent-fg text-fg-default' : 'border-transparent text-fg-muted hover:text-fg-default hover:border-ghborder-muted' %> transition-colors">
                <span class="material-icons text-base">sports_esports</span> In-Game
            </a>
            <a href="/bot/<%= botId %>/settings" aria-current="<%= section === 'settings' ? 'page' : 'false' %>" class="px-3 py-2 text-xs font-semibold flex items-center gap-1.5 border-b-2 <%= section === 'settings' ? 'border-accent-fg text-fg-default' : 'border-transparent text-fg-muted hover:text-fg-default hover:border-ghborder-muted' %> transition-colors">
                <span class="material-icons text-base">settings</span> Settings
            </a>
        </nav>
    </header>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 flex-1 min-h-0">
        <!-- Main Column: Terminal Console & Telemetry HUD -->
        <div class="<%= section === 'console' ? 'lg:col-span-3' : 'hidden' %> flex flex-col gap-5">
            <!-- Controls Box -->
            <div class="bg-canvas-default border border-ghborder-default rounded-md p-4 shadow-sm">
                <div class="flex flex-wrap gap-3">
                    <!-- AFK Toggle Button -->
                    <button id="afk-btn" onclick="toggleAfk()" class="px-3.5 py-1.5 rounded-md text-xs font-semibold flex items-center gap-2 border transition-colors <%= status.isAfkActive ? 'bg-success-subtle text-success-fg border-success-subtle' : 'bg-canvas-subtle text-fg-default border-ghborder-default hover:bg-canvas-default' %>">
                        <span class="w-2 h-2 rounded-full <%= status.isAfkActive ? 'bg-success-fg' : 'bg-fg-muted' %>"></span>
                        <span><%= status.isAfkActive ? 'Stop AFK' : 'Start AFK Routine' %></span>
                    </button>

                    <!-- AFK Profile Selector -->
                    <div class="flex items-center gap-2 flex-1 min-w-[200px]">
                        <label class="text-xs font-medium text-fg-muted whitespace-nowrap">AFK Profile:</label>
                        <select id="afk-profile-select" onchange="setAfkProfile(this.value)" class="flex-1 bg-canvas-default border border-ghborder-default rounded-md px-2.5 py-1.5 text-xs font-mono text-fg-default outline-none focus:border-accent-fg">
                            <option value="random_look" <%= (status.afkProfile === 'random_look' || !status.afkProfile) ? 'selected' : '' %>>Random Look (Default)</option>
                            <option value="spin" <%= status.afkProfile === 'spin' ? 'selected' : '' %>>Spin 360°</option>
                            <option value="jump_spam" <%= status.afkProfile === 'jump_spam' ? 'selected' : '' %>>Jump Spam</option>
                            <option value="circle_walk" <%= status.afkProfile === 'circle_walk' ? 'selected' : '' %>>Circle Walk</option>
                        </select>
                    </div>
                </div>

                <!-- Status Metrics Cards -->
                <div class="grid grid-cols-3 gap-3 mt-4 pt-4 border-t border-ghborder-muted">
                    <div class="p-3 bg-canvas-subtle rounded-md border border-ghborder-muted text-center">
                        <div class="text-[10px] font-mono text-fg-muted uppercase">Session Uptime</div>
                        <div id="uptime-text" class="font-mono text-sm font-semibold text-fg-default mt-0.5"><%= status.uptime || '0s' %></div>
                    </div>
                    <div class="p-3 bg-canvas-subtle rounded-md border border-ghborder-muted text-center">
                        <div class="text-[10px] font-mono text-fg-muted uppercase">Auth Status</div>
                        <div class="flex items-center justify-center mt-1">
                            <span id="auth-status" class="font-mono text-xs uppercase px-2 py-0.5 border rounded-pill font-semibold <%= status.authStatus === 'Verified' ? 'text-success-fg border-success-subtle bg-success-subtle' : (status.authStatus === 'Pending' ? 'text-attention-fg border-attention-subtle bg-attention-subtle animate-pulse' : 'text-fg-muted border-ghborder-default bg-canvas-default') %>">
                                <%= status.authStatus || 'Offline' %>
                            </span>
                        </div>
                    </div>
                    <div class="p-3 bg-canvas-subtle rounded-md border border-ghborder-muted text-center">
                        <div class="text-[10px] font-mono text-fg-muted uppercase">Total Uptime</div>
                        <div id="total-uptime" class="font-mono text-sm font-semibold text-fg-default mt-0.5"><%= Math.floor((status.totalUptime || 0) / 3600) %>h <%= Math.floor(((status.totalUptime || 0) % 3600) / 60) %>m</div>
                    </div>
                </div>

                <!-- Entity Health/Food Progress Bars -->
                <div class="mt-4 pt-4 border-t border-ghborder-muted">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-3 mb-3">
                        <div class="bg-canvas-subtle p-3 rounded-md border border-ghborder-muted">
                            <div class="flex items-center justify-between mb-1 text-xs">
                                <span class="font-medium text-fg-muted flex items-center gap-1"><span class="text-danger-fg">❤</span> Health</span>
                                <span id="detail-health" class="font-mono font-bold text-danger-fg">-</span>
                            </div>
                            <div class="w-full bg-canvas-default rounded-full h-2 overflow-hidden border border-ghborder-muted">
                                <div id="health-bar" class="h-full bg-danger-fg transition-all duration-500" style="width: 0%"></div>
                            </div>
                        </div>
                        <div class="bg-canvas-subtle p-3 rounded-md border border-ghborder-muted">
                            <div class="flex items-center justify-between mb-1 text-xs">
                                <span class="font-medium text-fg-muted flex items-center gap-1"><span class="text-attention-fg">🍗</span> Food</span>
                                <span id="detail-food" class="font-mono font-bold text-success-fg">-</span>
                            </div>
                            <div class="w-full bg-canvas-default rounded-full h-2 overflow-hidden border border-ghborder-muted">
                                <div id="food-bar" class="h-full bg-success-fg transition-all duration-500" style="width: 0%"></div>
                            </div>
                        </div>
                    </div>
                    <div class="grid grid-cols-2 md:grid-cols-3 gap-3 text-xs">
                        <div class="bg-canvas-subtle p-2.5 rounded-md border border-ghborder-muted text-center">
                            <span class="text-fg-muted text-[10px] block">Entity Name</span>
                            <span id="detail-username" class="font-mono font-semibold text-fg-default truncate block"><%= (status.username && status.username !== 'N/A') ? status.username : '-' %></span>
                        </div>
                        <div class="bg-canvas-subtle p-2.5 rounded-md border border-ghborder-muted text-center">
                            <span class="text-fg-muted text-[10px] block">Position</span>
                            <span id="detail-position" class="font-mono font-semibold text-fg-default truncate block">-</span>
                        </div>
                        <div class="bg-canvas-subtle p-2.5 rounded-md border border-ghborder-muted text-center col-span-2 md:col-span-1">
                            <span class="text-fg-muted text-[10px] block">Dimension</span>
                            <span id="detail-dimension" class="font-mono font-semibold text-fg-default truncate block">-</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Terminal / Code Viewer Container (GitHub Monospace Console) -->
            <div class="bg-canvas-inset border border-ghborder-default rounded-md flex flex-col shadow-sm overflow-hidden">
                <div class="px-4 py-2 bg-canvas-subtle border-b border-ghborder-default flex justify-between items-center select-none gap-2">
                    <div class="flex items-center gap-2">
                        <span class="w-2.5 h-2.5 rounded-full bg-success-fg inline-block"></span>
                        <span class="text-xs font-mono font-semibold text-fg-default">terminal.log</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <input type="text" id="log-search-input" placeholder="Filter console output..." oninput="filterLogs(this.value)" class="bg-canvas-default border border-ghborder-default text-fg-default font-mono text-xs px-2 py-1 rounded focus:border-accent-fg outline-none w-36 transition-all focus:w-48 placeholder-fg-muted">
                        <button onclick="clearConsole()" class="text-[11px] font-mono px-2 py-1 text-fg-muted hover:text-fg-default border border-ghborder-default hover:border-ghborder-strong rounded transition-colors">
                            Clear
                        </button>
                    </div>
                </div>

                <div id="console-logs" class="h-[300px] p-4 overflow-y-auto font-mono text-xs space-y-1 bg-canvas-inset text-fg-default console-logs leading-relaxed">
                    <div class="console-placeholder text-fg-muted italic">Connecting to console stream...</div>
                </div>

                <div class="p-2.5 bg-canvas-subtle border-t border-ghborder-default">
                    <form onsubmit="sendCommand(event)" class="flex gap-2">
                        <div class="relative flex-1">
                            <span class="absolute left-2.5 top-2 font-mono text-xs text-accent-fg select-none">$</span>
                            <input type="text" id="command-input" class="w-full pl-6 pr-3 py-1.5 bg-canvas-default border border-ghborder-default rounded-md text-fg-default font-mono text-xs focus:border-accent-fg outline-none transition-colors" placeholder="Type command or message... (↑↓ for history)" autocomplete="off">
                        </div>
                        <button type="submit" class="px-4 py-1.5 bg-accent-emphasis hover:bg-accent-fg text-white font-semibold text-xs rounded-md transition-colors border border-accent-emphasis">
                            Send
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <!-- Panels for Config, Analytics, Events -->
        <div class="<%= section === 'console' ? 'hidden' : 'lg:col-span-3 max-w-4xl w-full mx-auto' %> flex flex-col gap-5">

            <!-- Config Tab Panel -->
            <div id="panel-config" class="<%= section === 'config' ? '' : 'hidden ' %>flex flex-col gap-4">
                <div class="bg-canvas-default p-5 border border-ghborder-default rounded-md shadow-sm">
                    <h3 class="text-sm font-semibold text-fg-default mb-4 border-b border-ghborder-muted pb-2">Bot Settings & Credentials</h3>

                    <form onsubmit="updateBotConfig(event)" class="space-y-4">
                        <div>
                            <label class="block text-xs font-semibold text-fg-default mb-1">Instance Label</label>
                            <input type="text" name="name" value="<%= botConfig.name %>" required class="w-full px-3 py-1.5 bg-canvas-default border border-ghborder-default rounded-md text-xs text-fg-default outline-none focus:border-accent-fg">
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-fg-default mb-1">Server Target IP</label>
                            <input type="text" name="ip" value="<%= typeof botConfig.server !== 'undefined' ? botConfig.server.ip : '' %>" required class="w-full px-3 py-1.5 bg-canvas-default border border-ghborder-default rounded-md text-xs font-mono text-fg-default outline-none focus:border-accent-fg">
                        </div>
                        <div class="grid grid-cols-2 gap-3">
                            <div>
                                <label class="block text-xs font-semibold text-fg-default mb-1">Port</label>
                                <input type="number" name="port" value="<%= typeof botConfig.server !== 'undefined' ? botConfig.server.port : '25565' %>" required class="w-full px-3 py-1.5 bg-canvas-default border border-ghborder-default rounded-md text-xs font-mono text-fg-default outline-none focus:border-accent-fg">
                            </div>
                            <div>
                                <label class="block text-xs font-semibold text-fg-default mb-1">Minecraft Version</label>
                                <input type="text" name="version" value="<%= typeof botConfig.server !== 'undefined' ? botConfig.server.version : '1.20.4' %>" required class="w-full px-3 py-1.5 bg-canvas-default border border-ghborder-default rounded-md text-xs font-mono text-fg-default outline-none focus:border-accent-fg">
                            </div>
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-fg-default mb-1">Microsoft Account Email</label>
                            <input type="email" name="email" value="<%= typeof botConfig.account !== 'undefined' ? botConfig.account.email : '' %>" required class="w-full px-3 py-1.5 bg-canvas-default border border-ghborder-default rounded-md text-xs text-fg-default outline-none focus:border-accent-fg">
                        </div>
                        <button type="submit" class="w-full bg-accent-emphasis hover:bg-accent-fg text-white font-semibold text-xs py-2 rounded-md transition-colors border border-accent-emphasis">
                            Save Bot Configuration
                        </button>
                    </form>
                </div>

                <!-- Automation & Webhook Controls -->
                <div class="bg-canvas-default p-5 border border-ghborder-default rounded-md shadow-sm space-y-4">
                    <h3 class="text-sm font-semibold text-fg-default border-b border-ghborder-muted pb-2">Automation & Webhooks</h3>

                    <div class="flex items-center justify-between">
                        <div>
                            <div class="text-xs font-semibold text-fg-default">Auto Eat Routine</div>
                            <div class="text-[11px] text-fg-muted">Automatically eat food items when hunger drops</div>
                        </div>
                        <button id="auto-eat-btn" onclick="toggleAutoEat()" class="relative w-10 h-5 transition-colors <%= botConfig.autoEat !== false ? 'bg-accent-emphasis' : 'bg-ghborder-strong' %> rounded-pill">
                            <span id="auto-eat-knob" class="absolute top-0.5 h-4 w-4 bg-white rounded-full transition-transform <%= botConfig.autoEat !== false ? 'translate-x-5' : 'translate-x-0.5' %>"></span>
                        </button>
                    </div>

                    <% if (user && user.role === 'admin') { %>
                    <div class="flex items-center justify-between">
                        <div>
                            <div class="text-xs font-semibold text-fg-default">Auto-Start on Boot</div>
                            <div class="text-[11px] text-fg-muted">Automatically connect bot instance when system starts</div>
                        </div>
                        <button id="auto-start-btn" onclick="toggleAutoStart()" class="relative w-10 h-5 transition-colors <%= botConfig.autoStart ? 'bg-accent-emphasis' : 'bg-ghborder-strong' %> rounded-pill">
                            <span id="auto-start-knob" class="absolute top-0.5 h-4 w-4 bg-white rounded-full transition-transform <%= botConfig.autoStart ? 'translate-x-5' : 'translate-x-0.5' %>"></span>
                        </button>
                    </div>
                    <% } %>

                    <div>
                        <label class="block text-xs font-semibold text-fg-default mb-1">Webhook URL (Discord/Slack)</label>
                        <div class="flex gap-2">
                            <input type="url" id="webhook-input" value="<%= botConfig.webhookUrl || '' %>" placeholder="https://discord.com/api/webhooks/..." class="flex-1 px-3 py-1.5 bg-canvas-default border border-ghborder-default rounded-md text-xs text-fg-default outline-none focus:border-accent-fg">
                            <button onclick="saveWebhook()" class="px-3 py-1.5 bg-accent-emphasis hover:bg-accent-fg text-white font-semibold text-xs rounded-md transition-colors">Save</button>
                        </div>
                    </div>

                    <div>
                        <label class="block text-xs font-semibold text-fg-default mb-1">Login Commands (One per line)</label>
                        <textarea id="login-commands-input" rows="3" placeholder="/login mypassword&#10;/kit starter" class="w-full px-3 py-2 bg-canvas-default border border-ghborder-default rounded-md text-xs font-mono text-fg-default outline-none focus:border-accent-fg resize-none"><%= (botConfig.loginCommands || []).join('\n') %></textarea>
                        <button onclick="saveLoginCommands()" class="mt-2 w-full bg-canvas-subtle hover:bg-canvas-default text-fg-default font-semibold text-xs py-1.5 rounded-md border border-ghborder-default transition-colors">Save Commands</button>
                    </div>
                </div>
            </div>

            <!-- Analytics Tab Panel -->
            <div id="panel-analytics" class="<%= section === 'analytics' ? '' : 'hidden ' %>flex flex-col gap-4">
                <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
                    <div class="bg-canvas-default p-4 border border-ghborder-default rounded-md">
                        <div class="text-[11px] font-mono uppercase text-fg-muted">CPU usage</div>
                        <div id="runtime-cpu-current" class="mt-1 text-lg font-mono font-bold text-accent-fg">--%</div>
                    </div>
                    <div class="bg-canvas-default p-4 border border-ghborder-default rounded-md">
                        <div class="text-[11px] font-mono uppercase text-fg-muted">RAM usage</div>
                        <div id="runtime-memory-current" class="mt-1 text-lg font-mono font-bold text-success-fg">-- MB</div>
                    </div>
                    <div class="bg-canvas-default p-4 border border-ghborder-default rounded-md col-span-2">
                        <div class="text-[11px] font-mono uppercase text-fg-muted">Process Scope</div>
                        <div class="mt-1 text-xs font-semibold text-fg-default">Shared Node Bot Instance</div>
                    </div>
                </div>

                <div class="bg-canvas-default p-5 border border-ghborder-default rounded-md shadow-sm">
                    <h3 class="text-sm font-semibold text-fg-default mb-4 border-b border-ghborder-muted pb-2">Resource Metrics History</h3>
                    <div class="h-52 relative">
                        <canvas id="runtime-chart"></canvas>
                        <div id="runtime-empty" class="absolute inset-0 flex items-center justify-center text-fg-muted text-xs font-mono hidden">No metrics collected yet.</div>
                    </div>
                </div>

                <div class="bg-canvas-default p-5 border border-ghborder-default rounded-md shadow-sm">
                    <div class="flex items-center justify-between mb-4 border-b border-ghborder-muted pb-2">
                        <h3 class="text-sm font-semibold text-fg-default">Health & Food History</h3>
                        <select id="metrics-hours" onchange="loadMetrics()" class="bg-canvas-default border border-ghborder-default rounded px-2 py-1 text-xs font-mono text-fg-default outline-none">
                            <option value="6">6h</option>
                            <option value="24" selected>24h</option>
                            <option value="72">3d</option>
                        </select>
                    </div>
                    <div class="h-48 relative">
                        <canvas id="metrics-chart"></canvas>
                        <div id="metrics-empty" class="absolute inset-0 flex items-center justify-center text-fg-muted text-xs font-mono hidden">No metric records found.</div>
                    </div>
                </div>
            </div>

            <!-- Events Tab Panel -->
            <div id="panel-events" class="<%= section === 'events' ? '' : 'hidden ' %>flex flex-col gap-4">
                <div class="bg-canvas-default p-5 border border-ghborder-default rounded-md shadow-sm">
                    <div class="flex items-center justify-between mb-4 border-b border-ghborder-muted pb-2">
                        <h3 class="text-sm font-semibold text-fg-default">Event Activity Feed</h3>
                        <button onclick="loadEvents()" class="text-xs text-accent-fg hover:underline font-semibold">Refresh</button>
                    </div>
                    <div id="event-timeline" class="space-y-2 max-h-96 overflow-y-auto">
                        <div class="text-fg-muted text-xs font-mono italic">Loading events...</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>

<!-- Microsoft Auth Modal Dialog -->
<div id="auth-modal" class="fixed inset-0 z-50 flex items-center justify-center bg-black/60 backdrop-blur-xs hidden opacity-0 transition-opacity duration-150">
    <div class="bg-canvas-default border border-ghborder-default rounded-lg p-6 w-full max-w-md mx-4 shadow-2xl transform scale-95 transition-transform duration-150" id="auth-modal-content">
        <div class="text-center mb-4">
            <div class="w-10 h-10 bg-accent-subtle text-accent-fg rounded-full mx-auto flex items-center justify-center mb-2">
                <span class="material-icons text-xl">vpn_key</span>
            </div>
            <h3 class="text-sm font-semibold text-fg-default">Microsoft Authentication Required</h3>
            <p class="text-fg-muted text-xs mt-1">Authenticate your Minecraft account using the code below.</p>
        </div>
        <div class="bg-canvas-subtle p-3 mb-4 rounded-md border border-ghborder-default text-center">
            <span class="block text-[10px] font-mono text-fg-muted uppercase mb-1">One-Time Code</span>
            <div class="flex items-center justify-center gap-2">
                <code id="auth-code" class="text-lg font-mono font-bold text-accent-fg tracking-widest"></code>
                <button id="copy-code-btn" onclick="copyCode()" class="p-1 text-fg-muted hover:text-fg-default rounded hover:bg-canvas-default transition-colors" title="Copy Code">
                    <span class="material-icons text-sm">content_copy</span>
                </button>
            </div>
        </div>
        <a id="auth-link" href="#" target="_blank" class="block w-full bg-accent-emphasis hover:bg-accent-fg text-white text-center text-xs font-semibold py-2 rounded-md mb-2 transition-colors">
            Open Microsoft Verification Page →
        </a>
        <button onclick="closeAuthModal()" class="w-full text-xs text-fg-muted hover:text-fg-default py-1.5">
            Close Dialog
        </button>
    </div>
</div>

<script>
// Command History
let cmdHistory = [];
let cmdHistoryIdx = -1;
const cmdInput = document.getElementById('command-input');
if (cmdInput) {
    cmdInput.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowUp') {
            e.preventDefault();
            if (cmdHistory.length === 0) return;
            cmdHistoryIdx = Math.min(cmdHistoryIdx + 1, cmdHistory.length - 1);
            cmdInput.value = cmdHistory[cmdHistoryIdx];
        } else if (e.key === 'ArrowDown') {
            e.preventDefault();
            if (cmdHistoryIdx <= 0) { cmdHistoryIdx = -1; cmdInput.value = ''; return; }
            cmdHistoryIdx--;
            cmdInput.value = cmdHistory[cmdHistoryIdx];
        }
    });
}

function filterLogs(keyword) {
    const logs = document.querySelectorAll('#console-logs > div');
    const kw = (keyword || '').toLowerCase();
    logs.forEach(el => {
        if (!kw || el.textContent.toLowerCase().includes(kw)) {
            el.style.display = '';
        } else {
            el.style.display = 'none';
        }
    });
}

async function setAfkProfile(profile) {
    const res = await fetch(`/api/bot/${BOT_ID}/afk-profile`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ profile })
    });
    const data = await res.json();
    if (data.success) showToast(`AFK profile set to: ${profile}`, 'success');
    else showToast(data.error || 'Failed to set AFK profile', 'error');
}

let autoEatEnabled = <%= botConfig.autoEat !== false ? 'true' : 'false' %>;
async function toggleAutoEat() {
    autoEatEnabled = !autoEatEnabled;
    const btn = document.getElementById('auto-eat-btn');
    const knob = document.getElementById('auto-eat-knob');
    if (btn && knob) {
        btn.className = `relative w-10 h-5 transition-colors ${autoEatEnabled ? 'bg-accent-emphasis' : 'bg-ghborder-strong'} rounded-pill`;
        knob.className = `absolute top-0.5 h-4 w-4 bg-white rounded-full transition-transform ${autoEatEnabled ? 'translate-x-5' : 'translate-x-0.5'}`;
    }
    const res = await fetch(`/api/bot/${BOT_ID}/auto-eat`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ enabled: autoEatEnabled })
    });
    const data = await res.json();
    if (!data.success) showToast(data.error || 'Failed', 'error');
    else showToast(`Auto-eat ${autoEatEnabled ? 'enabled' : 'disabled'}`, 'success');
}

let autoStartEnabled = <%= botConfig.autoStart ? 'true' : 'false' %>;
async function toggleAutoStart() {
    autoStartEnabled = !autoStartEnabled;
    const btn = document.getElementById('auto-start-btn');
    const knob = document.getElementById('auto-start-knob');
    if (btn && knob) {
        btn.className = `relative w-10 h-5 transition-colors ${autoStartEnabled ? 'bg-accent-emphasis' : 'bg-ghborder-strong'} rounded-pill`;
        knob.className = `absolute top-0.5 h-4 w-4 bg-white rounded-full transition-transform ${autoStartEnabled ? 'translate-x-5' : 'translate-x-0.5'}`;
    }
    const res = await fetch(`/api/bot/${BOT_ID}/auto-start`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ enabled: autoStartEnabled })
    });
    const data = await res.json();
    if (!data.success) showToast(data.error || 'Failed', 'error');
    else showToast(`Auto-start ${autoStartEnabled ? 'enabled' : 'disabled'}`, 'success');
}

async function saveWebhook() {
    const webhookUrl = document.getElementById('webhook-input').value;
    const res = await fetch(`/api/bot/${BOT_ID}/webhook`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ webhookUrl })
    });
    const data = await res.json();
    if (data.success) showToast('Webhook URL saved!', 'success');
    else showToast(data.error || 'Failed to save webhook', 'error');
}

async function saveLoginCommands() {
    const raw = document.getElementById('login-commands-input').value;
    const commands = raw.split('\n').map(c => c.trim()).filter(Boolean);
    const res = await fetch(`/api/bot/${BOT_ID}/login-commands`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ commands })
    });
    const data = await res.json();
    if (data.success) showToast(`Saved ${commands.length} login command(s)`, 'success');
    else showToast(data.error || 'Failed', 'error');
}

let metricsChart = null;
let runtimeChart = null;
async function loadMetrics() {
    const hours = document.getElementById('metrics-hours')?.value || 24;
    const res = await fetch(`/api/bot/${BOT_ID}/metrics?hours=${hours}`);
    const data = await res.json();
    const empty = document.getElementById('metrics-empty');
    if (!data.success || data.metrics.length === 0) {
        if (empty) empty.classList.remove('hidden');
        return;
    }
    if (empty) empty.classList.add('hidden');
    const latestMetric = data.metrics[data.metrics.length - 1];
    const cpuCurrent = document.getElementById('runtime-cpu-current');
    const memoryCurrent = document.getElementById('runtime-memory-current');
    if (cpuCurrent) cpuCurrent.textContent = `${Number(latestMetric.cpu || 0).toFixed(1)}%`;
    if (memoryCurrent) memoryCurrent.textContent = `${Number(latestMetric.memory || 0).toFixed(1)} MB`;
    const labels = data.metrics.map(m => new Date(m.timestamp).toLocaleTimeString([], {hour:'2-digit',minute:'2-digit'}));

    const ctx = document.getElementById('metrics-chart')?.getContext('2d');
    if (ctx) {
        if (metricsChart) metricsChart.destroy();
        metricsChart = new Chart(ctx, {
            type: 'line',
            data: {
                labels,
                datasets: [
                    { label: 'Health', data: data.metrics.map(m => m.health), borderColor: '#cf222e', backgroundColor: 'rgba(207,34,46,0.1)', tension: 0.3, fill: true, pointRadius: 1 },
                    { label: 'Food', data: data.metrics.map(m => m.food), borderColor: '#1a7f37', backgroundColor: 'rgba(26,127,55,0.1)', tension: 0.3, fill: true, pointRadius: 1 }
                ]
            },
            options: {
                responsive: true, maintainAspectRatio: false,
                plugins: { legend: { labels: { color: '#8b949e', font: { size: 10 } } } },
                scales: {
                    x: { ticks: { color: '#6e7681', font: { size: 9 }, maxTicksLimit: 8 }, grid: { color: 'rgba(110,118,129,0.1)' } },
                    y: { min: 0, max: 20, ticks: { color: '#6e7681', font: { size: 9 } }, grid: { color: 'rgba(110,118,129,0.1)' } }
                }
            }
        });
    }
}

async function loadEvents() {
    const res = await fetch(`/api/bot/${BOT_ID}/events?limit=50`);
    const data = await res.json();
    const container = document.getElementById('event-timeline');
    if (!data.success || data.events.length === 0) {
        container.innerHTML = '<div class="text-fg-muted text-xs font-mono italic">No events recorded yet.</div>';
        return;
    }
    container.innerHTML = [...data.events].reverse().map(ev => {
        const ts = new Date(ev.timestamp).toLocaleString();
        return `<div class="flex items-start gap-2 py-1.5 border-b border-ghborder-muted last:border-0 text-xs">
            <span class="font-mono text-accent-fg font-semibold uppercase">${ev.event}</span>
            <span class="text-fg-muted text-[10px]">${ts}</span>
            ${ev.details ? `<span class="text-fg-default truncate">${ev.details}</span>` : ''}
        </div>`;
    }).join('');
}

if (BOT_SECTION === 'analytics') loadMetrics();
if (BOT_SECTION === 'events') loadEvents();
</script>

