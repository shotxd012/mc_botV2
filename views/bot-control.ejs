// ===== Health/Food Chart =====
let metricsChart = null;
let runtimeChart = null;
async function loadMetrics() {
    const hours = document.getElementById('metrics-hours')?.value || 24;
    const res = await fetch(`/api/bot/${BOT_ID}/metrics?hours=${hours}`);
    const data = await res.json();
    const empty = document.getElementById('metrics-empty');
    if (!data.success || data.metrics.length === 0) {
        if (empty) empty.classList.remove('hidden');
        return;
    }
    if (empty) empty.classList.add('hidden');
    const latestMetric = data.metrics[data.metrics.length - 1];
    const cpuCurrent = document.getElementById('runtime-cpu-current');
    const memoryCurrent = document.getElementById('runtime-memory-current');
    if (cpuCurrent) cpuCurrent.textContent = `${Number(latestMetric.cpu || 0).toFixed(1)}%`;
    if (memoryCurrent) memoryCurrent.textContent = `${Number(latestMetric.memory || 0).toFixed(1)} MB`;
    const labels = data.metrics.map(m => new Date(m.timestamp).toLocaleTimeString([], {hour:'2-digit',minute:'2-digit'}));
    const healthData = data.metrics.map(m => m.health);
    const foodData = data.metrics.map(m => m.food);

    const ctx = document.getElementById('metrics-chart').getContext('2d');
    if (metricsChart) metricsChart.destroy();
    metricsChart = new Chart(ctx, {
        type: 'line',
        data: {
            labels,
            datasets: [
                { label: 'Health', data: healthData, borderColor: '#ef4444', backgroundColor: 'rgba(239,68,68,0.1)', tension: 0.4, fill: true, pointRadius: 1 },
                { label: 'Food', data: foodData, borderColor: '#10b981', backgroundColor: 'rgba(16,185,129,0.1)', tension: 0.4, fill: true, pointRadius: 1 }
            ]
        },
        options: {
            responsive: true, maintainAspectRatio: false,
            plugins: { legend: { labels: { color: '#94a3b8', font: { size: 10 } } } },
            scales: {
                x: { ticks: { color: '#64748b', font: { size: 9 }, maxTicksLimit: 8 }, grid: { color: 'rgba(100,116,139,0.1)' } },
                y: { min: 0, max: 20, ticks: { color: '#64748b', font: { size: 9 } }, grid: { color: 'rgba(100,116,139,0.1)' } }
            }
        }
    });

    const runtimeEmpty = document.getElementById('runtime-empty');
    if (runtimeEmpty) runtimeEmpty.classList.add('hidden');
    const runtimeCtx = document.getElementById('runtime-chart')?.getContext('2d');
    if (runtimeCtx) {
        if (runtimeChart) runtimeChart.destroy();
        runtimeChart = new Chart(runtimeCtx, {
            type: 'line',
            data: {
                labels,
                datasets: [
                    { label: 'CPU %', data: data.metrics.map(m => Number(m.cpu || 0)), borderColor: '#3b82f6', backgroundColor: 'rgba(59,130,246,0.1)', yAxisID: 'cpu', tension: 0.35, fill: true, pointRadius: 1 },
                    { label: 'RAM MB', data: data.metrics.map(m => Number(m.memory || 0)), borderColor: '#10b981', backgroundColor: 'rgba(16,185,129,0.1)', yAxisID: 'memory', tension: 0.35, fill: true, pointRadius: 1 }
                ]
            },
            options: {
                responsive: true, maintainAspectRatio: false,
                interaction: { mode: 'index', intersect: false },
                plugins: { legend: { labels: { color: '#94a3b8', font: { size: 10 } } } },
                scales: {
                    x: { ticks: { color: '#64748b', font: { size: 9 }, maxTicksLimit: 8 }, grid: { color: 'rgba(100,116,139,0.1)' } },
                    cpu: { position: 'left', beginAtZero: true, ticks: { color: '#60a5fa', font: { size: 9 } }, grid: { color: 'rgba(100,116,139,0.1)' } },
                    memory: { position: 'right', beginAtZero: true, ticks: { color: '#34d399', font: { size: 9 } }, grid: { drawOnChartArea: false } }
                }
            }
        });
    }
}

// ===== Log Search =====
async function searchLogs() {
    const keyword = document.getElementById('search-keyword').value;
    const type = document.getElementById('search-type').value;
    const params = new URLSearchParams({ limit: 100 });
    if (keyword) params.set('keyword', keyword);
    if (type) params.set('type', type);
    const res = await fetch(`/api/bot/${BOT_ID}/history/search?${params}`);
    const data = await res.json();
    const container = document.getElementById('search-results');
    if (!data.success || data.logs.length === 0) {
        container.innerHTML = '<div class="text-slate-500 italic">No results found.</div>';
        return;
    }
    const typeColors = { error: 'text-redstone-400', warning: 'text-amber-400', chat: 'text-emerald-400', info: 'text-slate-300', action: 'text-primary', output: 'text-blue-400' };
    container.innerHTML = data.logs.map(l => {
        const color = typeColors[l.type] || 'text-slate-300';
        const ts = new Date(l.timestamp).toLocaleTimeString();
        return `<div class="${color}">[${ts}] ${escapeHtml(l.message)}</div>`;
    }).join('');
}
function escapeHtml(t) { return t.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }

// ===== Event Timeline =====
const eventIcons = { login:'login', kicked:'block', disconnect:'wifi_off', reconnect:'wifi', afk_start:'bedtime', afk_stop:'wb_sunny', spawn:'person_pin', error:'error' };
const eventColors = { login:'text-emerald-400', kicked:'text-redstone-400', disconnect:'text-amber-400', reconnect:'text-blue-400', afk_start:'text-purple-400', afk_stop:'text-slate-400', spawn:'text-primary', error:'text-redstone-500' };
async function loadEvents() {
    const res = await fetch(`/api/bot/${BOT_ID}/events?limit=50`);
    const data = await res.json();
    const container = document.getElementById('event-timeline');
    if (!data.success || data.events.length === 0) {
        container.innerHTML = '<div class="text-slate-400 text-xs font-mono italic">No events recorded yet.</div>';
        return;
    }
    container.innerHTML = [...data.events].reverse().map(ev => {
        const icon = eventIcons[ev.event] || 'info';
        const color = eventColors[ev.event] || 'text-slate-300';
        const ts = new Date(ev.timestamp).toLocaleString();
        return `<div class="flex items-start gap-2 py-1.5 border-b border-slate-100 dark:border-obsidian-800 last:border-0">
            <span class="material-icons text-sm ${color} flex-shrink-0 mt-0.5">${icon}</span>
            <div class="min-w-0">
                <div class="flex items-center gap-2">
                    <span class="text-[10px] font-mono uppercase font-bold ${color}">${ev.event}</span>
                    <span class="text-[9px] text-slate-400 font-mono">${ts}</span>
                </div>
                ${ev.details ? `<div class="text-[10px] text-slate-500 truncate">${escapeHtml(ev.details)}</div>` : ''}
            </div>
        </div>`;
    }).join('');
}

// Listen for live events
if (typeof socket !== 'undefined') {
    socket.on('bot-event', (data) => {
        if (String(data.botId) !== String(BOT_ID)) return;
        // Refresh events panel if open
        const panel = document.getElementById('panel-events');
        if (panel && !panel.classList.contains('hidden')) loadEvents();
    });
}

// Update health/food bars on status update
function updateHealthFoodBars(status) {
    const health = parseFloat(status.health) || 0;
    const food = parseFloat(status.food) || 0;
    const healthEl = document.getElementById('detail-health');
    const foodEl = document.getElementById('detail-food');
    const healthBar = document.getElementById('health-bar');
    const foodBar = document.getElementById('food-bar');
    if (healthEl) healthEl.textContent = health + '/20';
    if (foodEl) foodEl.textContent = food + '/20';
    if (healthBar) healthBar.style.width = Math.min(100, (health / 20) * 100) + '%';
    if (foodBar) foodBar.style.width = Math.min(100, (food / 20) * 100) + '%';
}

if (BOT_SECTION === 'analytics') loadMetrics();
if (BOT_SECTION === 'events') loadEvents();
</script>

