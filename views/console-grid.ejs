<%- include('partials/header') %>
<%- include('partials/sidebar') %>

<main class="flex-1 p-4 sm:p-6 md:p-8 max-w-[1280px] w-full mx-auto min-h-full flex flex-col gap-6">
    <header class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 border-b border-ghborder-default pb-5">
        <div>
            <div class="flex items-center gap-3">
                <h1 class="text-xl sm:text-2xl font-semibold text-fg-default tracking-tight">Multi-Console Stream</h1>
                <span class="px-2 py-0.5 text-xs font-mono font-medium bg-canvas-subtle text-fg-muted border border-ghborder-default rounded-pill">
                    <%= bots.length %> <%= bots.length === 1 ? 'bot' : 'bots' %>
                </span>
            </div>
            <p class="text-fg-muted mt-1 text-xs sm:text-sm">Monitor your bot fleet terminals and jump directly into any active output stream.</p>
        </div>
        <span class="flex items-center gap-1.5 text-xs font-medium text-fg-muted">
            <span class="w-2 h-2 rounded-full bg-success-fg"></span>
            Live stream
        </span>
    </header>

    <% if (bots.length === 0) { %>
        <div class="border border-dashed border-ghborder-default bg-canvas-subtle p-10 text-center rounded-md">
            <span class="material-icons text-3xl text-fg-muted mb-2">terminal</span>
            <h3 class="text-sm font-semibold text-fg-default">No bot terminals available</h3>
            <p class="text-xs text-fg-muted mt-1">Create or assign a bot to populate the console grid.</p>
        </div>
    <% } else { %>
        <div class="grid grid-cols-1 xl:grid-cols-2 gap-4">
            <% bots.forEach(function(bot) { %>
                <article class="bg-canvas-default border border-ghborder-default rounded-md shadow-sm overflow-hidden flex flex-col">
                    <div class="flex items-center justify-between gap-3 px-4 py-2.5 bg-canvas-subtle border-b border-ghborder-default">
                        <div class="flex items-center gap-2.5 min-w-0">
                            <span class="w-2 h-2 rounded-full <%= bot.online ? 'bg-success-fg' : 'bg-fg-muted' %>"></span>
                            <div class="min-w-0">
                                <h3 class="text-xs font-semibold text-fg-default truncate"><%= bot.name || 'Unnamed Bot' %></h3>
                                <span class="text-[10px] font-mono text-fg-muted">#<%= bot.id %></span>
                            </div>
                        </div>
                        <span class="text-[10px] font-mono capitalize font-semibold px-2 py-0.5 rounded-pill border <%= bot.online ? 'bg-success-subtle text-success-fg border-success-subtle' : 'bg-canvas-default text-fg-muted border-ghborder-default' %>">
                            <%= bot.online ? 'Online' : 'Offline' %>
                        </span>
                    </div>

                    <div class="h-36 bg-canvas-inset p-3 font-mono text-xs text-fg-muted overflow-hidden flex flex-col justify-between">
                        <div class="flex items-center gap-2 text-fg-default">
                            <span class="text-accent-fg font-bold">$</span>
                            <span><%= bot.online ? 'Terminal stream active...' : 'Bot process is stopped' %></span>
                        </div>
                        <div class="space-y-1 text-[11px]">
                            <div><span class="text-fg-muted">Host:</span> <code class="text-fg-default"><%= bot.server ? bot.server.ip + ':' + bot.server.port : 'Not set' %></code></div>
                            <div><span class="text-fg-muted">Player:</span> <code class="text-fg-default"><%= bot.username && bot.username !== 'N/A' ? bot.username : 'Disconnected' %></code></div>
                        </div>
                    </div>

                    <div class="flex items-center justify-between gap-3 px-4 py-2.5 bg-canvas-subtle border-t border-ghborder-default">
                        <span class="text-[11px] font-mono text-fg-muted">Version: <%= bot.server ? bot.server.version : 'Auto' %></span>
                        <a href="/bot/<%= bot.id %>" class="inline-flex items-center gap-1 px-3 py-1 bg-accent-emphasis hover:bg-accent-fg text-white border border-accent-emphasis rounded-md text-xs font-medium transition-colors">
                            <span class="material-icons text-sm">terminal</span>
                            <span>Open Console</span>
                        </a>
                    </div>
                </article>
            <% }); %>
        </div>
    <% } %>
</main>

<%- include('partials/footer') %>
