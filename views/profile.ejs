<%- include('partials/header') %>
<%- include('partials/sidebar') %>

<main class="flex-1 p-4 sm:p-6 md:p-8 max-w-[1280px] w-full mx-auto min-h-full flex flex-col gap-6">
    <header class="border-b border-ghborder-default pb-5">
        <div class="flex items-center gap-2.5">
            <h1 class="text-xl sm:text-2xl font-semibold text-fg-default tracking-tight">Operator Profile</h1>
            <span class="px-2 py-0.5 text-xs font-mono font-medium bg-accent-subtle text-accent-fg border border-accent-muted rounded-pill">Active Session</span>
        </div>
        <p class="text-fg-muted mt-1 text-xs sm:text-sm">Account credentials, system privilege tier, and bot allocations.</p>
    </header>

    <div class="bg-canvas-default border border-ghborder-default rounded-md p-6 max-w-3xl shadow-sm">
        <div class="flex items-center gap-4 mb-6 border-b border-ghborder-muted pb-5">
            <div class="w-12 h-12 rounded-full bg-accent-emphasis text-white flex items-center justify-center font-mono font-bold text-lg flex-shrink-0">
                <%= user.username ? user.username.charAt(0).toUpperCase() : 'U' %>
            </div>
            <div>
                <h2 class="text-base font-bold text-fg-default font-mono"><%= user.username %></h2>
                <div class="flex items-center gap-2 mt-1">
                    <span class="px-2 py-0.5 text-[10px] font-mono font-medium uppercase rounded-pill border <%= user.role === 'admin' ? 'bg-danger-subtle text-danger-fg border-danger-subtle' : 'bg-accent-subtle text-accent-fg border-accent-muted' %>">
                        <%= typeof user.role !== 'undefined' && user.role ? user.role.toUpperCase() : 'USER' %>
                    </span>
                    <span class="text-xs text-fg-muted font-mono">Tier Authorization</span>
                </div>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div class="border border-ghborder-default bg-canvas-subtle p-4 rounded-md font-mono text-xs">
                <h3 class="font-semibold text-fg-default mb-3 border-b border-ghborder-muted pb-2">Account Registry</h3>
                <div class="space-y-2">
                    <div class="flex justify-between">
                        <span class="text-fg-muted">Operator IGN:</span>
                        <span class="font-bold text-fg-default"><%= user.username %></span>
                    </div>
                    <div class="flex justify-between">
                        <span class="text-fg-muted">Privilege:</span>
                        <span class="font-bold capitalize <%= user.role === 'admin' ? 'text-danger-fg' : 'text-accent-fg' %>"><%= typeof user.role !== 'undefined' && user.role ? user.role : 'user' %></span>
                    </div>
                    <div class="flex justify-between">
                        <span class="text-fg-muted">Member Since:</span>
                        <span class="text-fg-default"><%= new Date(user.createdAt).toLocaleDateString() %></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="mt-6 pt-6 border-t border-ghborder-muted">
            <h3 class="text-xs font-semibold text-fg-default uppercase tracking-wider mb-3">Account Access Matrix</h3>
            <div class="space-y-2 text-xs">
                <% if (isAdmin) { %>
                    <div class="flex items-center gap-2 text-fg-default">
                        <span class="material-icons text-sm text-success-fg">check_circle</span>
                        <span>Full permission: Create, reconfigure, and delete any bot instance</span>
                    </div>
                    <div class="flex items-center gap-2 text-fg-default">
                        <span class="material-icons text-sm text-success-fg">check_circle</span>
                        <span>Full control: Start, Stop, Restart, and AFK toggle across all bots</span>
                    </div>
                    <div class="flex items-center gap-2 text-fg-default">
                        <span class="material-icons text-sm text-success-fg">check_circle</span>
                        <span>Command dispatch: Interactive terminal access across all bots</span>
                    </div>
                <% } else { %>
                    <% if (assignedBots && assignedBots.length > 0) { %>
                        <div class="flex items-center gap-2 text-accent-fg mb-2">
                            <span class="material-icons text-sm text-accent-fg">info</span>
                            <span>Assigned Access: You have <%= assignedBots.length %> designated bot instance(s)</span>
                        </div>
                        <div class="flex items-center gap-2 text-fg-default">
                            <span class="material-icons text-sm text-success-fg">check_circle</span>
                            <span>Direct control: Start, Stop, and Restart assigned instances</span>
                        </div>
                        <div class="flex items-center gap-2 text-fg-default">
                            <span class="material-icons text-sm text-success-fg">check_circle</span>
                            <span>Console execution: Send in-game chat and slash commands</span>
                        </div>
                    <% } else { %>
                        <div class="flex items-center gap-2 text-attention-fg">
                            <span class="material-icons text-sm">warning</span>
                            <span>No bot instances currently assigned to your account</span>
                        </div>
                    <% } %>
                <% } %>
            </div>
        </div>

        <% if (!isAdmin && assignedBots && assignedBots.length > 0) { %>
        <div class="mt-6 pt-6 border-t border-ghborder-muted">
            <h3 class="text-xs font-semibold text-fg-default uppercase tracking-wider mb-3">Your Assigned Bot Units</h3>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                <% assignedBots.forEach(function(bot) { %>
                <a href="/bot/<%= bot.id %>" class="bg-canvas-subtle p-3 rounded-md border border-ghborder-default hover:border-accent-fg block transition-colors">
                    <div class="font-mono font-bold text-xs text-accent-fg"><%= bot.name %> <span class="text-fg-muted">#<%= bot.id %></span></div>
                    <div class="text-[11px] font-mono text-fg-muted mt-1">
                        <%= typeof bot.server !== 'undefined' ? bot.server.ip + ':' + bot.server.port : 'No server configured' %>
                    </div>
                </a>
                <% }); %>
            </div>
        </div>
        <% } %>
    </div>
</main>

<%- include('partials/footer') %>
