<%- include('partials/header') %>
<%- include('partials/sidebar') %>

<main class="flex-1 p-4 sm:p-6 md:p-8 min-h-screen pb-20 md:pb-8 flex flex-col gap-6">
    <header class="border-b border-slate-200 dark:border-obsidian-700/60 pb-5">
        <div class="flex items-center gap-2.5">
            <h1 class="text-xl sm:text-2xl font-bold uppercase tracking-tight text-slate-900 dark:text-white">Operator Profile</h1>
            <span class="px-2 py-0.5 text-[10px] font-mono font-bold uppercase bg-primary/10 text-primary border border-primary/20">Active Session</span>
        </div>
        <p class="text-slate-500 dark:text-slate-400 mt-1 text-xs sm:text-sm">Account credentials, system privilege tier, and bot allocations.</p>
    </header>

    <div class="bg-white dark:bg-obsidian-900 border border-slate-200 dark:border-obsidian-700 p-6 max-w-3xl shadow-sm">
        <div class="flex items-center gap-4 mb-6 border-b border-slate-200 dark:border-obsidian-700/60 pb-5">
            <div class="w-14 h-14 bg-primary/10 border-2 border-primary/30 flex items-center justify-center font-mono font-bold text-xl text-primary flex-shrink-0">
                <%= user.username ? user.username.charAt(0).toUpperCase() : 'U' %>
            </div>
            <div>
                <h2 class="text-lg font-bold uppercase font-mono text-slate-900 dark:text-white"><%= user.username %></h2>
                <div class="flex items-center gap-2 mt-1">
                    <span class="px-2 py-0.5 text-[10px] font-mono font-bold uppercase border <%= user.role === 'admin' ? 'bg-redstone-500/10 text-redstone-400 border-redstone-500/30' : 'bg-primary/10 text-primary border-primary/20' %>">
                        <%= typeof user.role !== 'undefined' && user.role ? user.role.toUpperCase() : 'USER' %>
                    </span>
                    <span class="text-xs font-mono text-slate-500">Tier Authorization</span>
                </div>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div class="border border-slate-200 dark:border-obsidian-800 bg-slate-50 dark:bg-obsidian-950 p-4 font-mono text-xs">
                <h3 class="font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-3 border-b border-slate-200 dark:border-obsidian-800 pb-2">Account Registry</h3>
                <div class="space-y-2.5">
                    <div class="flex justify-between">
                        <span class="text-slate-500">Operator IGN:</span>
                        <span class="font-bold text-slate-900 dark:text-white"><%= user.username %></span>
                    </div>
                    <div class="flex justify-between">
                        <span class="text-slate-500">Privilege:</span>
                        <span class="font-bold uppercase <%= user.role === 'admin' ? 'text-redstone-400' : 'text-primary' %>"><%= typeof user.role !== 'undefined' && user.role ? user.role : 'user' %></span>
                    </div>
                    <div class="flex justify-between">
                        <span class="text-slate-500">Member Since:</span>
                        <span class="text-slate-700 dark:text-slate-300"><%= new Date(user.createdAt).toLocaleDateString() %></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="mt-6 pt-6 border-t border-slate-200 dark:border-obsidian-700/60">
            <h3 class="font-mono text-xs uppercase font-bold tracking-wider text-slate-700 dark:text-slate-300 mb-4">Account Access Matrix</h3>
            <div class="space-y-2 font-mono text-xs">
                <% if (isAdmin) { %>
                    <div class="flex items-center gap-2.5 text-slate-700 dark:text-slate-300">
                        <span class="w-2 h-2 bg-emerald-500 inline-block flex-shrink-0"></span>
                        <span>Full permission: Create, reconfigure, and delete any bot instance</span>
                    </div>
                    <div class="flex items-center gap-2.5 text-slate-700 dark:text-slate-300">
                        <span class="w-2 h-2 bg-emerald-500 inline-block flex-shrink-0"></span>
                        <span>Full control: Start, Stop, Restart, and AFK toggle across all bots</span>
                    </div>
                    <div class="flex items-center gap-2.5 text-slate-700 dark:text-slate-300">
                        <span class="w-2 h-2 bg-emerald-500 inline-block flex-shrink-0"></span>
                        <span>Command dispatch: Interactive terminal access across all bots</span>
                    </div>
                    <div class="flex items-center gap-2.5 text-slate-700 dark:text-slate-300">
                        <span class="w-2 h-2 bg-emerald-500 inline-block flex-shrink-0"></span>
                        <span>User administration: Promote, demote, and assign bot quotas</span>
                    </div>
                    <div class="flex items-center gap-2.5 text-slate-700 dark:text-slate-300">
                        <span class="w-2 h-2 bg-emerald-500 inline-block flex-shrink-0"></span>
                        <span>Infrastructure: Configure and assign custom server connectivity profiles</span>
                    </div>
                <% } else { %>
                    <% if (assignedBots && assignedBots.length > 0) { %>
                        <div class="flex items-center gap-2.5 text-primary mb-3">
                            <span class="w-2 h-2 bg-primary inline-block flex-shrink-0"></span>
                            <span>Assigned Access: You have <%= assignedBots.length %> designated bot instance(s)</span>
                        </div>
                        <div class="flex items-center gap-2.5 text-slate-700 dark:text-slate-300">
                            <span class="w-2 h-2 bg-emerald-500 inline-block flex-shrink-0"></span>
                            <span>Direct control: Start, Stop, and Restart assigned instances</span>
                        </div>
                        <div class="flex items-center gap-2.5 text-slate-700 dark:text-slate-300">
                            <span class="w-2 h-2 bg-emerald-500 inline-block flex-shrink-0"></span>
                            <span>Automated AFK loop: Toggle AFK routines on assigned instances</span>
                        </div>
                        <div class="flex items-center gap-2.5 text-slate-700 dark:text-slate-300">
                            <span class="w-2 h-2 bg-emerald-500 inline-block flex-shrink-0"></span>
                            <span>Console execution: Send in-game chat and slash commands</span>
                        </div>
                        <div class="flex items-center gap-2.5 text-amber-500">
                            <span class="w-2 h-2 bg-amber-500 inline-block flex-shrink-0"></span>
                            <span>Restricted: Cannot provision or permanently delete bot instances</span>
                        </div>
                    <% } else { %>
                        <div class="flex items-center gap-2.5 text-amber-500">
                            <span class="w-2 h-2 bg-amber-500 inline-block flex-shrink-0"></span>
                            <span>No bot instances currently assigned to your account</span>
                        </div>
                        <div class="flex items-center gap-2.5 text-slate-500">
                            <span class="w-2 h-2 bg-slate-500 inline-block flex-shrink-0"></span>
                            <span>Contact a system administrator to request bot assignments</span>
                        </div>
                    <% } %>
                <% } %>
            </div>
        </div>

        <% if (!isAdmin && assignedBots && assignedBots.length > 0) { %>
        <div class="mt-6 pt-6 border-t border-slate-200 dark:border-obsidian-700/60">
            <h3 class="font-mono text-xs uppercase font-bold tracking-wider text-slate-700 dark:text-slate-300 mb-3">Your Assigned Bot Units</h3>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                <% assignedBots.forEach(function(bot) { %>
                <a href="/bot/<%= bot.id %>" class="bg-slate-50 dark:bg-obsidian-950 p-3.5 border border-slate-200 dark:border-obsidian-800 hover:border-primary block transition-colors">
                    <div class="font-mono font-bold text-xs text-slate-900 dark:text-white"><%= bot.name %> <span class="text-slate-500">#<%= bot.id %></span></div>
                    <div class="text-[11px] font-mono text-slate-500 mt-1">
                        <%= typeof bot.server !== 'undefined' ? bot.server.ip + ':' + bot.server.port : 'No server configured' %>
                    </div>
                </a>
                <% }); %>
            </div>
        </div>
        <% } %>
    </div>
</main>

<%- include('partials/footer') %>