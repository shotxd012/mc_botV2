<%- include('partials/header') %>
<%- include('partials/sidebar') %>

<main class="flex-1 p-4 sm:p-6 md:p-8 min-h-screen pb-20 md:pb-8 flex flex-col gap-6">
    <header class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 border-b border-slate-200 dark:border-obsidian-700/60 pb-5">
        <div class="flex items-center gap-3">
            <a href="/" class="p-2 bg-slate-100 dark:bg-obsidian-850 hover:bg-slate-200 dark:hover:bg-obsidian-800 text-slate-600 dark:text-slate-300 transition-colors border border-slate-200 dark:border-obsidian-700 flex items-center justify-center">
                <span class="material-icons text-base">arrow_back</span>
            </a>
            <div>
                <h2 class="text-xl md:text-2xl font-bold uppercase tracking-tight text-slate-900 dark:text-white">Security Verification</h2>
                <div class="text-xs font-mono text-slate-500 dark:text-slate-400 mt-1">
                    <span>Target Bot: <%= botConfig.name %></span>
                    <span>•</span>
                    <span>ID: #<%= botId %></span>
                </div>
            </div>
        </div>
    </header>

    <div class="max-w-md w-full bg-white dark:bg-obsidian-900 border-2 border-slate-300 dark:border-obsidian-700 p-6 shadow-xl">
        <div class="flex items-center gap-3 mb-4 border-b border-slate-200 dark:border-obsidian-700 pb-3">
            <div class="w-8 h-8 bg-amber-500/10 border border-amber-500/20 text-amber-500 flex items-center justify-center">
                <span class="material-icons text-lg">lock</span>
            </div>
            <div>
                <h3 class="text-xs font-mono uppercase font-bold text-slate-900 dark:text-white">Passkey Required</h3>
                <p class="text-[11px] text-slate-500 dark:text-slate-400">Access authorization gate</p>
            </div>
        </div>

        <p class="text-xs text-slate-600 dark:text-slate-400 mb-5 leading-relaxed">
            This bot is protected by a security passkey. Please enter the authorized passkey to unlock the control terminal.
        </p>

        <% if (error) { %>
            <div class="mb-4 text-xs font-mono text-redstone-400 bg-redstone-500/10 border-l-4 border-redstone-500 border border-redstone-500/20 p-3 flex items-center gap-2">
                <span class="material-icons text-sm">error</span>
                <span><%= error %></span>
            </div>
        <% } %>

        <form method="post" action="/bot/<%= botId %>/passkey" class="space-y-4">
            <div>
                <label class="block text-xs font-mono uppercase text-slate-500 dark:text-slate-400 mb-1.5 font-semibold">Instance Passkey</label>
                <input type="password" name="passkey" class="w-full px-3 py-2.5 bg-slate-50 dark:bg-obsidian-950 border border-slate-300 dark:border-obsidian-700 text-xs font-mono text-slate-900 dark:text-white outline-none focus:border-primary transition-colors" autocomplete="off" placeholder="Enter passkey..." required autofocus>
            </div>
            <button type="submit" class="w-full bg-primary hover:bg-primary-hover text-white font-mono text-xs uppercase font-bold tracking-wider py-2.5 transition-all border border-primary-hover shadow-sm active:translate-y-0.5">
                Unlock Bot Terminal ->
            </button>
        </form>
    </div>
</main>

<%- include('partials/footer') %>
