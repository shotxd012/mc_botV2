<%- include('partials/header') %>
<%- include('partials/sidebar') %>

<main class="flex-1 flex items-center justify-center p-4 min-h-[calc(100vh-64px)] bg-canvas-subtle">
    <div class="bg-canvas-default border border-ghborder-default rounded-lg shadow-lg w-full max-w-sm p-6 relative">
        <div class="text-center mb-6">
            <div class="w-10 h-10 bg-accent-subtle text-accent-fg rounded-full flex items-center justify-center mx-auto mb-2">
                <span class="material-icons text-xl">view_in_ar</span>
            </div>
            <h2 class="text-lg font-semibold text-fg-default">Sign in to CraftHub</h2>
            <p class="text-fg-muted text-xs mt-1">Control and automate your Minecraft bot instances</p>
        </div>

        <% if (error) { %>
            <div class="border border-danger-emphasis/30 bg-danger-subtle text-danger-fg rounded-md p-3 mb-4 text-xs flex items-center gap-2">
                <span class="material-icons text-sm">error</span>
                <span><%= error %></span>
            </div>
        <% } %>

        <form action="/login" method="POST" class="space-y-4">
            <div>
                <label class="block text-xs font-semibold text-fg-default mb-1">Username or Email</label>
                <input type="text" name="username" class="w-full px-3 py-1.5 bg-canvas-default border border-ghborder-default rounded-md text-xs text-fg-default outline-none focus:border-accent-fg focus:ring-1 focus:ring-accent-fg transition-all" placeholder="Username" required autocomplete="username">
            </div>
            <div>
                <label class="block text-xs font-semibold text-fg-default mb-1">Password</label>
                <input type="password" name="password" class="w-full px-3 py-1.5 bg-canvas-default border border-ghborder-default rounded-md text-xs text-fg-default outline-none focus:border-accent-fg focus:ring-1 focus:ring-accent-fg transition-all" placeholder="••••••••" required autocomplete="current-password">
            </div>
            <button type="submit" class="w-full bg-success-emphasis hover:bg-success-fg text-white font-semibold text-xs py-2 rounded-md transition-colors border border-success-emphasis shadow-sm mt-2">
                Sign in
            </button>
        </form>
        
        <div class="mt-6 pt-4 border-t border-ghborder-muted text-center text-xs text-fg-muted">
            <p>
                New to CraftHub?
                <a href="/register" class="text-accent-fg font-semibold hover:underline ml-1">Create an account</a>
            </p>
        </div>
    </div>
</main>

<%- include('partials/footer') %>
