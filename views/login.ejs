<%- include('partials/header') %>
<%- include('partials/sidebar') %>

<main class="flex-1 flex items-center justify-center p-4 min-h-screen">
    <div class="bg-white dark:bg-obsidian-900 border-2 border-slate-300 dark:border-obsidian-700 shadow-2xl w-full max-w-md p-7 relative">
        <div class="text-center mb-6">
            <div class="w-12 h-12 bg-primary/10 border border-primary/20 text-primary flex items-center justify-center mx-auto mb-3">
                <span class="material-icons text-2xl">smart_toy</span>
            </div>
            <h2 class="text-lg font-bold uppercase tracking-wider text-slate-900 dark:text-white">Operator Login</h2>
            <p class="text-slate-500 dark:text-slate-400 text-xs mt-1 font-mono">Sign in to control Minecraft bot instances</p>
        </div>

        <% if (error) { %>
            <div class="border-l-4 border-redstone-500 bg-redstone-500/10 text-redstone-400 border border-redstone-500/20 p-3 mb-5 text-xs font-mono flex items-center gap-2">
                <span class="material-icons text-sm">error</span>
                <span><%= error %></span>
            </div>
        <% } %>

        <form action="/login" method="POST" class="space-y-4">
            <div>
                <label class="block text-xs font-mono uppercase text-slate-700 dark:text-slate-300 mb-1.5 font-semibold">Username</label>
                <input type="text" name="username" class="w-full px-3 py-2.5 bg-slate-50 dark:bg-obsidian-950 border border-slate-300 dark:border-obsidian-700 text-xs text-slate-900 dark:text-white outline-none focus:border-primary transition-colors" placeholder="Enter username" required autocomplete="username">
            </div>
            <div>
                <label class="block text-xs font-mono uppercase text-slate-700 dark:text-slate-300 mb-1.5 font-semibold">Password</label>
                <input type="password" name="password" class="w-full px-3 py-2.5 bg-slate-50 dark:bg-obsidian-950 border border-slate-300 dark:border-obsidian-700 text-xs text-slate-900 dark:text-white outline-none focus:border-primary transition-colors" placeholder="••••••••" required autocomplete="current-password">
            </div>
            <button type="submit" class="w-full bg-primary hover:bg-primary-hover text-white font-mono text-xs uppercase font-bold tracking-wider py-2.5 transition-all border border-primary-hover shadow-sm active:translate-y-0.5 mt-2">
                Authenticate & Enter ->
            </button>
        </form>
        
        <div class="mt-6 pt-4 border-t border-slate-200 dark:border-obsidian-700 text-center text-xs font-mono">
            <p class="text-slate-500 dark:text-slate-400">
                Need an account? 
                <a href="/register" class="text-primary font-bold hover:underline ml-1">Register here</a>
            </p>
        </div>
    </div>
</main>

<%- include('partials/footer') %>
