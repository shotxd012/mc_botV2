<!DOCTYPE html>
<html lang="en" id="html-root" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MC Bot Dashboard</title>
    <meta name="color-scheme" content="dark">
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        primary: {
                            DEFAULT: '#3b82f6',
                            hover: '#2563eb',
                            dark: '#1d4ed8'
                        },
                        obsidian: {
                            950: '#070a11',
                            900: '#0b101c',
                            850: '#0f172a',
                            800: '#141e33',
                            750: '#1a2742',
                            700: '#233454',
                            600: '#344b74'
                        },
                        emerald: {
                            400: '#34d399',
                            500: '#10b981',
                            600: '#059669',
                            900: '#064e3b'
                        },
                        redstone: {
                            400: '#f87171',
                            500: '#ef4444',
                            600: '#dc2626',
                            900: '#7f1d1d'
                        }
                    },
                    fontFamily: {
                        sans: ['Inter', 'system-ui', 'sans-serif'],
                        mono: ['"JetBrains Mono"', 'Consolas', 'monospace']
                    }
                }
            }
        }
    </script>
    <!-- Chart.js for analytics -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        /* Strict square aesthetic: Absolutely zero curves */
        *, *::before, *::after {
            border-radius: 0 !important;
        }

        body {
            font-family: 'Inter', system-ui, sans-serif;
            background-color: #070a11;
            color: #e2e8f0;
        }

        /* Square custom scrollbars */
        * {
            scrollbar-width: thin;
            scrollbar-color: #64748b transparent;
        }
        * {
            scrollbar-color: #334155 transparent;
        }

        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: transparent;
        }
        ::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 0 !important;
        }
        ::-webkit-scrollbar-thumb {
            background: #233454;
            border-radius: 0 !important;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #94a3b8;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #3b82f6;
        }

        /* Console log specific styling */
        .console-logs {
            font-family: 'JetBrains Mono', Consolas, monospace;
        }

        /* Focus outlines - crisp square */
        input:focus, select:focus, textarea:focus, button:focus-visible {
            outline: 1px solid #3b82f6;
            outline-offset: 0px;
        }

        .pb-safe-bottom {
            padding-bottom: max(env(safe-area-inset-bottom, 0), 0.5rem);
        }

        /* Smooth square toast animations */
        @keyframes toastSlideIn {
            from {
                opacity: 0;
                transform: translateX(20px);
            }
            to {
                opacity: 1;
                transform: translateX(0);
            }
        }
        @keyframes toastFadeOut {
            from {
                opacity: 1;
                transform: translateX(0);
            }
            to {
                opacity: 0;
                transform: translateX(20px);
            }
        }
        .toast-enter {
            animation: toastSlideIn 0.2s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        }
        .toast-leave {
            animation: toastFadeOut 0.2s cubic-bezier(0.7, 0, 0.84, 0) forwards;
        }

        /* Grid background subtle effect */
        .bg-grid-pattern {
            background-size: 24px 24px;
            background-image: linear-gradient(to right, rgba(148, 163, 184, 0.05) 1px, transparent 1px),
                              linear-gradient(to bottom, rgba(148, 163, 184, 0.05) 1px, transparent 1px);
        }
        .bg-grid-pattern {
            background-image: linear-gradient(to right, rgba(30, 41, 59, 0.4) 1px, transparent 1px),
                              linear-gradient(to bottom, rgba(30, 41, 59, 0.4) 1px, transparent 1px);
        }
    </style>
</head>
<body class="bg-slate-50 dark:bg-obsidian-950 text-slate-900 dark:text-slate-100 transition-colors duration-150 min-h-screen flex bg-grid-pattern antialiased">
