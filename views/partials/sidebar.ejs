<% if (typeof user !== 'undefined') { %>
<!-- Layout Container: Flex row with Sidebar + Main Content Area -->
<div class="flex-1 flex flex-col md:flex-row w-full min-h-[calc(100vh-64px)]">
<!-- Desktop Sidebar (Width 260px, GitHub Primer styled) -->
<aside class="w-64 bg-canvas-subtle border-r border-ghborder-default hidden md:flex flex-col flex-shrink-0 select-none">
    <div class="p-4 border-b border-ghborder-muted flex items-center justify-between">
        <div class="flex items-center gap-2">
            <span class="material-icons text-base text-accent-fg">dns</span>
            <span class="text-xs font-semibold text-fg-default uppercase tracking-wider font-mono">Workspace</span>
        </div>
        <span class="text-[10px] font-mono bg-canvas-default border border-ghborder-default px-1.5 py-0.5 rounded text-fg-muted">v2.0</span>
    </div>

    <nav class="flex-1 p-3 space-y-1 overflow-y-auto">
        <div class="px-2 py-1 text-[11px] font-semibold text-fg-muted uppercase tracking-wider">
            Overview
        </div>
        <a href="/" class="flex items-center gap-2.5 px-3 py-2 text-xs font-medium rounded-md transition-colors <%= page === 'home' || page === 'bot' ? 'bg-accent-subtle text-accent-fg font-semibold' : 'text-fg-default hover:bg-canvas-default hover:text-accent-fg' %>">
            <span class="material-icons text-base opacity-80">view_list</span>
            <span>Repositories (Bots)</span>
        </a>
        <a href="/console" class="flex items-center gap-2.5 px-3 py-2 text-xs font-medium rounded-md transition-colors <%= page === 'console' ? 'bg-accent-subtle text-accent-fg font-semibold' : 'text-fg-default hover:bg-canvas-default hover:text-accent-fg' %>">
            <span class="material-icons text-base opacity-80">grid_view</span>
            <span>Multi-Console</span>
        </a>
        <a href="/profile" class="flex items-center gap-2.5 px-3 py-2 text-xs font-medium rounded-md transition-colors <%= page === 'profile' ? 'bg-accent-subtle text-accent-fg font-semibold' : 'text-fg-default hover:bg-canvas-default hover:text-accent-fg' %>">
            <span class="material-icons text-base opacity-80">account_circle</span>
            <span>Profile</span>
        </a>

        <% if (typeof user !== 'undefined' && user && user.role === 'admin') { %>
        <div class="pt-4 px-2 py-1 text-[11px] font-semibold text-fg-muted uppercase tracking-wider flex items-center justify-between">
            <span>Administration</span>
            <span class="text-[9px] bg-accent-subtle text-accent-fg border border-accent-muted px-1.5 py-0.2 rounded-pill font-mono">Admin</span>
        </div>
        <a href="/admin/overview" class="flex items-center gap-2.5 px-3 py-2 text-xs font-medium rounded-md transition-colors <%= page === 'admin-overview' ? 'bg-accent-subtle text-accent-fg font-semibold' : 'text-fg-default hover:bg-canvas-default hover:text-accent-fg' %>">
            <span class="material-icons text-base opacity-80">speed</span>
            <span>Telemetry</span>
        </a>
        <a href="/admin/bots" class="flex items-center gap-2.5 px-3 py-2 text-xs font-medium rounded-md transition-colors <%= page === 'admin-bots' ? 'bg-accent-subtle text-accent-fg font-semibold' : 'text-fg-default hover:bg-canvas-default hover:text-accent-fg' %>">
            <span class="material-icons text-base opacity-80">smart_toy</span>
            <span>Bot Fleet</span>
        </a>
        <a href="/admin/servers" class="flex items-center gap-2.5 px-3 py-2 text-xs font-medium rounded-md transition-colors <%= page === 'admin-servers' ? 'bg-accent-subtle text-accent-fg font-semibold' : 'text-fg-default hover:bg-canvas-default hover:text-accent-fg' %>">
            <span class="material-icons text-base opacity-80">dns</span>
            <span>Server Profiles</span>
        </a>
        <a href="/admin/users" class="flex items-center gap-2.5 px-3 py-2 text-xs font-medium rounded-md transition-colors <%= page === 'admin-users' ? 'bg-accent-subtle text-accent-fg font-semibold' : 'text-fg-default hover:bg-canvas-default hover:text-accent-fg' %>">
            <span class="material-icons text-base opacity-80">group</span>
            <span>Users & Access</span>
        </a>
        <a href="/admin/logs" class="flex items-center gap-2.5 px-3 py-2 text-xs font-medium rounded-md transition-colors <%= page === 'admin-logs' ? 'bg-accent-subtle text-accent-fg font-semibold' : 'text-fg-default hover:bg-canvas-default hover:text-accent-fg' %>">
            <span class="material-icons text-base opacity-80">receipt_long</span>
            <span>Audit Logs</span>
        </a>
        <a href="/admin/settings" class="flex items-center gap-2.5 px-3 py-2 text-xs font-medium rounded-md transition-colors <%= page === 'admin-settings' ? 'bg-accent-subtle text-accent-fg font-semibold' : 'text-fg-default hover:bg-canvas-default hover:text-accent-fg' %>">
            <span class="material-icons text-base opacity-80">settings</span>
            <span>Settings</span>
        </a>
        <a href="/templates" class="flex items-center gap-2.5 px-3 py-2 text-xs font-medium rounded-md transition-colors <%= page === 'templates' ? 'bg-accent-subtle text-accent-fg font-semibold' : 'text-fg-default hover:bg-canvas-default hover:text-accent-fg' %>">
            <span class="material-icons text-base opacity-80">content_copy</span>
            <span>Bot Templates</span>
        </a>
        <% } %>
    </nav>

    <!-- User / Session Footer -->
    <div class="p-3 border-t border-ghborder-default bg-canvas-default/50">
        <div class="flex items-center justify-between mb-2 px-1">
            <div class="flex items-center gap-2 truncate">
                <div class="w-6 h-6 rounded-full bg-accent-emphasis text-white flex items-center justify-center text-xs font-mono font-bold">
                    <%= user.username ? user.username.charAt(0).toUpperCase() : 'U' %>
                </div>
                <span class="text-xs font-semibold truncate text-fg-default"><%= user.username %></span>
            </div>
            <span class="text-[10px] font-mono capitalize px-2 py-0.5 bg-canvas-subtle text-fg-muted border border-ghborder-default rounded-pill">
                <%= user.role || 'user' %>
            </span>
        </div>
        <a href="/logout" class="flex items-center justify-center gap-1.5 w-full px-3 py-1.5 text-xs font-medium text-danger-fg hover:text-white hover:bg-danger-emphasis border border-ghborder-default rounded-md transition-colors">
            <span class="material-icons text-sm">logout</span>
            <span>Sign Out</span>
        </a>
    </div>
</aside>

<!-- Mobile Navigation (Bottom Bar / Header Collapsible) -->
<div class="fixed bottom-0 left-0 right-0 bg-canvas-subtle border-t border-ghborder-default md:hidden z-50 pb-safe-bottom shadow-lg">
    <div class="flex justify-around items-stretch">
        <a href="/" class="flex-1 flex flex-col items-center justify-center py-2 text-xs font-medium <%= page === 'home' || page === 'bot' ? 'text-accent-fg font-semibold' : 'text-fg-muted' %> transition-colors">
            <span class="material-icons text-lg">view_list</span>
            <span class="text-[10px] mt-0.5">Bots</span>
        </a>
        <a href="/console" class="flex-1 flex flex-col items-center justify-center py-2 text-xs font-medium <%= page === 'console' ? 'text-accent-fg font-semibold' : 'text-fg-muted' %> transition-colors">
            <span class="material-icons text-lg">grid_view</span>
            <span class="text-[10px] mt-0.5">Console</span>
        </a>
        <a href="/profile" class="flex-1 flex flex-col items-center justify-center py-2 text-xs font-medium <%= page === 'profile' ? 'text-accent-fg font-semibold' : 'text-fg-muted' %> transition-colors">
            <span class="material-icons text-lg">account_circle</span>
            <span class="text-[10px] mt-0.5">Profile</span>
        </a>
        <% if (typeof user !== 'undefined' && user && user.role === 'admin') { %>
        <a href="/admin/overview" class="flex-1 flex flex-col items-center justify-center py-2 text-xs font-medium <%= typeof page !== 'undefined' && page.startsWith('admin') ? 'text-accent-fg font-semibold' : 'text-fg-muted' %> transition-colors">
            <span class="material-icons text-lg">admin_panel_settings</span>
            <span class="text-[10px] mt-0.5">Admin</span>
        </a>
        <% } %>
        <a href="/logout" class="flex-1 flex flex-col items-center justify-center py-2 text-xs font-medium text-danger-fg transition-colors" onclick="event.preventDefault(); if(confirm('Are you sure you want to sign out?')) window.location.href='/logout';">
            <span class="material-icons text-lg">logout</span>
            <span class="text-[10px] mt-0.5">Exit</span>
        </a>
    </div>
</div>

<div class="flex-1 min-w-0 flex flex-col min-h-0 pb-16 md:pb-0">
<% } else { %>
<div class="w-full flex flex-col min-h-screen">
<% } %>
