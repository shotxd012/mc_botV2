<%- include('partials/header') %>
<%- include('partials/sidebar') %>

<script>
    const BOT_ID = "<%= botId %>";
</script>

<main class="flex-1 min-w-0 p-4 sm:p-6 md:p-8 max-w-[1280px] w-full mx-auto min-h-screen pb-20 md:pb-8 flex flex-col gap-6">
    <%- include('partials/bot-topbar', { botConfig, botId, status, section: 'game' }) %>

    <div class="max-w-4xl w-full mx-auto grid gap-5">
        <section class="bg-canvas-default border border-ghborder-default rounded-md p-5 shadow-sm">
            <div class="flex items-center gap-2 mb-5 border-b border-ghborder-muted pb-3">
                <span class="material-icons text-accent-fg text-base">sports_esports</span>
                <div>
                    <h3 class="text-sm font-semibold text-fg-default">In-Game Actions</h3>
                    <p class="text-[10px] text-fg-muted mt-1">Send direct actions to the connected Minecraft bot.</p>
                </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <button id="eat-food-button" onclick="eatFood()" class="flex items-center gap-3 p-4 text-left rounded-md border border-success-muted bg-success-subtle hover:border-success-fg transition-colors">
                    <span class="material-icons text-success-fg text-2xl">restaurant</span>
                    <span><strong class="block text-sm text-fg-default">Eat Food</strong><small class="text-[10px] text-fg-muted">Use the best food in the inventory</small></span>
                </button>
            </div>
        </section>

        <section class="grid grid-cols-2 sm:grid-cols-4 gap-3">
                <div class="bg-canvas-default border border-ghborder-default rounded-md p-4 text-center">
                <div class="text-[10px] font-mono uppercase text-fg-muted mb-2">Health</div>
                <div class="font-mono text-lg font-bold text-danger-fg"><%= status.health %> / 20</div>
            </div>
                <div class="bg-canvas-default border border-ghborder-default rounded-md p-4 text-center">
                <div class="text-[10px] font-mono uppercase text-fg-muted mb-2">Food</div>
                <div class="font-mono text-lg font-bold text-success-fg"><%= status.food %> / 20</div>
            </div>
                <div class="bg-canvas-default border border-ghborder-default rounded-md p-4 text-center col-span-2">
                <div class="text-[10px] font-mono uppercase text-fg-muted mb-2">Dimension</div>
                <div class="font-mono text-sm font-bold uppercase text-fg-default"><%= status.dimension || 'Offline' %></div>
            </div>
        </section>

        <section class="bg-canvas-default border border-ghborder-default rounded-md p-5 shadow-sm">
            <div class="flex items-center justify-between gap-3 mb-5 border-b border-ghborder-muted pb-3">
                <div class="flex items-center gap-2">
                    <span class="material-icons text-accent-fg text-base">inventory_2</span>
                    <div>
                        <h3 class="text-sm font-semibold text-fg-default">Player Inventory</h3>
                        <p class="text-[10px] text-fg-muted mt-1">Live inventory for <%= botConfig.name %>.</p>
                    </div>
                </div>
                <button onclick="loadInventory()" class="inline-flex items-center gap-1.5 px-2.5 py-1.5 text-[10px] font-mono uppercase font-bold text-fg-muted border border-ghborder-default rounded-md hover:border-accent-fg hover:text-accent-fg transition-colors">
                    <span class="material-icons text-sm">refresh</span> Refresh
                </button>
            </div>
            <div id="inventory-grid" class="inventory-grid" aria-live="polite">
                <div class="col-span-full text-center text-xs font-mono text-fg-muted py-6">Loading inventory...</div>
            </div>
        </section>
    </div>
</main>

<style>
    .workspace-link {
        display: flex;
        min-width: 108px;
        flex: 1 1 0%;
        align-items: center;
        justify-content: center;
        gap: 0.375rem;
        white-space: nowrap;
        border: 1px solid transparent;
        padding: 0.5rem 0.75rem;
        color: var(--fgColor-muted);
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: 0.75rem;
        font-weight: 600;
    }
    .workspace-link:hover { color: var(--fgColor-default); border-color: var(--borderColor-muted); }
    .workspace-link-active { color: var(--fgColor-default); border-color: var(--accent-fgColor); }
    .inventory-grid { display: grid; grid-template-columns: repeat(9, minmax(0, 1fr)); gap: 0.35rem; }
    .inventory-slot { position: relative; min-width: 0; aspect-ratio: 1; display: flex; align-items: center; justify-content: center; border: 1px solid var(--borderColor-default); background: var(--bgColor-inset); color: var(--fgColor-muted); font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: clamp(9px, 2vw, 12px); text-align: center; padding: 0.2rem; }
    .inventory-slot.filled { color: var(--fgColor-default); border-color: var(--borderColor-muted); background: var(--bgColor-subtle); }
    .inventory-item-image { width: 72%; height: 72%; object-fit: contain; image-rendering: pixelated; }
    .inventory-item-name { max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .inventory-slot:hover { border-color: var(--accent-fgColor); color: var(--fgColor-default); }
    .inventory-slot.selected { border-color: var(--attention-fgColor); box-shadow: inset 0 0 0 1px var(--attention-fgColor); }
    .inventory-count { position: absolute; right: 0.2rem; bottom: 0.1rem; color: var(--success-fgColor); font-size: 10px; font-weight: 700; }
    .inventory-slot-number { position: absolute; left: 0.2rem; top: 0.1rem; color: var(--fgColor-muted); font-size: 8px; }
</style>

<script>
async function eatFood() {
    const button = document.getElementById('eat-food-button');
    if (button) button.disabled = true;
    try {
        const response = await fetch(`/api/bot/${BOT_ID}/eat`, { method: 'POST' });
        const result = await response.json();
        showToast(result.success ? 'Food action sent.' : (result.error || 'Unable to eat food.'), result.success ? 'success' : 'error');
    } catch (error) {
        showToast('Network error sending food action.', 'error');
    } finally {
        if (button) button.disabled = false;
    }
}

function inventoryLabel(item) {
    return item.displayName || item.name;
}

const INVENTORY_ASSET_VERSION = <%- JSON.stringify(botConfig.server?.version && botConfig.server.version !== 'auto' ? botConfig.server.version : '1.21.4') %>;

function inventoryImageUrl(item) {
    const itemName = String(item.name || '').split(':').pop();
    return `https://mcasset.cloud/${encodeURIComponent(INVENTORY_ASSET_VERSION)}/assets/minecraft/textures/item/${encodeURIComponent(itemName)}.png`;
}

function escapeHtml(value) {
    return String(value)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
}

async function loadInventory() {
    const grid = document.getElementById('inventory-grid');
    if (!grid) return;
    try {
        const response = await fetch(`/api/bot/${BOT_ID}/inventory`);
        const result = await response.json();
        if (!response.ok) {
            throw new Error(result.error || 'Inventory request failed.');
        }
        if (!result.success) {
            grid.innerHTML = `<div class="col-span-full text-center text-xs font-mono text-danger-fg py-6">${escapeHtml(result.error || 'Inventory unavailable.')}</div>`;
            return;
        }
        grid.innerHTML = result.slots.map((item, slot) => item
            ? `<button type="button" class="inventory-slot filled${selectedInventorySlot === slot ? ' selected' : ''}" data-slot="${slot}" onclick="selectInventorySlot(${slot})" title="${escapeHtml(inventoryLabel(item))} x${item.count}"><span class="inventory-slot-number">${slot}</span><img class="inventory-item-image" src="${inventoryImageUrl(item)}" alt="${escapeHtml(inventoryLabel(item))}" onerror="this.hidden=true; this.nextElementSibling.hidden=false"><span class="inventory-item-name" hidden>${escapeHtml(item.displayName || item.name)}</span><span class="inventory-count">${item.count}</span></button>`
            : `<button type="button" class="inventory-slot${selectedInventorySlot === slot ? ' selected' : ''}" data-slot="${slot}" onclick="selectInventorySlot(${slot})" title="Empty slot"><span class="inventory-slot-number">${slot}</span></button>`
        ).join('');
    } catch (error) {
        grid.innerHTML = `<div class="col-span-full text-center text-xs font-mono text-danger-fg py-6">${escapeHtml(error.message || 'Could not load inventory.')}</div>`;
    }
}

let selectedInventorySlot = null;

async function selectInventorySlot(slot) {
    if (selectedInventorySlot === null) {
        selectedInventorySlot = slot;
        await loadInventory();
        return;
    }

    const sourceSlot = selectedInventorySlot;
    selectedInventorySlot = null;
    try {
        const response = await fetch(`/api/bot/${BOT_ID}/inventory/move`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ sourceSlot, destinationSlot: slot })
        });
        const result = await response.json();
        if (!response.ok || !result.success) {
            throw new Error(result.error || 'Inventory move failed.');
        }
        await loadInventory();
    } catch (error) {
        await loadInventory();
        showToast(error.message || 'Inventory move failed.', 'error');
    }
}

loadInventory();
setInterval(loadInventory, 10000);
</script>

<%- include('partials/footer') %>
