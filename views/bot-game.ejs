<%- include('partials/header') %>
<%- include('partials/sidebar') %>

<script>
    const BOT_ID = "<%= botId %>";
</script>

<main class="flex-1 min-w-0 p-4 sm:p-6 md:p-8 min-h-screen pb-20 md:pb-8 flex flex-col gap-6">
    <header class="flex flex-col gap-4 border-b border-obsidian-700/60 pb-4">
        <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
            <div class="flex items-center gap-3 min-w-0">
                <a href="/bot/<%= botId %>" class="p-2 bg-obsidian-850 hover:bg-obsidian-800 text-slate-300 border border-obsidian-700 flex items-center justify-center" title="Back to console">
                    <span class="material-icons text-base">arrow_back</span>
                </a>
                <div class="min-w-0">
                    <div class="flex items-center gap-2.5">
                        <h2 class="text-xl md:text-2xl font-bold uppercase tracking-tight text-white truncate"><%= botConfig.name %></h2>
                        <span class="px-1.5 py-0.5 font-mono text-[10px] bg-obsidian-800 border border-obsidian-700 text-slate-400">#<%= botId %></span>
                    </div>
                    <div class="flex items-center gap-2 text-xs text-slate-500 mt-1 font-mono">
                        <span class="w-2 h-2 inline-block <%= status.online ? 'bg-emerald-500' : 'bg-redstone-500' %>"></span>
                        <span class="font-bold"><%= status.online ? 'Online' : 'Offline' %></span>
                        <span>•</span>
                        <span class="truncate"><%= status.server ? status.server.ip + ':' + status.server.port : 'No server configured' %></span>
                    </div>
                </div>
            </div>
            <span class="text-[10px] font-mono uppercase tracking-widest text-primary border border-primary/30 bg-primary/10 px-2 py-1">In-Game</span>
        </div>

        <nav class="flex w-full min-w-0 max-w-full items-center gap-1 overflow-x-auto border border-obsidian-700/80 bg-obsidian-900/70 p-1" aria-label="Bot workspace">
            <a href="/bot/<%= botId %>" class="workspace-link"><span class="material-icons text-sm">terminal</span> Console</a>
            <a href="/bot/<%= botId %>/config" class="workspace-link"><span class="material-icons text-sm">settings</span> Config</a>
            <a href="/bot/<%= botId %>/analytics" class="workspace-link"><span class="material-icons text-sm">show_chart</span> Analytics</a>
            <a href="/bot/<%= botId %>/events" class="workspace-link"><span class="material-icons text-sm">timeline</span> Events</a>
            <a href="/bot/<%= botId %>/game" aria-current="page" class="workspace-link border-primary text-primary bg-primary/10"><span class="material-icons text-sm">sports_esports</span> In-Game</a>
            <a href="/bot/<%= botId %>/settings" class="workspace-link"><span class="material-icons text-sm">tune</span> Settings</a>
        </nav>
    </header>

    <div class="max-w-4xl w-full mx-auto grid gap-5">
        <section class="bg-obsidian-900 border border-obsidian-700/80 p-5 shadow-sm">
            <div class="flex items-center gap-2 mb-5 border-b border-obsidian-700/60 pb-3">
                <span class="material-icons text-primary text-base">sports_esports</span>
                <div>
                    <h3 class="text-xs font-mono uppercase tracking-wider font-bold text-white">In-Game Actions</h3>
                    <p class="text-[10px] text-slate-500 mt-1">Send direct actions to the connected Minecraft bot.</p>
                </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <button id="eat-food-button" onclick="eatFood()" class="flex items-center gap-3 p-4 text-left border border-emerald-500/30 bg-emerald-500/5 hover:bg-emerald-500/10 hover:border-emerald-400 transition-colors">
                    <span class="material-icons text-emerald-400 text-2xl">restaurant</span>
                    <span><strong class="block text-sm text-slate-200">Eat Food</strong><small class="text-[10px] text-slate-500">Use the best food in the inventory</small></span>
                </button>
            </div>
        </section>

        <section class="grid grid-cols-2 sm:grid-cols-4 gap-3">
            <div class="bg-obsidian-900 border border-obsidian-700/80 p-4 text-center">
                <div class="text-[10px] font-mono uppercase text-slate-500 mb-2">Health</div>
                <div class="font-mono text-lg font-bold text-redstone-400"><%= status.health %> / 20</div>
            </div>
            <div class="bg-obsidian-900 border border-obsidian-700/80 p-4 text-center">
                <div class="text-[10px] font-mono uppercase text-slate-500 mb-2">Food</div>
                <div class="font-mono text-lg font-bold text-emerald-400"><%= status.food %> / 20</div>
            </div>
            <div class="bg-obsidian-900 border border-obsidian-700/80 p-4 text-center col-span-2">
                <div class="text-[10px] font-mono uppercase text-slate-500 mb-2">Dimension</div>
                <div class="font-mono text-sm font-bold uppercase text-slate-300"><%= status.dimension || 'Offline' %></div>
            </div>
        </section>

        <section class="bg-obsidian-900 border border-obsidian-700/80 p-5 shadow-sm">
            <div class="flex items-center justify-between gap-3 mb-5 border-b border-obsidian-700/60 pb-3">
                <div class="flex items-center gap-2">
                    <span class="material-icons text-primary text-base">inventory_2</span>
                    <div>
                        <h3 class="text-xs font-mono uppercase tracking-wider font-bold text-white">Player Inventory</h3>
                        <p class="text-[10px] text-slate-500 mt-1">Live inventory for <%= botConfig.name %>.</p>
                    </div>
                </div>
                <button onclick="loadInventory()" class="inline-flex items-center gap-1.5 px-2.5 py-1.5 text-[10px] font-mono uppercase font-bold text-slate-400 border border-obsidian-700 hover:border-primary hover:text-primary transition-colors">
                    <span class="material-icons text-sm">refresh</span> Refresh
                </button>
            </div>
            <div id="inventory-grid" class="inventory-grid" aria-live="polite">
                <div class="col-span-full text-center text-xs font-mono text-slate-500 py-6">Loading inventory...</div>
            </div>
        </section>
    </div>
</main>

<style>
    .workspace-link {
        display: flex;
        min-width: 108px;
        flex: 1 1 0%;
        align-items: center;
        justify-content: center;
        gap: 0.375rem;
        white-space: nowrap;
        border: 1px solid transparent;
        padding: 0.5rem 0.75rem;
        color: #94a3b8;
        font-family: 'JetBrains Mono', Consolas, monospace;
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 0.05em;
        text-transform: uppercase;
    }
    .workspace-link:hover { color: #e2e8f0; background: #141e33; }
    .inventory-grid { display: grid; grid-template-columns: repeat(9, minmax(0, 1fr)); gap: 0.35rem; }
    .inventory-slot { position: relative; min-width: 0; aspect-ratio: 1; display: flex; align-items: center; justify-content: center; border: 1px solid #233454; background: #070a11; color: #64748b; font-family: 'JetBrains Mono', Consolas, monospace; font-size: clamp(9px, 2vw, 12px); text-align: center; padding: 0.2rem; }
    .inventory-slot.filled { color: #e2e8f0; border-color: #344b74; background: #141e33; }
    .inventory-slot:hover { border-color: #3b82f6; color: #fff; }
    .inventory-count { position: absolute; right: 0.2rem; bottom: 0.1rem; color: #34d399; font-size: 10px; font-weight: 700; }
    .inventory-slot-number { position: absolute; left: 0.2rem; top: 0.1rem; color: #475569; font-size: 8px; }
</style>

<script>
async function eatFood() {
    const button = document.getElementById('eat-food-button');
    if (button) button.disabled = true;
    try {
        const response = await fetch(`/api/bot/${BOT_ID}/eat`, { method: 'POST' });
        const result = await response.json();
        showToast(result.success ? 'Food action sent.' : (result.error || 'Unable to eat food.'), result.success ? 'success' : 'error');
    } catch (error) {
        showToast('Network error sending food action.', 'error');
    } finally {
        if (button) button.disabled = false;
    }
}

function inventoryLabel(item) {
    return item.displayName || item.name;
}

async function loadInventory() {
    const grid = document.getElementById('inventory-grid');
    if (!grid) return;
    try {
        const response = await fetch(`/api/bot/${BOT_ID}/inventory`);
        const result = await response.json();
        if (!result.success) {
            grid.innerHTML = `<div class="col-span-full text-center text-xs font-mono text-redstone-400 py-6">${escapeHtml(result.error || 'Inventory unavailable.')}</div>`;
            return;
        }
        grid.innerHTML = result.slots.map((item, slot) => item
            ? `<div class="inventory-slot filled" title="${escapeHtml(inventoryLabel(item))} x${item.count}"><span class="inventory-slot-number">${slot}</span><span>${escapeHtml(item.displayName || item.name)}</span><span class="inventory-count">${item.count}</span></div>`
            : `<div class="inventory-slot" title="Empty slot"><span class="inventory-slot-number">${slot}</span></div>`
        ).join('');
    } catch (error) {
        grid.innerHTML = '<div class="col-span-full text-center text-xs font-mono text-redstone-400 py-6">Could not load inventory.</div>';
    }
}

loadInventory();
setInterval(loadInventory, 10000);
</script>

<%- include('partials/footer') %>
