<%- include('partials/header') %>
<%- include('partials/sidebar') %>

<main class="flex-1 p-4 sm:p-6 md:p-8 max-w-[1280px] w-full mx-auto min-h-full flex flex-col gap-6">
    <!-- Page Header / Repository Filter Toolbar -->
    <header class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 border-b border-ghborder-default pb-5">
        <div>
            <div class="flex items-center gap-3">
                <h1 class="text-xl sm:text-2xl font-semibold text-fg-default tracking-tight">Repositories</h1>
                <span class="px-2 py-0.5 text-xs font-mono font-medium bg-canvas-subtle text-fg-muted border border-ghborder-default rounded-pill">
                    <%= bots.length %> <%= bots.length === 1 ? 'bot' : 'bots' %>
                </span>
            </div>
            <p class="text-fg-muted mt-1 text-xs sm:text-sm">Manage, inspect, and automate your Minecraft AFK bot workers.</p>
        </div>
        <% if (typeof user !== 'undefined' && user && user.role === 'admin') { %>
        <button onclick="openCreateModal()" class="bg-success-emphasis hover:bg-success-fg text-white px-3.5 py-1.5 rounded-md font-semibold text-xs flex items-center justify-center gap-1.5 transition-colors border border-success-emphasis shadow-sm w-full sm:w-auto">
            <span class="material-icons text-base">add</span>
            <span>New Bot</span>
        </button>
        <% } %>
    </header>

    <!-- Search & Filter Controls -->
    <div class="flex flex-col sm:flex-row gap-3 justify-between items-stretch sm:items-center">
        <div class="relative flex-1 max-w-md">
            <span class="material-icons text-base text-fg-muted absolute left-2.5 top-2 pointer-events-none">search</span>
            <input type="text" id="bot-search-input" onkeyup="filterBotCards(this.value)" placeholder="Find a repository or bot..." class="w-full bg-canvas-default border border-ghborder-default rounded-md pl-8 pr-3 py-1.5 text-xs text-fg-default placeholder-fg-muted outline-none focus:border-accent-fg focus:ring-1 focus:ring-accent-fg transition-all">
        </div>
        <div class="flex items-center gap-2 text-xs text-fg-muted">
            <span class="font-medium">Filter status:</span>
            <button onclick="filterByStatus('all')" class="status-filter-btn px-2.5 py-1 rounded-md bg-canvas-subtle border border-ghborder-default text-fg-default font-semibold" data-status="all">All</button>
            <button onclick="filterByStatus('online')" class="status-filter-btn px-2.5 py-1 rounded-md hover:bg-canvas-subtle border border-transparent text-fg-muted hover:text-fg-default" data-status="online">Online</button>
            <button onclick="filterByStatus('offline')" class="status-filter-btn px-2.5 py-1 rounded-md hover:bg-canvas-subtle border border-transparent text-fg-muted hover:text-fg-default" data-status="offline">Offline</button>
        </div>
    </div>

    <!-- Bots / Repository Grid -->
    <div id="bot-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        <% bots.forEach(function(bot) { %>
            <div onclick="window.location.href='/bot/<%= bot.id %>'"
                 data-bot-card="<%= bot.id %>"
                 data-bot-name="<%= (bot.name || '').toLowerCase() %>"
                 data-bot-status="<%= bot.online ? 'online' : 'offline' %>"
                 class="bot-card bg-canvas-default border border-ghborder-default hover:border-ghborder-strong rounded-md p-4 flex flex-col justify-between group cursor-pointer transition-all shadow-sm hover:shadow-md">
                <div>
                    <div class="flex justify-between items-start gap-2 mb-3">
                        <div class="flex items-center gap-2.5 min-w-0">
                            <span class="material-icons text-lg text-fg-muted group-hover:text-accent-fg transition-colors">dns</span>
                            <div class="min-w-0">
                                <h3 class="text-sm font-semibold text-accent-fg group-hover:underline truncate">
                                    <%= bot.name %>
                                </h3>
                                <span class="text-[11px] font-mono text-fg-muted">#<%= bot.id %></span>
                            </div>
                        </div>
                        <span class="bot-status-badge px-2 py-0.5 text-[10px] font-mono font-medium rounded-pill border flex-shrink-0 flex items-center gap-1 <%= bot.online ? 'bg-success-subtle text-success-fg border-success-subtle' : 'bg-canvas-subtle text-fg-muted border-ghborder-default' %>">
                            <span class="w-1.5 h-1.5 rounded-full <%= bot.online ? 'bg-success-fg' : 'bg-fg-muted' %>"></span>
                            <span><%= bot.online ? 'Online' : 'Offline' %></span>
                        </span>
                    </div>

                    <p class="text-xs text-fg-muted line-clamp-2 mb-4">
                        Minecraft AFK Bot instance running on <code class="font-mono text-fg-default"><%= typeof bot.server !== 'undefined' ? bot.server.ip : 'localhost' %></code>
                    </p>

                    <div class="space-y-1.5 text-xs text-fg-muted border-t border-ghborder-muted pt-3">
                        <div class="flex items-center justify-between">
                            <span>Server Target:</span>
                            <span class="bot-server-text font-mono text-fg-default truncate max-w-[180px]">
                                <%= typeof bot.server !== 'undefined' ? bot.server.ip + ':' + bot.server.port : 'Not set' %>
                            </span>
                        </div>
                        <div class="flex items-center justify-between">
                            <span>Player Account:</span>
                            <span class="bot-username-text font-mono text-fg-default truncate max-w-[180px]">
                                <%= bot.username || 'Not connected' %>
                            </span>
                        </div>
                    </div>
                </div>

                <div class="mt-4 pt-3 border-t border-ghborder-muted flex justify-between items-center text-[11px] font-mono text-fg-muted">
                    <span>Version: <%= typeof bot.server !== 'undefined' ? bot.server.version : 'Auto' %></span>
                    <span class="text-accent-fg font-semibold flex items-center gap-0.5 group-hover:translate-x-0.5 transition-transform">
                        <span>Console</span>
                        <span class="material-icons text-xs">chevron_right</span>
                    </span>
                </div>
            </div>
        <% }); %>

        <% if (typeof user !== 'undefined' && user && user.role === 'admin') { %>
        <!-- Add New Bot Placeholder Card -->
        <div onclick="openCreateModal()" class="bg-canvas-subtle/50 border border-dashed border-ghborder-default hover:border-accent-fg rounded-md p-6 flex flex-col items-center justify-center text-fg-muted hover:text-accent-fg cursor-pointer transition-all min-h-[180px] group">
            <span class="material-icons text-3xl mb-1 group-hover:scale-110 transition-transform">add_circle_outline</span>
            <span class="font-semibold text-xs text-fg-default group-hover:text-accent-fg">Create Bot Repository</span>
            <span class="text-[11px] text-fg-muted mt-1">Configure server host & credentials</span>
        </div>
        <% } %>
    </div>
</main>

<!-- Create Bot Modal Dialog (GitHub Style Primer Dialog) -->
<div id="create-modal" class="fixed inset-0 z-50 flex items-center justify-center bg-black/60 backdrop-blur-xs hidden opacity-0 transition-opacity duration-150">
    <div class="bg-canvas-default border border-ghborder-default rounded-lg p-6 w-full max-w-md mx-4 shadow-2xl transform scale-95 transition-transform duration-150" id="create-modal-content">
        <div class="flex justify-between items-center mb-4 border-b border-ghborder-muted pb-3">
            <div class="flex items-center gap-2">
                <span class="material-icons text-accent-fg text-lg">smart_toy</span>
                <h3 class="text-sm font-semibold text-fg-default">Create new bot repository</h3>
            </div>
            <button onclick="closeCreateModal()" class="text-fg-muted hover:text-fg-default p-1 rounded hover:bg-canvas-subtle transition-colors">
                <span class="material-icons text-base">close</span>
            </button>
        </div>

        <form onsubmit="createBot(event)" class="space-y-4">
            <div>
                <label class="block text-xs font-semibold text-fg-default mb-1">Bot Label Name</label>
                <input type="text" name="name" placeholder="e.g. survival-afk-worker" required class="w-full bg-canvas-default border border-ghborder-default rounded-md px-3 py-1.5 text-xs text-fg-default outline-none focus:border-accent-fg focus:ring-1 focus:ring-accent-fg transition-all">
            </div>

            <div>
                <label class="block text-xs font-semibold text-fg-default mb-1">Microsoft Account Email</label>
                <input type="email" name="email" placeholder="operator@example.com" required class="w-full bg-canvas-default border border-ghborder-default rounded-md px-3 py-1.5 text-xs text-fg-default outline-none focus:border-accent-fg focus:ring-1 focus:ring-accent-fg transition-all">
            </div>

            <div class="grid grid-cols-3 gap-3">
                <div class="col-span-2">
                    <label class="block text-xs font-semibold text-fg-default mb-1">Server Host IP</label>
                    <input type="text" name="ip" placeholder="play.example.com" required class="w-full bg-canvas-default border border-ghborder-default rounded-md px-3 py-1.5 text-xs font-mono text-fg-default outline-none focus:border-accent-fg focus:ring-1 focus:ring-accent-fg transition-all">
                </div>
                <div>
                    <label class="block text-xs font-semibold text-fg-default mb-1">Port</label>
                    <input type="number" name="port" value="25565" required class="w-full bg-canvas-default border border-ghborder-default rounded-md px-3 py-1.5 text-xs font-mono text-fg-default outline-none focus:border-accent-fg focus:ring-1 focus:ring-accent-fg transition-all">
                </div>
            </div>

            <div>
                <label class="block text-xs font-semibold text-fg-default mb-1">Minecraft Version</label>
                <select name="version" class="w-full bg-canvas-default border border-ghborder-default rounded-md px-3 py-1.5 text-xs font-mono text-fg-default outline-none focus:border-accent-fg focus:ring-1 focus:ring-accent-fg transition-all">
                    <option value="1.20.4">1.20.4</option>
                    <option value="1.20.1">1.20.1</option>
                    <option value="1.19.4">1.19.4</option>
                    <option value="1.18.2">1.18.2</option>
                    <option value="1.12.2">1.12.2</option>
                    <option value="auto">Auto-detect</option>
                </select>
            </div>

            <div class="flex justify-end gap-2 mt-6 pt-4 border-t border-ghborder-muted">
                <button type="button" onclick="closeCreateModal()" class="px-3 py-1.5 text-xs font-medium text-fg-muted hover:text-fg-default hover:bg-canvas-subtle rounded-md transition-colors">
                    Cancel
                </button>
                <button type="submit" class="px-3.5 py-1.5 bg-success-emphasis hover:bg-success-fg text-white text-xs font-semibold rounded-md transition-colors border border-success-emphasis shadow-sm">
                    Create Bot
                </button>
            </div>
        </form>
    </div>
</div>

<script>
function filterBotCards(query) {
    const q = (query || '').toLowerCase().trim();
    const cards = document.querySelectorAll('.bot-card');
    cards.forEach(card => {
        const name = card.getAttribute('data-bot-name') || '';
        if (!q || name.includes(q)) {
            card.style.display = '';
        } else {
            card.style.display = 'none';
        }
    });
}

function filterByStatus(status) {
    const btns = document.querySelectorAll('.status-filter-btn');
    btns.forEach(btn => {
        if (btn.getAttribute('data-status') === status) {
            btn.className = 'status-filter-btn px-2.5 py-1 rounded-md bg-canvas-subtle border border-ghborder-default text-fg-default font-semibold';
        } else {
            btn.className = 'status-filter-btn px-2.5 py-1 rounded-md hover:bg-canvas-subtle border border-transparent text-fg-muted hover:text-fg-default';
        }
    });

    const cards = document.querySelectorAll('.bot-card');
    cards.forEach(card => {
        const st = card.getAttribute('data-bot-status');
        if (status === 'all' || st === status) {
            card.style.display = '';
        } else {
            card.style.display = 'none';
        }
    });
}

function openCreateModal() {
    <% if (typeof user !== 'undefined' && user && user.role === 'admin') { %>
        const modal = document.getElementById('create-modal');
        modal.classList.remove('hidden');
        setTimeout(() => {
            modal.classList.remove('opacity-0');
            document.getElementById('create-modal-content').classList.remove('scale-95');
        }, 10);
    <% } else { %>
        if (typeof showToast === 'function') {
            showToast('Permission denied. Only administrators can create bots.', 'error');
        } else {
            alert('Permission denied. Only administrators can create bots.');
        }
    <% } %>
}

function closeCreateModal() {
    const modal = document.getElementById('create-modal');
    modal.classList.add('opacity-0');
    document.getElementById('create-modal-content').classList.add('scale-95');
    setTimeout(() => {
        modal.classList.add('hidden');
    }, 150);
}

async function createBot(e) {
    e.preventDefault();
    const formData = new FormData(e.target);
    const data = Object.fromEntries(formData.entries());

    try {
        const res = await fetch('/api/bots/create', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
        });

        if (res.ok) {
            window.location.reload();
        } else {
            const errorData = await res.json();
            if (typeof showToast === 'function') {
                showToast(errorData.error || 'Failed to create bot', 'error');
            } else {
                alert(errorData.error || 'Failed to create bot');
            }
        }
    } catch (err) {
        console.error(err);
        if (typeof showToast === 'function') {
            showToast('Error creating bot', 'error');
        } else {
            alert('Error creating bot');
        }
    }
}
</script>

<%- include('partials/footer') %>
