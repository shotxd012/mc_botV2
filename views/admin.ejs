                            <span class="text-slate-400">Target: <%= log.target %></span>
                        <% } %>
                    </div>
                    <% if (log.details) { %>
                        <pre class="mt-2 text-[11px] font-mono text-slate-600 dark:text-slate-400 bg-slate-100 dark:bg-obsidian-900 p-2 border border-slate-200 dark:border-obsidian-800 overflow-x-auto whitespace-pre-wrap"><%- JSON.stringify(log.details, null, 2) %></pre>
