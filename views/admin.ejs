<%- include('partials/header') %>
<%- include('partials/sidebar') %>

<main class="flex-1 p-4 sm:p-6 md:p-8 min-h-screen pb-20 md:pb-8 flex flex-col gap-6">
    <header class="border-b border-slate-200 dark:border-obsidian-700/60 pb-5">
        <div class="flex items-center gap-2.5">
            <h1 class="text-xl sm:text-2xl font-bold uppercase tracking-tight text-slate-900 dark:text-white">Admin Operations Center</h1>
            <span class="px-2 py-0.5 text-[10px] font-mono font-bold uppercase bg-redstone-500/10 text-redstone-400 border border-redstone-500/30">Root Access</span>
        </div>
        <p class="text-slate-500 dark:text-slate-400 mt-1 text-xs sm:text-sm">Manage bot assignments, system metrics, users, and server connectivity profiles.</p>
    </header>

    <!-- System Telemetry Grid (Sharp Square HUD) -->
    <section class="grid grid-cols-2 md:grid-cols-3 xl:grid-cols-4 gap-3.5">
        <div class="bg-white dark:bg-obsidian-900 border border-slate-200 dark:border-obsidian-700 p-4 flex flex-col justify-between shadow-sm">
            <div class="text-[10px] font-mono uppercase tracking-widest text-slate-400 mb-1">System Uptime</div>
            <div class="text-base sm:text-lg font-mono font-bold text-slate-900 dark:text-white"><%= systemStats.uptime.system %></div>
            <div class="text-[11px] font-mono text-slate-500 mt-1">App: <%= systemStats.uptime.app %></div>
        </div>

        <div class="bg-white dark:bg-obsidian-900 border border-slate-200 dark:border-obsidian-700 p-4 flex flex-col justify-between shadow-sm">
            <div class="text-[10px] font-mono uppercase tracking-widest text-slate-400 mb-1">CPU Architecture</div>
            <div class="text-base sm:text-lg font-mono font-bold text-slate-900 dark:text-white"><%= systemStats.cpu.count %> Cores</div>
            <div class="text-[11px] font-mono text-slate-500 mt-1">Load: <%= systemStats.cpu.loadAvg %></div>
        </div>

        <div class="bg-white dark:bg-obsidian-900 border border-slate-200 dark:border-obsidian-700 p-4 flex flex-col justify-between shadow-sm">
            <div class="text-[10px] font-mono uppercase tracking-widest text-slate-400 mb-1">RAM Memory</div>
            <div class="text-base sm:text-lg font-mono font-bold text-slate-900 dark:text-white"><%= systemStats.memory.used %> / <%= systemStats.memory.total %></div>
            <div class="text-[11px] font-mono text-slate-500 mt-1">Process RSS: <%= systemStats.memory.process.rss %></div>
        </div>

        <div class="bg-white dark:bg-obsidian-900 border border-slate-200 dark:border-obsidian-700 p-4 flex flex-col justify-between shadow-sm">
            <div class="text-[10px] font-mono uppercase tracking-widest text-slate-400 mb-1">Bots Online</div>
            <div class="text-base sm:text-lg font-mono font-bold text-emerald-500"><%= systemStats.bots.online %> Online</div>
            <div class="text-[11px] font-mono text-slate-500 mt-1">
                Offline: <%= systemStats.bots.offline %> · Total: <%= systemStats.bots.total %>
            </div>
        </div>

        <div class="bg-white dark:bg-obsidian-900 border border-slate-200 dark:border-obsidian-700 p-4 flex flex-col justify-between shadow-sm">
            <div class="text-[10px] font-mono uppercase tracking-widest text-slate-400 mb-1">Server Profiles</div>
            <div class="text-base sm:text-lg font-mono font-bold text-slate-900 dark:text-white"><%= systemStats.servers.online %> Running</div>
            <div class="text-[11px] font-mono text-slate-500 mt-1">
                Total: <%= systemStats.servers.total %> · Assigned: <%= systemStats.servers.assigned %>
            </div>
        </div>

        <div class="bg-white dark:bg-obsidian-900 border border-slate-200 dark:border-obsidian-700 p-4 flex flex-col justify-between shadow-sm">
            <div class="text-[10px] font-mono uppercase tracking-widest text-slate-400 mb-1">Runtime Environment</div>
            <div class="text-base sm:text-lg font-mono font-bold text-slate-900 dark:text-white"><%= systemStats.meta.node %></div>
            <div class="text-[11px] font-mono text-slate-500 mt-1 truncate"><%= systemStats.meta.platform %></div>
        </div>

        <div class="bg-white dark:bg-obsidian-900 border border-slate-200 dark:border-obsidian-700 p-4 flex flex-col justify-between shadow-sm">
            <div class="text-[10px] font-mono uppercase tracking-widest text-slate-400 mb-1">Storage Disk</div>
            <% if (systemStats.disk) { %>
                <div class="text-base sm:text-lg font-mono font-bold text-slate-900 dark:text-white"><%= systemStats.disk.used %> / <%= systemStats.disk.total %></div>
                <div class="text-[11px] font-mono text-slate-500 mt-1">Free: <%= systemStats.disk.free %> (<%= systemStats.disk.percent %> used)</div>
            <% } else { %>
                <div class="text-sm font-mono text-slate-400">Unavailable</div>
            <% } %>
        </div>

        <div class="bg-white dark:bg-obsidian-900 border border-slate-200 dark:border-obsidian-700 p-4 flex flex-col justify-between shadow-sm">
            <div class="text-[10px] font-mono uppercase tracking-widest text-slate-400 mb-1">Network I/O</div>
            <% if (systemStats.network) { %>
                <div class="text-base sm:text-lg font-mono font-bold text-slate-900 dark:text-white">RX <%= systemStats.network.rx %></div>
                <div class="text-[11px] font-mono text-slate-500 mt-1">TX <%= systemStats.network.tx %></div>
            <% } else { %>
                <div class="text-sm font-mono text-slate-400">Unavailable</div>
            <% } %>
        </div>

        <div class="bg-white dark:bg-obsidian-900 border border-slate-200 dark:border-obsidian-700 p-4 flex flex-col justify-between shadow-sm">
            <div class="text-[10px] font-mono uppercase tracking-widest text-slate-400 mb-1">Process CPU</div>
            <div class="text-base sm:text-lg font-mono font-bold text-slate-900 dark:text-white"><%= systemStats.cpu.processPercent %>%</div>
            <div class="text-[11px] font-mono text-slate-500 mt-1 truncate">Heap: <%= systemStats.memory.process.heapUsed %> / <%= systemStats.memory.process.heapTotal %></div>
        </div>

        <div class="bg-white dark:bg-obsidian-900 border border-slate-200 dark:border-obsidian-700 p-4 flex flex-col justify-between shadow-sm">
            <div class="text-[10px] font-mono uppercase tracking-widest text-slate-400 mb-1">Host Machine</div>
            <div class="text-base sm:text-lg font-mono font-bold text-slate-900 dark:text-white truncate"><%= systemStats.meta.hostname %></div>
            <div class="text-[11px] font-mono text-slate-500 mt-1">Arch: <%= systemStats.meta.arch %> · PID <%= systemStats.meta.pid %></div>
        </div>

        <div class="bg-white dark:bg-obsidian-900 border border-slate-200 dark:border-obsidian-700 p-4 flex flex-col justify-between shadow-sm">
            <div class="text-[10px] font-mono uppercase tracking-widest text-slate-400 mb-1">Database State</div>
            <div class="text-base sm:text-lg font-mono font-bold text-emerald-500"><%= systemStats.db.readyLabel %></div>
            <div class="text-[11px] font-mono text-slate-500 mt-1">Ping: <%= systemStats.db.pingMs === null ? 'N/A' : systemStats.db.pingMs + ' ms' %></div>
        </div>

        <div class="bg-white dark:bg-obsidian-900 border border-slate-200 dark:border-obsidian-700 p-4 flex flex-col justify-between shadow-sm">
            <div class="text-[10px] font-mono uppercase tracking-widest text-slate-400 mb-1">Thermal Temp</div>
            <div class="text-base sm:text-lg font-mono font-bold text-slate-900 dark:text-white"><%= systemStats.temperature %></div>
            <div class="text-[11px] font-mono text-slate-500 mt-1">Hardware Sensors</div>
        </div>
    </section>

    <!-- History & Quick Bot Telemetry -->
    <section class="grid grid-cols-1 xl:grid-cols-3 gap-4">
        <div class="bg-white dark:bg-obsidian-900 border border-slate-200 dark:border-obsidian-700 p-5 xl:col-span-2 shadow-sm">
            <div class="flex items-center justify-between mb-4 border-b border-slate-200 dark:border-obsidian-700/60 pb-3">
                <h2 class="text-xs font-mono uppercase font-bold tracking-wider text-slate-900 dark:text-white flex items-center gap-2">
                    <span class="material-icons text-sm text-primary">show_chart</span>
                    <span>System Load Average History (1 / 5 / 15 min)</span>
                </h2>
                <span class="text-[10px] font-mono text-slate-500">Last <%= systemStats.loadHistory.length %> samples</span>
            </div>
            <div class="space-y-2 max-h-60 overflow-y-auto text-xs font-mono">
                <% systemStats.loadHistory.forEach(function(entry) { %>
                    <div class="flex items-center justify-between bg-slate-50 dark:bg-obsidian-950 px-3 py-2 border border-slate-200 dark:border-obsidian-800">
                        <span class="text-slate-500"><%= new Date(entry.ts).toLocaleTimeString() %></span>
                        <span class="font-bold text-slate-700 dark:text-slate-300"><%= entry.load1 %> / <%= entry.load5 %> / <%= entry.load15 %></span>
                    </div>
                <% }); %>
            </div>
        </div>

        <div class="bg-white dark:bg-obsidian-900 border border-slate-200 dark:border-obsidian-700 p-5 shadow-sm">
            <div class="flex items-center justify-between mb-4 border-b border-slate-200 dark:border-obsidian-700/60 pb-3">
                <h2 class="text-xs font-mono uppercase font-bold tracking-wider text-slate-900 dark:text-white flex items-center gap-2">
                    <span class="material-icons text-sm text-primary">view_list</span>
                    <span>Bot Status Overview</span>
                </h2>
                <span class="text-[10px] font-mono text-slate-500"><%= systemStats.botsDetail.length %> BOTS</span>
            </div>
            <div class="space-y-2 max-h-60 overflow-y-auto text-xs">
                <% systemStats.botsDetail.forEach(function(bot) { %>
                    <div class="flex items-center justify-between bg-slate-50 dark:bg-obsidian-950 px-3 py-2 border border-slate-200 dark:border-obsidian-800">
                        <div>
                            <div class="font-mono font-bold text-slate-900 dark:text-slate-200"><%= bot.name %> <span class="text-slate-500">#<%= bot.id %></span></div>
                            <div class="text-[10px] font-mono text-slate-500">Uptime: <%= bot.uptime %></div>
                        </div>
                        <div class="text-right font-mono">
                            <span class="px-1.5 py-0.5 text-[10px] font-bold uppercase border <%= bot.online ? 'bg-emerald-500/10 text-emerald-400 border-emerald-500/30' : 'bg-slate-200 dark:bg-obsidian-800 text-slate-500 border-slate-300 dark:border-obsidian-700' %>">
                                <%= bot.online ? 'Online' : 'Offline' %>
                            </span>
                            <div class="text-[10px] text-slate-500 mt-1"><%= bot.afk ? 'AFK' : 'Active' %></div>
                        </div>
                    </div>
                <% }); %>
            </div>
        </div>
    </section>

    <!-- Navigation Tabs (Sharp Square Style & Fixed Dark Mode Invisibility) -->
    <div class="flex flex-wrap gap-2 border-b border-slate-200 dark:border-obsidian-700/80 pb-3">
        <button class="admin-tab px-4 py-2 font-mono text-xs font-bold uppercase tracking-wider transition-colors border bg-primary text-white border-primary shadow-sm active" data-tab="users">
            Users
        </button>
        <button class="admin-tab px-4 py-2 font-mono text-xs font-bold uppercase tracking-wider transition-colors border bg-white dark:bg-obsidian-900 text-slate-600 dark:text-slate-400 border-slate-300 dark:border-obsidian-700 hover:text-slate-900 dark:hover:text-slate-200" data-tab="bots">
            Bots & Assignments
        </button>
        <button class="admin-tab px-4 py-2 font-mono text-xs font-bold uppercase tracking-wider transition-colors border bg-white dark:bg-obsidian-900 text-slate-600 dark:text-slate-400 border-slate-300 dark:border-obsidian-700 hover:text-slate-900 dark:hover:text-slate-200" data-tab="servers">
            Server Profiles
        </button>
        <button class="admin-tab px-4 py-2 font-mono text-xs font-bold uppercase tracking-wider transition-colors border bg-white dark:bg-obsidian-900 text-slate-600 dark:text-slate-400 border-slate-300 dark:border-obsidian-700 hover:text-slate-900 dark:hover:text-slate-200" data-tab="logs">
            Audit Logs
        </button>
    </div>

    <!-- Tab 1: Users -->
    <section id="tab-users" class="admin-tab-panel">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
            <div class="bg-white dark:bg-obsidian-900 border border-slate-200 dark:border-obsidian-700 p-6 shadow-sm">
                <div class="flex justify-between items-center mb-5 border-b border-slate-200 dark:border-obsidian-700/60 pb-3">
                    <h2 class="text-sm font-mono uppercase font-bold tracking-wider text-slate-900 dark:text-white">Registered Users</h2>
                    <span class="text-xs font-mono bg-slate-100 dark:bg-obsidian-800 px-2 py-0.5 border border-slate-200 dark:border-obsidian-700 text-slate-500"><%= users.length %> Total</span>
                </div>
                <div class="space-y-3 max-h-96 overflow-y-auto pr-1">
                    <% users.forEach(function(u) { %>
                    <div class="p-3.5 bg-slate-50 dark:bg-obsidian-950 border border-slate-200 dark:border-obsidian-800 flex justify-between items-center">
                        <div>
                            <div class="flex items-center gap-2">
                                <h3 class="font-mono font-bold text-sm text-slate-900 dark:text-white"><%= u.username %></h3>
                                <span class="px-1.5 py-0.2 text-[10px] font-mono font-bold uppercase border <%= u.role === 'admin' ? 'bg-redstone-500/10 text-redstone-400 border-redstone-500/30' : 'bg-primary/10 text-primary border-primary/20' %>">
                                    <%= u.role || 'user' %>
                                </span>
                            </div>
                            <div class="text-[11px] font-mono text-slate-500 mt-1">
                                Joined: <%= new Date(u.createdAt).toLocaleDateString() %>
                            </div>
                        </div>
                        <div class="flex gap-2">
                            <% if (u.role === 'user') { %>
                            <button onclick="promoteUser('<%= u.username %>')" class="px-3 py-1.5 bg-emerald-600 hover:bg-emerald-500 text-white font-mono text-xs uppercase font-bold transition-colors border border-emerald-500/40">
                                Promote
                            </button>
                            <% } else if (u.role === 'admin') { %>
                            <button onclick="demoteUser('<%= u.username %>')" class="px-3 py-1.5 bg-amber-600 hover:bg-amber-500 text-white font-mono text-xs uppercase font-bold transition-colors border border-amber-500/40">
                                Demote
                            </button>
                            <% } %>
                        </div>
                    </div>
                    <% }); %>
                </div>
            </div>

            <div class="bg-white dark:bg-obsidian-900 border border-slate-200 dark:border-obsidian-700 p-6 shadow-sm">
                <h2 class="text-sm font-mono uppercase font-bold tracking-wider mb-5 border-b border-slate-200 dark:border-obsidian-700/60 pb-3 text-slate-900 dark:text-white">Create New User</h2>
                <form onsubmit="createUser(event)" class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-mono uppercase text-slate-500 mb-1.5 font-semibold">Username</label>
                        <input type="text" name="username" placeholder="Username" required class="w-full bg-slate-50 dark:bg-obsidian-950 border border-slate-300 dark:border-obsidian-700 px-3 py-2.5 text-xs text-slate-900 dark:text-white outline-none focus:border-primary">
                    </div>
                    <div>
                        <label class="block text-xs font-mono uppercase text-slate-500 mb-1.5 font-semibold">Password</label>
                        <input type="password" name="password" placeholder="Password" required class="w-full bg-slate-50 dark:bg-obsidian-950 border border-slate-300 dark:border-obsidian-700 px-3 py-2.5 text-xs text-slate-900 dark:text-white outline-none focus:border-primary">
                    </div>
                    <div class="md:col-span-2">
                        <label class="block text-xs font-mono uppercase text-slate-500 mb-1.5 font-semibold">Role</label>
                        <select name="role" class="w-full bg-slate-50 dark:bg-obsidian-950 border border-slate-300 dark:border-obsidian-700 px-3 py-2.5 text-xs font-mono text-slate-900 dark:text-white outline-none focus:border-primary">
                            <option value="user">User (Limited Access)</option>
                            <option value="admin">Administrator (Full Access)</option>
                        </select>
                    </div>
                    <div class="md:col-span-2 flex justify-end mt-2">
                        <button type="submit" class="px-5 py-2.5 bg-primary hover:bg-primary-hover text-white font-mono text-xs uppercase font-bold transition-all border border-primary-hover active:translate-y-0.5">
                            Create User Account
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </section>

    <% 
        const serverCounts = {};
        bots.forEach(function(bot) {
            if (bot.serverProfile) {
                const key = String(bot.serverProfile);
                serverCounts[key] = (serverCounts[key] || 0) + 1;
            }
        });
    %>

    <!-- Tab 2: Bots -->
    <section id="tab-bots" class="admin-tab-panel hidden">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
            <div class="bg-white dark:bg-obsidian-900 border border-slate-200 dark:border-obsidian-700 p-6 shadow-sm">
                <div class="flex justify-between items-center mb-5 border-b border-slate-200 dark:border-obsidian-700/60 pb-3">
                    <h2 class="text-sm font-mono uppercase font-bold tracking-wider text-slate-900 dark:text-white">Bot Assignments</h2>
                    <span class="text-xs font-mono bg-slate-100 dark:bg-obsidian-800 px-2 py-0.5 border border-slate-200 dark:border-obsidian-700 text-slate-500"><%= bots.length %> Instances</span>
                </div>
                <div class="space-y-4 max-h-[500px] overflow-y-auto pr-1">
                    <% bots.forEach(function(bot) { %>
                    <div class="p-4 bg-slate-50 dark:bg-obsidian-950 border border-slate-200 dark:border-obsidian-800">
                        <div class="flex items-center justify-between mb-2">
                            <h3 class="font-mono font-bold text-sm text-slate-900 dark:text-white"><%= bot.name %></h3>
                            <span class="text-xs font-mono bg-slate-200 dark:bg-obsidian-800 px-2 py-0.5 text-slate-600 dark:text-slate-400">#<%= bot.id %></span>
                        </div>
                        <div class="text-xs font-mono text-slate-500 dark:text-slate-400 mb-3">
                            Server: <%= typeof bot.server !== 'undefined' ? bot.server.ip + ':' + bot.server.port : 'No server' %>
                        </div>
                        <div class="space-y-2.5">
                            <div>
                                <label class="text-[10px] font-mono uppercase text-slate-400 font-semibold block mb-1">Assign User Owner:</label>
                                <select onchange="assignBotToUser(<%= bot.id %>, this.value)" class="w-full text-xs font-mono bg-white dark:bg-obsidian-900 border border-slate-300 dark:border-obsidian-700 px-2.5 py-1.5 text-slate-900 dark:text-white outline-none focus:border-primary">
                                    <option value="" <%= !bot.assignedTo ? 'selected' : '' %>>-- Unassigned --</option>
                                    <% users.forEach(function(u) { %>
                                        <option value="<%= u.username %>" <%= bot.assignedTo === u.username ? 'selected' : '' %>><%= u.username %></option>
                                    <% }); %>
                                </select>
                            </div>
                            <div>
                                <label class="text-[10px] font-mono uppercase text-slate-400 font-semibold block mb-1">Link Server Profile:</label>
                                <div class="flex flex-wrap gap-2 items-center">
                                    <select class="server-select flex-1 text-xs font-mono bg-white dark:bg-obsidian-900 border border-slate-300 dark:border-obsidian-700 px-2.5 py-1.5 text-slate-900 dark:text-white outline-none focus:border-primary" data-bot-id="<%= bot.id %>" data-current-server="<%= bot.serverProfile ? String(bot.serverProfile) : '' %>">
                                        <option value="">-- No Profile --</option>
                                        <% servers.forEach(function(server) { %>
                                            <% 
                                                const serverId = String(server._id);
                                                const assignedCount = serverCounts[serverId] || 0;
                                                const maxBots = server.maxBots || 0;
                                                const isCurrent = bot.serverProfile && String(bot.serverProfile) === serverId;
                                                const isFull = maxBots > 0 && assignedCount >= maxBots && !isCurrent;
                                            %>
                                            <option value="<%= server._id %>" data-max-bots="<%= maxBots %>" data-assigned-count="<%= assignedCount %>" <%= isFull ? 'disabled' : '' %> <%= isCurrent ? 'selected' : '' %>>
                                                <%= server.name %><%= isFull ? ' (Full)' : '' %>
                                            </option>
                                        <% }); %>
                                    </select>
                                    <button type="button" onclick="assignBotServer(<%= bot.id %>)" class="px-3 py-1.5 bg-primary hover:bg-primary-hover text-white font-mono text-xs uppercase font-bold transition-colors border border-primary-hover">
                                        Save
                                    </button>
                                </div>
                                <span class="server-warning hidden text-xs font-mono text-redstone-500 mt-1 block" data-bot-id="<%= bot.id %>">Max bots reached for this server.</span>
                                <label class="flex items-center gap-2 text-xs font-mono text-slate-500 dark:text-slate-400 mt-1.5 cursor-pointer">
                                    <input type="checkbox" class="apply-profile accent-primary" data-bot-id="<%= bot.id %>">
                                    <span>Apply profile IP/Port to this bot</span>
                                </label>
                            </div>
                        </div>
                    </div>
                    <% }); %>
                </div>
            </div>

            <div class="bg-white dark:bg-obsidian-900 border border-slate-200 dark:border-obsidian-700 p-6 shadow-sm">
                <h2 class="text-sm font-mono uppercase font-bold tracking-wider mb-5 border-b border-slate-200 dark:border-obsidian-700/60 pb-3 text-slate-900 dark:text-white">Create New Bot Instance</h2>
                <form onsubmit="createNewBot(event)" class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-mono uppercase text-slate-500 mb-1.5 font-semibold">Name</label>
                        <input type="text" name="name" placeholder="Instance name" required class="w-full bg-slate-50 dark:bg-obsidian-950 border border-slate-300 dark:border-obsidian-700 px-3 py-2.5 text-xs text-slate-900 dark:text-white outline-none focus:border-primary">
                    </div>
                    <div>
                        <label class="block text-xs font-mono uppercase text-slate-500 mb-1.5 font-semibold">Account Email</label>
                        <input type="email" name="email" placeholder="Microsoft Email" required class="w-full bg-slate-50 dark:bg-obsidian-950 border border-slate-300 dark:border-obsidian-700 px-3 py-2.5 text-xs text-slate-900 dark:text-white outline-none focus:border-primary">
                    </div>
                    <div>
                        <label class="block text-xs font-mono uppercase text-slate-500 mb-1.5 font-semibold">Server IP</label>
                        <input type="text" name="ip" placeholder="play.server.com" required class="w-full bg-slate-50 dark:bg-obsidian-950 border border-slate-300 dark:border-obsidian-700 px-3 py-2.5 text-xs font-mono text-slate-900 dark:text-white outline-none focus:border-primary">
                    </div>
                    <div>
                        <label class="block text-xs font-mono uppercase text-slate-500 mb-1.5 font-semibold">Port</label>
                        <input type="number" name="port" value="25565" required class="w-full bg-slate-50 dark:bg-obsidian-950 border border-slate-300 dark:border-obsidian-700 px-3 py-2.5 text-xs font-mono text-slate-900 dark:text-white outline-none focus:border-primary">
                    </div>
                    <div class="md:col-span-2">
                        <label class="block text-xs font-mono uppercase text-slate-500 mb-1.5 font-semibold">Version</label>
                        <select name="version" class="w-full bg-slate-50 dark:bg-obsidian-950 border border-slate-300 dark:border-obsidian-700 px-3 py-2.5 text-xs font-mono text-slate-900 dark:text-white outline-none focus:border-primary">
