</main>

<script>
async function promoteUser(username) {
    if (confirm(`Promote user '${username}' to administrator?`)) {
        try {
            const res = await fetch('/api/admin/promote', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ username })
            });
            
            if (res.ok) {
                if (typeof showToast === 'function') showToast(`User '${username}' promoted to admin.`, 'success');
                setTimeout(() => window.location.reload(), 500);
            } else {
                if (typeof showToast === 'function') showToast('Failed to promote user.', 'error');
            }
        } catch (err) {
            console.error(err);
            if (typeof showToast === 'function') showToast('Error promoting user.', 'error');
        }
    }
}

async function demoteUser(username) {
    if (confirm(`Demote user '${username}' to regular user?`)) {
        try {
            const res = await fetch('/api/admin/demote', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ username })
            });
            
            if (res.ok) {
                if (typeof showToast === 'function') showToast(`User '${username}' demoted.`, 'info');
                setTimeout(() => window.location.reload(), 500);
            } else {
                if (typeof showToast === 'function') showToast('Failed to demote user.', 'error');
            }
        } catch (err) {
            console.error(err);
            if (typeof showToast === 'function') showToast('Error demoting user.', 'error');
        }
    }
}

async function createNewBot(e) {
    e.preventDefault();
    const formData = new FormData(e.target);
    const data = Object.fromEntries(formData.entries());

    try {
        const res = await fetch('/api/bots/create', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
        });

        if (res.ok) {
            if (typeof showToast === 'function') showToast('Bot instance created successfully.', 'success');
            setTimeout(() => window.location.reload(), 500);
        } else {
            const errorData = await res.json();
            if (typeof showToast === 'function') showToast(errorData.error || 'Failed to create bot', 'error');
        }
    } catch (err) {
        console.error(err);
        if (typeof showToast === 'function') showToast('Network error creating bot', 'error');
    }
}

async function createUser(e) {
    e.preventDefault();
    const formData = new FormData(e.target);
    const data = Object.fromEntries(formData.entries());

    try {
        const res = await fetch('/api/admin/create-user', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
        });

        const result = await res.json();
        if (res.ok && result.success) {
            if (typeof showToast === 'function') showToast(`User '${data.username}' created.`, 'success');
            setTimeout(() => window.location.reload(), 500);
        } else {
            if (typeof showToast === 'function') showToast(result.error || 'Failed to create user', 'error');
        }
    } catch (err) {
        console.error(err);
        if (typeof showToast === 'function') showToast('Error creating user account', 'error');
    }
}

async function assignBotToUser(botId, username) {
    try {
        const res = await fetch('/api/admin/assign-bot', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ botId, username })
        });
        
        if (res.ok) {
            if (typeof showToast === 'function') {
                showToast(`Bot #${botId} assigned to ${username || 'unassigned'}.`, 'success');
            }
        } else {
            const errorData = await res.json();
            if (typeof showToast === 'function') showToast(errorData.error || 'Failed to assign bot', 'error');
            setTimeout(() => window.location.reload(), 800);
        }
    } catch (err) {
        console.error(err);
        if (typeof showToast === 'function') showToast('Error assigning bot', 'error');
    }
}

async function updateServerProfile(e) {
    e.preventDefault();
    const formData = new FormData(e.target);
    const data = Object.fromEntries(formData.entries());
    data.whitelist = formData.get('whitelist') === 'on';

    try {
        const res = await fetch('/api/servers/update', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
        });
        const result = await res.json();
        if (res.ok && result.success) {
            if (typeof showToast === 'function') showToast('Server profile updated successfully.', 'success');
            setTimeout(() => window.location.reload(), 500);
        } else {
            if (typeof showToast === 'function') showToast(result.error || 'Failed to update server', 'error');
        }
    } catch (err) {
        console.error(err);
        if (typeof showToast === 'function') showToast('Error updating server profile', 'error');
    }
}

async function createServerProfile(e) {
    e.preventDefault();
    const formData = new FormData(e.target);
    const data = Object.fromEntries(formData.entries());
    data.whitelist = formData.get('whitelist') === 'on';

    try {
        const res = await fetch('/api/servers/create', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
        });

        const result = await res.json();
        if (res.ok && result.success) {
            if (typeof showToast === 'function') showToast(`Server profile '${data.name}' created.`, 'success');
            setTimeout(() => window.location.reload(), 500);
        } else {
            if (typeof showToast === 'function') showToast(result.error || 'Failed to create server', 'error');
        }
    } catch (err) {
        console.error(err);
        if (typeof showToast === 'function') showToast('Error creating server profile', 'error');
    }
}

async function deleteServerProfile(serverId, name) {
    if (!confirm(`Delete server profile '${name}'? This will unassign bots connected to this profile.`)) {
        return;
    }
    try {
        const res = await fetch('/api/servers/delete', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ serverId })
        });
        const result = await res.json();
        if (res.ok && result.success) {
            if (typeof showToast === 'function') showToast('Server profile deleted.', 'info');
            setTimeout(() => window.location.reload(), 500);
        } else {
            if (typeof showToast === 'function') showToast(result.error || 'Failed to delete server', 'error');
        }
    } catch (err) {
        console.error(err);
        if (typeof showToast === 'function') showToast('Error deleting server profile', 'error');
    }
}

async function assignBotServer(botId) {
    const serverSelect = document.querySelector(`.server-select[data-bot-id="${botId}"]`);
    const applyCheckbox = document.querySelector(`.apply-profile[data-bot-id="${botId}"]`);
    const warning = document.querySelector(`.server-warning[data-bot-id="${botId}"]`);
    const serverId = serverSelect ? serverSelect.value : '';
    const applyProfile = applyCheckbox ? applyCheckbox.checked : false;

    if (serverSelect && serverId) {
        const selectedOption = serverSelect.options[serverSelect.selectedIndex];
        const maxBots = parseInt(selectedOption.getAttribute('data-max-bots') || '0', 10);
        const assignedCount = parseInt(selectedOption.getAttribute('data-assigned-count') || '0', 10);
        const currentServer = serverSelect.getAttribute('data-current-server') || '';
        const isCurrent = currentServer && currentServer === serverId;
        const isFull = maxBots > 0 && assignedCount >= maxBots && !isCurrent;
        if (isFull) {
            if (warning) warning.classList.remove('hidden');
            if (typeof showToast === 'function') showToast('This server has reached its max bots limit.', 'warning');
            return;
        }
    }

    try {
        const res = await fetch('/api/servers/assign-bot', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ botId, serverId, applyProfile })
        });
        const result = await res.json();
        if (res.ok && result.success) {
            if (typeof showToast === 'function') showToast(`Bot #${botId} server profile assigned!`, 'success');
        } else {
            if (typeof showToast === 'function') showToast(result.error || 'Failed to assign server', 'error');
            setTimeout(() => window.location.reload(), 800);
        }
    } catch (err) {
        console.error(err);
        if (typeof showToast === 'function') showToast('Error assigning server profile', 'error');
    }
}

// Tab Switching with fixed active state contrast
const tabButtons = document.querySelectorAll('.admin-tab');
const tabPanels = document.querySelectorAll('.admin-tab-panel');
const serversData = <%- JSON.stringify(servers || []) %>;
const editServerSelect = document.getElementById('editServerSelect');
const editServerName = document.getElementById('editServerName');
const editServerRegion = document.getElementById('editServerRegion');
const editServerIp = document.getElementById('editServerIp');
const editServerPort = document.getElementById('editServerPort');
const editServerVersion = document.getElementById('editServerVersion');
const editServerMaxBots = document.getElementById('editServerMaxBots');
const editServerNotes = document.getElementById('editServerNotes');
const editServerWhitelist = document.getElementById('editServerWhitelist');

if (editServerSelect) {
    editServerSelect.addEventListener('change', () => {
        const serverId = editServerSelect.value;
        const server = serversData.find(item => String(item._id) === String(serverId));
        if (!server) {
            editServerName.value = '';
            editServerRegion.value = '';
            editServerIp.value = '';
            editServerPort.value = '25565';
            editServerVersion.value = '1.20.4';
            editServerMaxBots.value = '';
            editServerNotes.value = '';
            editServerWhitelist.checked = false;
            return;
        }
        editServerName.value = server.name || '';
        editServerRegion.value = server.region || '';
        editServerIp.value = server.ip || '';
        editServerPort.value = server.port || 25565;
        editServerVersion.value = server.version || '1.20.4';
        editServerMaxBots.value = server.maxBots || 0;
        editServerNotes.value = server.notes || '';
        editServerWhitelist.checked = !!server.whitelist;
    });
}

tabButtons.forEach(button => {
    button.addEventListener('click', () => {
        const tab = button.getAttribute('data-tab');
        tabButtons.forEach(btn => {
            if (btn === button) {
                btn.classList.add('bg-primary', 'text-white', 'border-primary');
                btn.classList.remove('bg-white', 'dark:bg-obsidian-900', 'text-slate-600', 'dark:text-slate-400', 'border-slate-300', 'dark:border-obsidian-700');
            } else {
                btn.classList.remove('bg-primary', 'text-white', 'border-primary');
                btn.classList.add('bg-white', 'dark:bg-obsidian-900', 'text-slate-600', 'dark:text-slate-400', 'border-slate-300', 'dark:border-obsidian-700');
            }
        });
        tabPanels.forEach(panel => {
            panel.classList.toggle('hidden', panel.id !== `tab-${tab}`);
        });
    });
});

document.querySelectorAll('.server-select').forEach(select => {
    select.addEventListener('change', () => {
        const botId = select.getAttribute('data-bot-id');
        const warning = document.querySelector(`.server-warning[data-bot-id="${botId}"]`);
        if (!warning) return;
        const selectedOption = select.options[select.selectedIndex];
        const maxBots = parseInt(selectedOption.getAttribute('data-max-bots') || '0', 10);
        const assignedCount = parseInt(selectedOption.getAttribute('data-assigned-count') || '0', 10);
        const currentServer = select.getAttribute('data-current-server') || '';
        const serverId = select.value;
        const isCurrent = currentServer && currentServer === serverId;
        const isFull = maxBots > 0 && assignedCount >= maxBots && !isCurrent;
        warning.classList.toggle('hidden', !isFull);
    });
});
</script>

